# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

# URL del proyecto (ej. https://xxxxxxxx.supabase.co) — pública, segura de exponer
PUBLIC_SUPABASE_URL=

# Clave "anon public" — pública, segura de exponer (protegida por RLS)
PUBLIC_SUPABASE_ANON_KEY=

# URL del sitio en producción (para canonical, sitemap, robots)
SITE_URL=https://web-lacasadedios.vercel.app

# Clave "service_role" — SECRETA. Nunca la pongas en una variable PUBLIC_ ni la
# expongas al navegador: salta todas las políticas RLS.
#
# La necesita /api/suscribir. La tabla de suscriptores dejó de aceptar
# escrituras con la clave anónima (antes cualquiera podía llenarla o suscribir
# a terceros), así que el alta solo entra por el servidor. Sin esta variable el
# formulario del boletín responde "no está configurado" y no da de alta a nadie.
SUPABASE_SERVICE_ROLE_KEY=

# ── Correo saliente (SMTP de la casilla propia) ──────────────────────────────
# Confirmación del boletín, formulario de contacto y avisos al publicar.
# Sin estas tres variables todo lo demás funciona igual, pero no sale un correo.
#
# Se envía por el servidor de correo que la iglesia ya tiene, y NO por un
# servicio tipo Resend, porque esos exigen verificar un dominio con registros
# DNS y el sitio vive en un dominio de Vercel al que no se le pueden añadir.
# Ventaja añadida: ese servidor ya está autorizado en el SPF del dominio, así
# que no hay que tocar el DNS ni arriesgar el correo que ya funciona.

# Servidor y puerto. 465 = TLS directo (recomendado); 587 = STARTTLS.
SMTP_HOST=mail.lacasadedios.cl
SMTP_PORT=465

# Casilla completa como usuario, y su contraseña. SECRETA: nunca en una
# variable PUBLIC_. Quien la tenga puede enviar correo en nombre del dominio.
SMTP_USER=
SMTP_PASS=

# Remitente de los correos. Si se deja vacío se usa SMTP_USER, que es lo más
# seguro: muchos servidores rechazan un From que no sea la cuenta autenticada.
# Formato: "correo@dominio.cl" o "Nombre <correo@dominio.cl>", SIN comillas.
CONTACT_FROM=
