# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API

# URL del proyecto (ej. https://xxxxxxxx.supabase.co) — pública, segura de exponer
PUBLIC_SUPABASE_URL=

# Clave "anon public" — pública, segura de exponer (protegida por RLS)
PUBLIC_SUPABASE_ANON_KEY=

# URL del sitio en producción (para canonical, sitemap, robots)
SITE_URL=https://web-lacasadedios.vercel.app

# NOTA: NO se necesita el "service_role key" en el sitio. Toda la escritura pasa
# por la sesión autenticada del mantenedor + las políticas RLS.

# ── Notificaciones por correo (Resend — https://resend.com) ──────────────────
# Para avisar a los suscriptores al publicar eventos/noticias/videos.
# Sin esta clave, todo funciona igual pero no se envían correos.
RESEND_API_KEY=

# Remitente de los correos. Usa un dominio verificado en Resend en producción.
# Por defecto: "La Casa de Dios <onboarding@resend.dev>"
CONTACT_FROM=
