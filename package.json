{
  "name": "la-casa-de-dios",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "node scripts/fotos.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/fotos.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{ts,astro,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "test": "node scripts/probar.mjs",
    "respaldo": "node scripts/respaldo.mjs",
    "test:watch": "node scripts/probar.mjs --watch",
    "textos": "npm run build && node scripts/textos.mjs",
    "verificar": "npm run format:check && npm run check && npm test && npm run build",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/archivo-narrow": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@formkit/auto-animate": "^0.10.3",
    "@iconify-json/lucide": "^1.2.160",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "astro-icon": "^1.1.5",
    "daisyui": "^5.8.3",
    "marked": "^18.3.0",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261128.1",
    "@types/sortablejs": "^1.15.9",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0",
    "smol-toml": "^1.8.0"
  }
}
