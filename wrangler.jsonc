{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacasadedios",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-10",

  // `nodejs_compat` da acceso a los módulos de Node que el sitio ya usa:
  // `node:crypto` para los hashes de la CSP (src/lib/csp.ts) y lo que arrastre
  // nodemailer. Sin esto, esos import fallan al arrancar el Worker.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Por defecto, Workers redirige /horarios → /horarios/ con un 307. El sitio
    // genera las URL canónicas SIN barra final (ver Layout.astro), así que esa
    // redirección dejaba la canónica y la dirección servida en desacuerdo, y
    // cobraba un viaje de ida y vuelta en cada visita a una página estática.
    // En Vercel no pasaba. `drop-trailing-slash` restaura ese comportamiento.
    "html_handling": "drop-trailing-slash",
  },

  // Base de datos. El id se rellena al crearla con `wrangler d1 create`.
  // En local, wrangler usa una SQLite de miniflare y no mira este id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lacasadedios",
      "database_id": "665b6cdc-0a66-4229-935d-af66fd0cc322",
    },
  ],

  // Sesiones de Astro. El primer despliegue creó este espacio de nombres solo,
  // porque el adaptador declara el binding `SESSION`, y lo dejó SIN anotar en
  // ningún sitio: `wrangler dev --remote` fallaba con «SESSION bindings must
  // have an id». Escrito acá, la configuración vuelve a valerse por sí misma.
  "kv_namespaces": [{ "binding": "SESSION", "id": "3fa36b4cccfe4f969ee70aa461a85028" }],

  // Lo mismo, otra vez, para `wrangler dev --remote`.
  //
  // No es duplicar por gusto. El adaptador arma la sección `previews` aparte y
  // le mete un `SESSION` SIN id salvo que ya encuentre uno declarado ahí (ver
  // cloudflareConfigCustomizer en @astrojs/cloudflare/dist/wrangler.js). Sin
  // estas dos líneas, `--remote` muere con «SESSION bindings must have an id» y
  // no hay manera de probar contra las bases de verdad.
  //
  // Va al MISMO espacio de nombres a propósito: son sesiones de un sitio de
  // pruebas, no hay nada que aislar.
  "previews": {
    "kv_namespaces": [{ "binding": "SESSION", "id": "3fa36b4cccfe4f969ee70aa461a85028" }],
  },

  // Archivos: imágenes, documentos y los estudios en audio, todo en un bucket
  // con prefijos. Uno solo y no varios porque el tramo gratuito es por cuenta,
  // y así hay un único dominio público que servir.
  "r2_buckets": [{ "binding": "MEDIOS", "bucket_name": "lacasadedios-medios" }],

  // Dónde responde el Worker.
  //
  // Por ahora SOLO pruebas: `lacasadedios.cl` y `www` los tiene el Worker de
  // mantenimiento (mantenimiento/wrangler.jsonc), y una ruta no se puede
  // reclamar desde dos sitios. Dos Workers separados y no uno con condicionales
  // porque así el lanzamiento es un cambio de rutas, no un despliegue a ciegas:
  // hasta ese día, romper esto no rompe lo que ve la gente.
  //
  // `custom_domain` hace que Cloudflare cree y mantenga el registro DNS. Por eso
  // `pruebas` no resolvía antes del primer despliegue: no había nada que crearlo.
  "routes": [{ "pattern": "pruebas.lacasadedios.cl", "custom_domain": true }],

  // Identidad de Cloudflare Access. NO son secretos: el dominio del equipo es
  // público y el AUD viaja dentro de cada token. Van acá y no en variables de
  // entorno para que no se puedan olvidar: sin ellos, src/lib/access.ts falla
  // cerrado y el panel queda inaccesible para todos.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lacasadedios.cloudflareaccess.com",
    "ACCESS_AUD": "c6d6fb65388b5b61c2e2b0e2f7f5d5f7410d1898bfe3a71158f98142f039b890",

    // Dirección del sitio, para lo que se arma al servir: sobre todo el enlace
    // de baja del boletín, que tiene que llevar a un sitio que exista.
    //
    // OJO: esta copia NO alcanza. Astro incrusta las canónicas y el sitemap al
    // COMPILAR, y para eso la variable tiene que estar puesta en el shell antes
    // de `npm run build` (ver astro.config.mjs). Están las dos porque son dos
    // momentos distintos, no por duplicar.
    "SITE_URL": "https://pruebas.lacasadedios.cl",

    // Dominio público del bucket. En la base se guardan CLAVES, no direcciones:
    // si esto cambia, se cambia acá y no en cada fila. Ver src/lib/medios.ts.
    "MEDIOS_DOMINIO": "medios.lacasadedios.cl",
  },

  "observability": {
    "enabled": true,
  },
}
