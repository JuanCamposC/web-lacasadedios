// ⚠️ TOCAR ESTE ARCHIVO NO BASTA: HAY QUE RECOMPILAR.
//
// Wrangler NO lee este archivo al desplegar. El adaptador de Astro escribe una
// copia en `dist/server/wrangler.json` AL COMPILAR y wrangler sigue esa copia:
//
//     Using redirected Wrangler configuration.
//      - Configuration being used: "dist/server/wrangler.json"
//      - Original user's configuration: "wrangler.jsonc"
//
// Esas tres líneas salen en cada `wrangler deploy` y es fácil no leerlas. El
// síntoma es que agregas una variable, despliegas sin error, y la variable
// sencillamente no está: no hay aviso ninguno. Ya pasó con BOLETIN_FROM.
//
// Así que el orden es siempre:
//     npm run build   (con SITE_URL y MEDIOS_DOMINIO en el shell)
//     npx wrangler deploy
//
// Los secretos son la excepción: `wrangler secret put` va directo al Worker y
// no pasa por acá ni por la compilación.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacasadedios",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-10",

  // `nodejs_compat` da acceso a los módulos de Node que el sitio usa —hoy
  // `node:crypto`, para los hashes de la CSP (src/lib/csp.ts)—, y además puebla
  // `process.env` con las `vars` y los secretos de acá abajo. Eso último es lo
  // que hace que `process.env.RESEND_API_KEY` funcione dentro del Worker; lo
  // activa la bandera `nodejs_compat_populate_process_env`, encendida sola para
  // fechas de compatibilidad desde 2025-04-01.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    // ./dist/client y no ./dist: en ./dist vive también dist/server, con la
    // configuración del Worker dentro (identificador de Access, ids de la base y
    // del bucket). El adaptador lo corrige al compilar, pero un despliegue hecho
    // sin compilar antes publicaría esa carpeta como archivos descargables.
    "directory": "./dist/client",
    "binding": "ASSETS",

    // Por defecto, Workers redirige /horarios → /horarios/ con un 307. El sitio
    // genera las URL canónicas SIN barra final (ver Layout.astro), así que esa
    // redirección dejaba la canónica y la dirección servida en desacuerdo, y
    // cobraba un viaje de ida y vuelta en cada visita a una página estática.
    // En Vercel no pasaba. `drop-trailing-slash` restaura ese comportamiento.
    "html_handling": "drop-trailing-slash",
  },

  // Base de datos. El id se rellena al crearla con `wrangler d1 create`.
  // En local, wrangler usa una SQLite de miniflare y no mira este id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lacasadedios",
      "database_id": "665b6cdc-0a66-4229-935d-af66fd0cc322",
    },
  ],

  // Sesiones de Astro. El primer despliegue creó este espacio de nombres solo,
  // porque el adaptador declara el binding `SESSION`, y lo dejó SIN anotar en
  // ningún sitio: `wrangler dev --remote` fallaba con «SESSION bindings must
  // have an id». Escrito acá, la configuración vuelve a valerse por sí misma.
  "kv_namespaces": [{ "binding": "SESSION", "id": "3fa36b4cccfe4f969ee70aa461a85028" }],

  // Lo mismo, otra vez, para `wrangler dev --remote`.
  //
  // No es duplicar por gusto. El adaptador arma la sección `previews` aparte y
  // le mete un `SESSION` SIN id salvo que ya encuentre uno declarado ahí (ver
  // cloudflareConfigCustomizer en @astrojs/cloudflare/dist/wrangler.js). Sin
  // estas dos líneas, `--remote` muere con «SESSION bindings must have an id» y
  // no hay manera de probar contra las bases de verdad.
  //
  // Va al MISMO espacio de nombres a propósito: son sesiones de un sitio de
  // pruebas, no hay nada que aislar.
  "previews": {
    "kv_namespaces": [{ "binding": "SESSION", "id": "3fa36b4cccfe4f969ee70aa461a85028" }],
  },

  // Archivos: imágenes, documentos y los estudios en audio, todo en un bucket
  // con prefijos. Uno solo y no varios porque el tramo gratuito es por cuenta,
  // y así hay un único dominio público que servir.
  "r2_buckets": [{ "binding": "MEDIOS", "bucket_name": "lacasadedios-medios" }],

  // Dónde responde el Worker.
  //
  // Desde el 21 de septiembre de 2026, los dominios reales. Antes los tenía el
  // Worker de mantenimiento (mantenimiento/wrangler.jsonc), que quedó sin rutas
  // y desplegado por si hubiera que volver a colgar la página de aviso.
  //
  // `www` se reclama para poder REDIRIGIRLO: el Worker lo manda al dominio sin
  // www (ver src/middleware.ts). Si no se reclamara, `www` quedaría sin dueño y
  // Cloudflare responde 530, que es lo que pasó el 25 de septiembre de 2026 al
  // quitarlo de aquí sin haber desplegado antes a su sucesor.
  //
  // PENDIENTE, y está a medio camino: esta redirección NO cubre las tres páginas
  // compiladas —la portada, /sobre-nosotros y la de error—, porque Cloudflare las
  // sirve desde el almacén de archivos sin invocar al Worker. La solución está
  // escrita y sin desplegar en redireccion-www/: un Worker de una sola función,
  // sin assets, al que nada se le puede saltar. Para activarla, EN ESTE ORDEN:
  //
  //   1. borrar la línea de `www` de las rutas de abajo
  //   2. npm run publicar          (libera el hostname; www deja de resolver)
  //   3. cd redireccion-www && npx wrangler deploy
  //
  // Entre el 2 y el 3, `www` no resuelve. Son segundos y lo único que se cae es
  // una redirección, pero el orden inverso no vale: Cloudflare rechaza el
  // despliegue si el dominio ya tiene dueño.
  //
  // `pruebas.lacasadedios.cl` YA NO EXISTE, y se quitó a propósito. Servía el
  // mismo Worker, la misma base y el mismo bucket que el sitio real, así que no
  // se podía probar nada de verdad en él: un borrado de prueba borraba la fila
  // buena. Cuando haga falta un sitio para desarrollo, tendrá que nacer con
  // base y bucket propios; mientras no los tenga, no sirve. El `noindex` que lo
  // cuidaba sigue en su sitio (src/lib/cabeceras.ts), esperando al que venga.
  //
  // `custom_domain` hace que Cloudflare cree y mantenga el registro DNS.
  "routes": [
    { "pattern": "lacasadedios.cl", "custom_domain": true },
    { "pattern": "www.lacasadedios.cl", "custom_domain": true },
  ],

  // Identidad de Cloudflare Access. NO son secretos: el dominio del equipo es
  // público y el AUD viaja dentro de cada token. Van acá y no en variables de
  // entorno para que no se puedan olvidar: sin ellos, src/lib/access.ts falla
  // cerrado y el panel queda inaccesible para todos.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lacasadedios.cloudflareaccess.com",
    "ACCESS_AUD": "c6d6fb65388b5b61c2e2b0e2f7f5d5f7410d1898bfe3a71158f98142f039b890",

    // Dirección del sitio, para lo que se arma al servir: sobre todo el enlace
    // de baja del boletín, que tiene que llevar a un sitio que exista.
    //
    // OJO: esta copia NO alcanza. Astro incrusta las canónicas y el sitemap al
    // COMPILAR, y para eso la variable tiene que estar puesta en el shell antes
    // de `npm run build` (ver astro.config.mjs). Están las dos porque son dos
    // momentos distintos, no por duplicar.
    "SITE_URL": "https://lacasadedios.cl",

    // Dominio público del bucket. En la base se guardan CLAVES, no direcciones:
    // si esto cambia, se cambia acá y no en cada fila. Ver src/lib/medios.ts.
    "MEDIOS_DOMINIO": "medios.lacasadedios.cl",

    // Feed del podcast de RSS.com con los audios del estudio bíblico.
    //
    // PENDIENTE: falta pegar la dirección. En RSS.com está en el panel del
    // programa y en su página pública, en el botón «RSS Feed», que la copia al
    // portapapeles. Hay que pegarla TAL CUAL: la forma exacta de la ruta no
    // está documentada y no conviene reconstruirla de memoria.
    //
    // Vacía, la página /estudio-biblico se ve entera —la introducción, los
    // horarios, cómo pedir el enlace de Zoom— y en lugar de la lista de audios
    // dice que todavía no hay grabaciones. Es a propósito: la mitad útil de esa
    // página no depende de rss.com.
    //
    // Si el servidor de archivos de RSS.com dejara de ser `media.rss.com`, esta
    // variable NO basta: el servidor también está escrito en la política de
    // seguridad, que se calcula al compilar (ver `RSS_MEDIA_HOST` en
    // astro.config.mjs).
    "RSS_ESTUDIOS_URL": "https://media.rss.com/instituto-biblico/feed.xml",

    // Dirección desde la que sale el aviso del formulario de contacto.
    //
    // Va SIN nombre a propósito: el nombre lo pone el código con el de quien
    // escribió (ver conNombre en src/lib/correo.ts), para que en la bandeja se
    // lea «Juan Pérez (formulario web)» y no el nombre de la iglesia.
    //
    // POR QUÉ NO ES `contacto@`: el aviso salía de contacto@ y llegaba a
    // contacto@ —la misma dirección en los dos extremos—, y Gmail lo rotulaba
    // «yo». Con una casilla distinta se distingue de un vistazo.
    //
    // No hay buzón que crear ni a donde responder: `reply_to` lleva el correo
    // del visitante, así que responder le contesta a él.
    "CONTACT_FROM": "formulario@lacasadedios.cl",

    // Casilla propia del boletín, separada de la del formulario de contacto.
    //
    // POR QUÉ SEPARARLAS: si alguien marca como no deseado un aviso del boletín,
    // el castigo de reputación cae sobre la dirección que lo mandó. Con una sola
    // casilla para todo, eso arrastraría también los correos del formulario de
    // contacto, que son los que no pueden fallar.
    //
    // NO hay que crear el buzón en ningún sitio: Resend firma por dominio, no
    // por cuenta, y las respuestas del boletín ya van dirigidas a `contacto@`
    // con `reply_to` (ver resolverRemitente y src/pages/api/notify.ts). Nadie
    // escribe nunca a esta dirección.
    "BOLETIN_FROM": "La Casa de Dios <boletin@lacasadedios.cl>",
  },

  "observability": {
    "enabled": true,
  },
}
