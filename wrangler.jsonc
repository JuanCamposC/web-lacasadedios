{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacasadedios",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-10",

  // `nodejs_compat` da acceso a los módulos de Node que el sitio ya usa:
  // `node:crypto` para los hashes de la CSP (src/lib/csp.ts) y lo que arrastre
  // nodemailer. Sin esto, esos import fallan al arrancar el Worker.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // Por defecto, Workers redirige /horarios → /horarios/ con un 307. El sitio
    // genera las URL canónicas SIN barra final (ver Layout.astro), así que esa
    // redirección dejaba la canónica y la dirección servida en desacuerdo, y
    // cobraba un viaje de ida y vuelta en cada visita a una página estática.
    // En Vercel no pasaba. `drop-trailing-slash` restaura ese comportamiento.
    "html_handling": "drop-trailing-slash",
  },

  // Base de datos. El id se rellena al crearla con `wrangler d1 create`.
  // En local, wrangler usa una SQLite de miniflare y no mira este id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lacasadedios",
      "database_id": "665b6cdc-0a66-4229-935d-af66fd0cc322",
    },
  ],

  // Archivos: imágenes, documentos y los estudios en audio, todo en un bucket
  // con prefijos. Uno solo y no varios porque el tramo gratuito es por cuenta,
  // y así hay un único dominio público que servir.
  "r2_buckets": [{ "binding": "MEDIOS", "bucket_name": "lacasadedios-medios" }],

  // Identidad de Cloudflare Access. NO son secretos: el dominio del equipo es
  // público y el AUD viaja dentro de cada token. Van acá y no en variables de
  // entorno para que no se puedan olvidar: sin ellos, src/lib/access.ts falla
  // cerrado y el panel queda inaccesible para todos.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "lacasadedios.cloudflareaccess.com",
    "ACCESS_AUD": "c6d6fb65388b5b61c2e2b0e2f7f5d5f7410d1898bfe3a71158f98142f039b890",
  },

  "observability": {
    "enabled": true,
  },
}
