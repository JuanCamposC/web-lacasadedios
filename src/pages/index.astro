---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TemploCard from '../components/TemploCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { templos } from '../data/templos';
import { SITE, SOCIAL } from '../data/site';
import { IMG } from '../assets/images';

const youtube = SOCIAL.find((s) => s.key === 'youtube')!;
const instagram = SOCIAL.find((s) => s.key === 'instagram')!;
---

<Layout>
  <!-- ══ Portada ═════════════════════════════════════════════════════════
       Del diseño recibido en Figma (archivo «Header», nodos 1:2 y 15:23).
       Cuatro adaptaciones que conviene conocer antes de tocarlo:

       · El velo del diseño es #2F4156, un gris pizarra que no está en la
         paleta. Se cambia por el azul noche de la casa (#0A1730), el mismo
         que usan las portadas interiores, el cartel y el pie: así la página
         entera es un solo azul. Baja al 88 % —el diseño pedía 90— para que la
         fotografía no desaparezca del todo con un azul más oscuro.
         El dorado no es el #C8994F del diseño sino el `--color-accent` que
         `.on-dark` ya define (#D0A35C): está a 13/255 de aquel —imperceptible—
         y sobre este velo da 7,7:1, o 5,5:1 en el peor caso imaginable (que la
         foto de debajo fuese blanca). Cumple AA para texto normal, no solo
         para texto grande. El bronce del tema, #7D5518, daría 1,58:1 aquí.

       · El diseño está maquetado con posiciones absolutas sobre un lienzo de
         2304 px. Aquí es una rejilla dentro de `.wrap`, para que el texto quede
         alineado con la barra de navegación y con las secciones de abajo en
         vez de flotar a un porcentaje fijo.

       · Los dos botones no están en el diseño. Sin ellos la portada abre sin
         ninguna salida salvo el menú, así que van a la derecha, sobre la
         filigrana: dónde y cuándo, que son las dos preguntas de quien llega
         por primera vez.

       · El logotipo pasa a SVG. El del diseño es el mismo dibujo que
         marca/logo-blanco.png (proporción 4,437 contra 4,420) pero vectorial,
         que a este tamaño se nota.
  ══════════════════════════════════════════════════════════════════════ -->
  <section
    class="on-dark relative -mt-16 flex min-h-[85vh] items-center overflow-hidden lg:min-h-[clamp(32rem,42vw,52rem)]"
  >
    <Image
      src={IMG.heroCongregados}
      alt=""
      aria-hidden="true"
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- Velo plano, no degradado: la forma es la del diseño; el color, el de
         la casa (ver la nota de arriba). -->
    <div class="absolute inset-0 bg-[#0a1730]/88"></div>

    <!-- Filigrana de marca, sangrando por arriba y por abajo. Las dos medidas
         salen de los marcos de Figma: en móvil arranca al 53 % y mide el 116 %
         del alto; en escritorio, al 49 % y el 169 %. Que el logotipo la pise
         está en el diseño y no estorba: es un tono sobre tono al 20 %. -->
    <img
      src="/marca/filigrana.svg"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute left-[53%] top-1/2 h-[116%] w-auto -translate-y-1/2 lg:left-[49%] lg:h-[169%]"
    />

    <div class="rule absolute inset-x-0 bottom-0" aria-hidden="true"></div>

    <div
      class="wrap relative z-10 grid items-center gap-10 px-4 pb-20 pt-28 lg:grid-cols-12 lg:gap-8"
    >
      <div class="lg:col-span-8">
        <p class="entra eyebrow text-accent" style="--i:0">Iglesia Evangélica</p>

        <h1 class="entra mt-5" style="--i:1">
          <img
            src="/marca/logo-blanco.svg"
            alt={SITE.name}
            width="819"
            height="185"
            fetchpriority="high"
            class="h-14 w-auto sm:h-16 md:h-20 lg:h-28"
          />
        </h1>

        <p class="entra versiculo mt-8 max-w-xl text-lg text-white md:text-xl" style="--i:2">
          «{SITE.verse.text}»
        </p>
        <p
          class="entra font-data mt-3 text-base uppercase tracking-[0.12em] text-accent md:text-lg"
          style="--i:3"
        >
          {SITE.verse.ref}
        </p>
      </div>

      <div
        class="entra flex flex-wrap gap-3 lg:col-span-4 lg:flex-col lg:items-stretch"
        style="--i:4"
      >
        <a href="/templos" class="btn btn-primary gap-2">
          <Icon name="lucide:map-pin" class="h-5 w-5" /> Dónde estamos
        </a>
        <a href="/horarios" class="btn gap-2 btn-invert">
          <Icon name="lucide:calendar-days" class="h-5 w-5" /> Cuándo nos reunimos
        </a>
      </div>
    </div>
  </section>

  <!-- ══ Quiénes somos ═══════════════════════════════════════════════════ -->
  <section id="nosotros" class="section bg-base-100">
    <div class="wrap">
      <div class="grid gap-5 md:grid-cols-3 md:grid-rows-2">
        <Reveal
          class="on-dark group relative col-span-1 min-h-[22rem] overflow-hidden rounded-xl md:col-span-2 md:row-span-2"
        >
          <Image
            src={IMG.adoracion}
            alt="Reunión de adoración"
            widths={[600, 1000]}
            sizes="(max-width:768px) 100vw, 66vw"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-[#0a1730]/95 via-[#0a1730]/50 to-[#0a1730]/15"
          >
          </div>
          <div class="relative flex h-full flex-col justify-end p-8 text-white">
            <span class="eyebrow mb-3 text-accent">Sobre nosotros</span>
            <h2 class="text-3xl md:text-4xl">
              La Palabra de Dios es el fundamento de todo lo que hacemos
            </h2>
            <p class="mt-4 max-w-lg text-white/75">
              Buscamos vivir y compartir Su verdad, crecer en la fe y servir con amor.
            </p>
            <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
              <a
                href="/sobre-nosotros"
                class="inline-flex items-center gap-2 font-medium text-white hover:text-accent"
              >
                Quiénes somos <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
              <a
                href="/sobre-nosotros#historia"
                class="inline-flex items-center gap-2 font-medium text-white/75 hover:text-accent"
              >
                Nuestra historia <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </Reveal>

        <Reveal delay={80} class="panel flex flex-col justify-center bg-base-200/60 p-8">
          <div class="mb-4 tile">
            <Icon name="lucide:target" class="h-6 w-6" />
          </div>
          <h2 class="text-2xl">Nuestra misión</h2>
          <p class="mt-2 text-base-content/75">
            Predicar el evangelio, discipular creyentes y servir a otros con amor y excelencia.
          </p>
        </Reveal>

        <Reveal delay={160} class="panel flex flex-col justify-center bg-base-200/60 p-8">
          <div class="flex items-baseline gap-2">
            <span
              data-count={templos.length}
              class="font-data text-5xl font-bold leading-none text-primary">0</span
            >
            <Icon name="lucide:map-pin" class="h-6 w-6 text-accent" />
          </div>
          <h2 class="mt-3 text-2xl">Templos</h2>
          <p class="mt-1 text-base-content/75">
            Comunidades en Santiago, San Miguel, Limache y Coya.
          </p>
          <a
            href="/templos"
            class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-accent"
          >
            Ver templos <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- ══ Templos ═════════════════════════════════════════════════════════ -->
  <section id="templos" class="section bg-base-200">
    <div class="wrap">
      <SectionHeading
        eyebrow="Nuestros templos"
        title="Encuentra el más cercano"
        subtitle="Únete a nuestra familia de fe en cualquiera de nuestras cuatro comunidades."
      />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          templos.map((t, i) => (
            <Reveal delay={(i % 4) * 90} class="h-full">
              <TemploCard templo={t} />
            </Reveal>
          ))
        }
      </div>

      <Reveal class="mt-10 text-center">
        <a href="/templos" class="btn btn-outline gap-2">
          Ver todos los templos en detalle <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </Reveal>
    </div>
  </section>

  <!-- ══ Redes y transmisión ═════════════════════════════════════════════ -->
  <CtaBand
    eyebrow="Conociendo la Palabra"
    title="Síguenos y crece en la fe"
    text="Prédicas, enseñanzas y la vida de nuestra comunidad, también fuera del templo."
    image={IMG.estudio}
  >
    <a
      href={youtube.href}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-lg gap-2 btn-invert"
    >
      <Icon name="lucide:youtube" class="h-5 w-5" /> Ver en YouTube
    </a>
    <a
      href={instagram.href}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-lg gap-2 btn-invert"
    >
      <Icon name="lucide:instagram" class="h-5 w-5" /> Instagram
    </a>
    <a href="/en-vivo" class="btn btn-lg gap-2 btn-invert">
      <span class="pulse-dot inline-block h-2.5 w-2.5 rounded-full bg-red-500" aria-hidden="true"
      ></span>
      En vivo
    </a>
  </CtaBand>
</Layout>
