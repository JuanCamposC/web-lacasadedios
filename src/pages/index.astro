---
import Layout from '../layouts/Layout.astro';
import { templos } from '../data/templos';

const toneRing = {
	primary: 'bg-primary/10 group-hover:bg-primary/20',
	secondary: 'bg-secondary/10 group-hover:bg-secondary/20',
	accent: 'bg-accent/10 group-hover:bg-accent/20',
} as const;

const toneBtn = {
	primary: 'btn-primary',
	secondary: 'btn-secondary',
	accent: 'btn-accent',
} as const;

// Un tono por templo para variar el color de las tarjetas.
const cardTones = ['primary', 'secondary', 'accent', 'primary'] as const;
---

<Layout>
	<!-- Hero -->
	<section class="hero min-h-[88vh] relative overflow-hidden hero-bg">
		<div class="hero-content text-center z-10 relative">
			<div class="max-w-3xl px-4 animate-fade-in-up">
				<p class="text-sm md:text-base uppercase tracking-[0.3em] text-accent font-medium mb-5">
					Bienvenidos a
				</p>

				<img src="/logo.png" alt="La Casa de Dios" class="site-logo mx-auto h-24 md:h-32 w-auto mb-6" width="605" height="204" />

				<div class="divider divider-accent max-w-xs mx-auto opacity-60"></div>

				<p class="text-xl md:text-2xl mb-6 text-base-content/80 font-light italic max-w-2xl mx-auto">
					"Porque donde dos o tres se reúnen en mi nombre, allí estoy yo en medio de ellos"
				</p>
				<p class="text-base md:text-lg mb-10 text-base-content/70 max-w-2xl mx-auto">
					La Palabra de Dios es el fundamento de todo lo que hacemos. Buscamos vivir y
					compartir Su verdad, crecer en la fe y servir con amor.
				</p>

				<div class="flex flex-wrap gap-4 justify-center">
					<a href="#templos" class="btn btn-primary btn-lg gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
						Nuestros templos
					</a>
					<a href="/sobre-nosotros" class="btn btn-outline btn-lg gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
						Conócenos
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Info -->
	<section class="py-20 px-4 bg-base-100">
		<div class="container mx-auto max-w-7xl">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
					<div class="card-body text-center">
						<div class="flex justify-center mb-4">
							<div class="w-20 h-20 rounded-full bg-primary/10 flex items-center justify-center">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
							</div>
						</div>
						<h2 class="card-title justify-center text-2xl mb-3 font-display">Nuestros templos</h2>
						<p class="text-base-content/70 mb-6">
							Cuatro comunidades en Santiago, San Miguel, Limache y Coya. Encuentra
							direcciones, horarios de cultos y cómo llegar.
						</p>
						<div class="card-actions justify-center">
							<a href="#templos" class="btn btn-primary">Ver templos</a>
						</div>
					</div>
				</div>

				<div class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all duration-300 hover:-translate-y-2">
					<div class="card-body text-center">
						<div class="flex justify-center mb-4">
							<div class="w-20 h-20 rounded-full bg-accent/10 flex items-center justify-center">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
							</div>
						</div>
						<h2 class="card-title justify-center text-2xl mb-3 font-display">Sobre nosotros</h2>
						<p class="text-base-content/70 mb-6">
							Conoce nuestra visión, misión, valores y declaración de fe. Una familia
							comprometida con la enseñanza de la Palabra.
						</p>
						<div class="card-actions justify-center">
							<a href="/sobre-nosotros" class="btn btn-accent">Saber más</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Templos -->
	<section id="templos" class="py-20 px-4 bg-base-200">
		<div class="container mx-auto max-w-7xl">
			<div class="text-center mb-16">
				<h2 class="font-display text-4xl md:text-5xl font-bold mb-4">Nuestros templos</h2>
				<div class="divider divider-primary max-w-xs mx-auto"></div>
				<p class="text-xl text-base-content/70 max-w-2xl mx-auto">
					Encuentra el templo más cercano y únete a nuestra familia de fe
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{templos.map((t, i) => (
					<a href={`/templos/${t.slug}`} class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 group border border-base-300">
						<figure class="px-10 pt-10">
							<div class={`w-24 h-24 rounded-full flex items-center justify-center transition-colors ${toneRing[cardTones[i]]}`}>
								<span class="text-5xl">{t.emoji}</span>
							</div>
						</figure>
						<div class="card-body items-center text-center">
							<h3 class="card-title text-2xl">{t.short}</h3>
							<p class="text-base-content/70">{t.tagline}</p>
							<p class="text-xs text-base-content/50 mt-1">{t.region}</p>
							<div class="card-actions mt-4">
								<span class={`btn btn-sm btn-outline ${toneBtn[cardTones[i]]} gap-2`}>
									Ver más
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
								</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Redes -->
	<section class="py-20 px-4 bg-base-100">
		<div class="container mx-auto max-w-6xl">
			<div class="text-center mb-16">
				<h2 class="font-display text-4xl md:text-5xl font-bold mb-4">Síguenos</h2>
				<div class="divider divider-primary max-w-xs mx-auto"></div>
				<p class="text-xl text-base-content/70">
					Conéctate con lo que Dios está haciendo a través de nuestras plataformas
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
				<div class="card bg-gradient-to-br from-purple-500 via-pink-500 to-orange-500 text-white shadow-2xl">
					<div class="card-body items-center text-center">
						<div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mb-4 backdrop-blur-sm">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
						</div>
						<h3 class="card-title text-3xl mb-2">Instagram</h3>
						<p class="mb-4">En @jovenescasadedios._ podrás ver actividades e información de nuestras reuniones.</p>
						<a href="https://instagram.com/jovenescasadedios._" target="_blank" rel="noopener noreferrer" class="btn btn-outline border-white text-white hover:bg-white hover:text-purple-600">Ver Instagram</a>
					</div>
				</div>

				<div class="card bg-gradient-to-br from-red-600 to-red-800 text-white shadow-2xl">
					<div class="card-body items-center text-center">
						<div class="w-20 h-20 bg-white/20 rounded-full flex items-center justify-center mb-4 backdrop-blur-sm">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
						</div>
						<h3 class="card-title text-3xl mb-2">YouTube</h3>
						<p class="mb-4">Encuentra la Palabra de Dios con cientos de videos en "Conociendo la Palabra".</p>
						<a href="https://www.youtube.com/@casadediosconociendolapalabrad" target="_blank" rel="noopener noreferrer" class="btn btn-outline border-white text-white hover:bg-white hover:text-red-600">Ver canal</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Fondo del hero adaptable al tema (claro y oscuro) usando tokens DaisyUI */
	.hero-bg {
		background:
			radial-gradient(ellipse 75% 55% at 50% -5%, oklch(var(--p) / 0.12) 0%, transparent 62%),
			linear-gradient(180deg, oklch(var(--b1)) 0%, oklch(var(--b2)) 100%);
	}
</style>
