---
/**
 * Se arma al servir: los horarios se editan desde el panel (ver
 * /admin/horarios) y una página generada al compilar los congelaría hasta el
 * siguiente despliegue — que es justo lo que el panel viene a evitar. Si alguien
 * suspende la reunión del jueves, esta página tiene que decirlo ese mismo día.
 *
 * La CDN la sirve ya hecha un minuto y la rehace por detrás hasta diez más: un
 * cambio en el panel se ve en uno o dos minutos, y cien visitas seguidas son
 * una sola consulta a la base.
 */
export const prerender = false;
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import CtaBand from '../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import Distintivo from '../components/Distintivo.astro';
import { templos, estiloDistintivo } from '../data/templos';
import { IMG } from '../assets/images';
import { baseDeDatos } from '../lib/base';
import { reunionesPublicadas } from '../lib/datos';
import { porDia, enPie, type Reunion } from '../lib/reuniones';
import type { Templo } from '../data/templos';

let reuniones: Reunion[] = [];
try {
  reuniones = await reunionesPublicadas(await baseDeDatos());
} catch (e) {
  // Sin base no hay horarios que enseñar, pero la página no se cae: el aviso de
  // «sin resultados» y el enlace de contacto siguen sirviendo.
  console.error('[horarios]', e);
}
const temploDe = (slug: string) => templos.find((t) => t.slug === slug)!;

/**
 * Las reuniones que coinciden en día, hora y nombre se enseñan en UNA línea
 * con las etiquetas de los templos que las tienen.
 *
 * Antes cada templo ponía su propia línea: los domingos aparecían cuatro
 * «Reunión General» seguidas, con la misma hora, y lo único que cambiaba era
 * la etiqueta del final. Eso es ruido: lo que se lee es el horario, y el
 * templo es el matiz.
 *
 * El estado entra en la clave a propósito: si en San Miguel se suspende la
 * del domingo y en Limache no, son dos cosas distintas y no pueden compartir
 * línea, porque la línea diría que ambas están suspendidas.
 */
interface Grupo {
  hora: string;
  nombre: string;
  estado: Reunion['estado'];
  aviso: string | null;
  sedes: Templo[];
}

function agrupar(deEseDia: Reunion[]): Grupo[] {
  const grupos = new Map<string, Grupo>();
  for (const r of deEseDia) {
    const clave = `${r.hora}|${r.nombre}|${r.estado}|${r.aviso ?? ''}`;
    const grupo = grupos.get(clave);
    if (grupo) grupo.sedes.push(temploDe(r.templo));
    else {
      grupos.set(clave, {
        hora: r.hora,
        nombre: r.nombre,
        estado: r.estado,
        aviso: r.aviso,
        sedes: [temploDe(r.templo)],
      });
    }
  }
  // Las sedes, en el orden en que están los templos en el sitio, para que la
  // misma reunión no cambie de orden de un día a otro.
  const orden = templos.map((t) => t.slug);
  return [...grupos.values()].map((g) => ({
    ...g,
    sedes: g.sedes.sort((a, b) => orden.indexOf(a.slug) - orden.indexOf(b.slug)),
  }));
}

const semana = porDia(reuniones).map((d) => ({ ...d, grupos: agrupar(d.reuniones) }));
---

<Layout
  title="Horarios de reuniones · La Casa de Dios"
  description="Todas las reuniones y estudios bíblicos de La Casa de Dios en Santiago Centro, San Miguel, Limache y Coya, día por día."
>
  <PageHero
    image={IMG.biblia}
    alt="Biblia abierta"
    eyebrow="Toda la semana"
    title="Horarios de reuniones"
    subtitle={`${enPie(reuniones)} reuniones semanales entre nuestros ${templos.length} templos.`}
    height="min-h-[46vh]"
  />

  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Templos', href: '/templos' },
      { label: 'Horarios' },
    ]}
  />

  {
    /* El filtro y el tablero, en un mismo bloque: así la barra deja de estar
      pegada arriba cuando termina el horario, en vez de seguir flotando sobre
      el cierre de la página. */
  }
  <div class="ambito-filtro">
    <!-- Filtro por templo -->
    <section class="sticky top-16 z-30 border-b border-base-300 bg-base-100 px-4 py-3">
      <div class="wrap">
        <div
          class="flex items-center gap-2 overflow-x-auto pb-1"
          role="group"
          aria-label="Filtrar por templo"
        >
          <span
            class="font-data hidden shrink-0 pr-1 text-xs uppercase tracking-[0.18em] text-base-content/45 sm:inline"
          >
            Filtrar
          </span>
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="filtro-chip shrink-0 rounded-full border border-primary bg-primary px-4 py-1.5 text-sm font-medium text-primary-content transition"
          >
            Todos
          </button>
          {
            templos.map((t) => (
              <button
                type="button"
                data-filter={t.slug}
                aria-pressed="false"
                class="filtro-chip shrink-0 rounded-full border border-base-300 bg-base-100 px-4 py-1.5 text-sm font-medium transition hover:border-primary hover:text-primary"
              >
                {t.short}
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- El cartel: la semana completa -->
    {
      /* Lo primero: qué hay HOY y cuál es la próxima reunión.
  
         Se rellena en el navegador y no en el servidor porque estas páginas van
         con caché de CDN: un «hoy» renderizado arriba llegaría caducado al
         segundo visitante. Y se calcula en hora de Chile a propósito —no en la
         del visitante—, que es la que rige las reuniones.
  
         Sin JavaScript no aparece nada de esto y la semana completa se ve igual
         que siempre: es un añadido, no un requisito. */
    }
    <section class="section-sm section bg-base-100">
      <div class="wrap">
        <div class="hidden" data-ahora>
          <div class="grid gap-5 md:grid-cols-2">
            <div class="panel p-6 sm:p-7">
              <span class="eyebrow text-primary" data-ahora-dia></span>
              <ul class="mt-4 flex flex-col gap-3" data-ahora-hoy></ul>
              <p class="mt-4 hidden text-base-content/70" data-ahora-sinhoy>
                Hoy no hay reuniones. La próxima está aquí al lado.
              </p>
            </div>
            <div class="panel p-6 sm:p-7">
              {
                /* El rótulo cambia a «Ahora mismo» cuando hay una reunión pasando;
                  lo pone el script, que es quien sabe la hora de Chile. */
              }
              <span class="eyebrow text-primary" data-ahora-rotulo>Próxima reunión</span>
              <p class="mt-4 font-display text-2xl leading-tight" data-ahora-prox></p>
              <p class="mt-1 text-base-content/70" data-ahora-cuando></p>
              <a class="btn btn-primary btn-sm mt-5 gap-2" data-ahora-enlace>
                <Icon name="lucide:map-pin" class="h-4 w-4" /> Cómo llegar
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-base-200">
      <div class="wrap">
        <Reveal>
          <div class="cartel" data-cartel-semana>
            <header class="cartel-cab">
              <span class="cartel-titulo">La semana completa</span>
              <span class="cartel-hoy" data-hoy aria-live="polite"></span>
            </header>

            {
              semana.map((dia) => (
                <details data-dia data-dia-indice={dia.dia} open>
                  <summary class="cartel-seccion">
                    <h2>{dia.nombre}</h2>
                    <span class="cartel-conteo" data-conteo>
                      {dia.reuniones.length} {dia.reuniones.length === 1 ? 'reunión' : 'reuniones'}
                    </span>
                  </summary>
                  <ul class="cartel-lista">
                    {dia.grupos.map((g) => (
                      <li
                        class="cartel-linea"
                        data-servicio
                        data-templos={g.sedes.map((t) => t.slug).join(' ')}
                        data-hora={g.hora}
                        data-nombre={g.nombre}
                        data-sedes={JSON.stringify(
                          g.sedes.map((t) => ({
                            slug: t.slug,
                            short: t.short,
                            estilo: estiloDistintivo(t),
                          })),
                        )}
                        data-estado={g.estado}
                      >
                        <span class="cartel-hora">{g.hora}</span>
                        <span class="cartel-nombre">
                          {g.nombre}
                          {g.estado === 'suspendida' && <span class="sr-only"> (suspendida)</span>}
                        </span>
                        <span class="cartel-lugares">
                          {g.sedes.map((t) => (
                            <Distintivo
                              templo={t}
                              href={`/templos/${t.slug}`}
                              class="cartel-lugar"
                            />
                          ))}
                        </span>
                        {g.estado !== 'normal' && (
                          <span class="cartel-aviso">
                            <Icon
                              name={g.estado === 'suspendida' ? 'lucide:ban' : 'lucide:clock-alert'}
                              class="h-4 w-4 shrink-0"
                            />
                            {g.aviso ??
                              (g.estado === 'suspendida' ? 'Suspendida' : 'Cambio de horario')}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              ))
            }

            <footer class="cartel-pie">
              Los horarios pueden cambiar en fechas especiales. Ante la duda, escríbenos.
            </footer>
          </div>
        </Reveal>

        <p
          id="sin-resultados"
          class="mt-6 hidden rounded-lg border border-dashed border-base-300 px-6 py-10 text-center text-base-content/60"
        >
          Ese templo no tiene reuniones cargadas.
        </p>

        <p class="mt-8 text-center text-sm text-base-content/60">
          ¿Cambió un horario o falta una reunión?
          <a href="/contacto" class="link link-primary">Avísanos</a>.
        </p>
      </div>
    </section>
  </div>

  <CtaBand
    eyebrow="Ven cuando quieras"
    title="No hace falta avisar"
    text="Llega unos minutos antes, siéntate donde te acomode y sé bienvenido. Si prefieres que alguien te reciba, escríbenos y te esperamos en la puerta."
    image={IMG.congregacion}
    compact
  >
    <a href="/contacto" class="btn btn-primary gap-2">
      <Icon name="lucide:mail" class="h-5 w-5" /> Escríbenos
    </a>
    <a href="/templos" class="btn gap-2 btn-invert">
      <Icon name="lucide:church" class="h-5 w-5" /> Ver los templos
    </a>
  </CtaBand>
</Layout>

<script>
  const DIAS = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

  /**
   * Cuánto se da por que dura una reunión, para decir «en curso».
   *
   * La tabla guarda la hora de inicio y nada más. Dos horas es la misma cifra
   * que usa el resto del sitio (ver DURACION_REUNION_MIN en src/lib/reuniones.ts);
   * acá va suelta porque este script no importa ese módulo.
   */
  const DURACION_MIN = 120;

  /**
   * El momento actual EN CHILE, no en el reloj de quien mira.
   *
   * Las reuniones son a una hora concreta en Santiago: para alguien que abra la
   * página desde otro huso, «hoy» y «la próxima» tienen que seguir siendo las
   * de la iglesia. Y se calcula aquí y no en el servidor porque estas páginas
   * van con caché de CDN — un «hoy» renderizado arriba llegaría caducado al
   * segundo visitante.
   */
  function ahoraEnChile() {
    const partes = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Santiago',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date());
    const v = Object.fromEntries(partes.map((x) => [x.type, x.value]));
    const INDICE: Record<string, number> = {
      Sun: 0,
      Mon: 1,
      Tue: 2,
      Wed: 3,
      Thu: 4,
      Fri: 5,
      Sat: 6,
    };
    // `hour` llega como "24" a medianoche en algunos motores.
    const hora = Number(v.hour) % 24;
    return { dia: INDICE[v.weekday] ?? 0, minutos: hora * 60 + Number(v.minute) };
  }

  /** "19:30" → 1170. Null si el dato viene mal escrito. */
  function aMinutos(hhmm: string): number | null {
    const m = /^(\d{1,2}):(\d{2})$/.exec(hhmm.trim());
    if (!m) return null;
    return Number(m[1]) * 60 + Number(m[2]);
  }

  function faltan(minutos: number): string {
    if (minutos <= 0) return 'está empezando';
    if (minutos < 60) return `en ${minutos} min`;
    const h = Math.floor(minutos / 60);
    if (h < 24) return `en ${h} h${minutos % 60 ? ` ${minutos % 60} min` : ''}`;
    const d = Math.round(h / 24);
    return d === 1 ? 'mañana' : `en ${d} días`;
  }

  function initHorarios() {
    const cartel = document.querySelector<HTMLElement>('[data-cartel-semana]');
    if (!cartel || cartel.dataset.listo) return;
    cartel.dataset.listo = '1';

    const dias = Array.from(cartel.querySelectorAll<HTMLDetailsElement>('[data-dia]'));
    const ahora = ahoraEnChile();

    const reuniones = dias.flatMap((dia) => {
      const diaIndice = Number(dia.dataset.diaIndice);
      return Array.from(dia.querySelectorAll<HTMLElement>('[data-servicio]')).map((fila) => {
        let sedes: { slug: string; short: string; estilo: string }[] = [];
        try {
          sedes = JSON.parse(fila.dataset.sedes ?? '[]');
        } catch {
          /* una línea sin sedes legibles se cuenta igual, sin etiquetas */
        }
        return {
          diaIndice,
          minutos: aMinutos(fila.dataset.hora ?? '') ?? 0,
          nombre: fila.dataset.nombre ?? '',
          hora: fila.dataset.hora ?? '',
          suspendida: fila.dataset.estado === 'suspendida',
          sedes,
        };
      });
    });

    /* ── Panel de arriba ─────────────────────────────────────────────────── */
    const panel = document.querySelector<HTMLElement>('[data-ahora]');
    const elDia = document.querySelector<HTMLElement>('[data-ahora-dia]');
    const elHoy = document.querySelector<HTMLElement>('[data-ahora-hoy]');
    const elSinHoy = document.querySelector<HTMLElement>('[data-ahora-sinhoy]');
    const elProx = document.querySelector<HTMLElement>('[data-ahora-prox]');
    const elCuando = document.querySelector<HTMLElement>('[data-ahora-cuando]');
    const elEnlace = document.querySelector<HTMLAnchorElement>('[data-ahora-enlace]');

    function pintarAhora(slug: string) {
      if (!panel || !elDia || !elHoy || !elProx || !elCuando || !elEnlace) return;
      const suyas = reuniones.filter((r) => slug === 'all' || r.sedes.some((s) => s.slug === slug));

      elDia.textContent = `Hoy · ${DIAS[ahora.dia]}`;
      const hoy = suyas.filter((r) => r.diaIndice === ahora.dia);
      elHoy.replaceChildren();

      // Se construye con createElement y textContent, no con innerHTML: los
      // nombres salen de datos editables y concatenar HTML aquí sería una vía
      // de inyección por muy propio que parezca el contenido.
      hoy.forEach((r) => {
        const li = document.createElement('li');
        // Envuelve: una reunión que coincide en los cuatro templos lleva cuatro
        // etiquetas, y en el teléfono no caben en una línea.
        li.className = 'flex flex-wrap items-baseline gap-x-3 gap-y-1';

        // Tres estados y no dos: la que está PASANDO ahora no puede verse igual
        // que una que ya terminó. Antes se tachaba en cuanto daba la hora, así
        // que a las 19:05 la web daba por perdida una reunión recién empezada.
        const enCurso =
          !r.suspendida && ahora.minutos >= r.minutos && ahora.minutos < r.minutos + DURACION_MIN;
        const pasada = !enCurso && (r.minutos < ahora.minutos || r.suspendida);

        const hora = document.createElement('span');
        hora.className = `font-data text-lg font-bold ${pasada ? 'text-base-content/35' : 'text-primary'}`;
        hora.textContent = r.hora;

        const texto = document.createElement('span');
        texto.className = pasada ? 'text-base-content/35 line-through' : '';
        texto.textContent = r.nombre;

        // La marca de «en curso», con el punto que late. Se arma con elementos y
        // textContent, como el resto de esta lista: nada de concatenar HTML con
        // datos que se editan desde el panel.
        let marca: HTMLElement | null = null;
        if (enCurso) {
          marca = document.createElement('span');
          marca.className =
            'inline-flex items-center gap-1.5 rounded-full bg-success/15 px-2 py-0.5 text-xs font-bold uppercase tracking-wider text-success';
          const punto = document.createElement('span');
          punto.className = 'pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-success';
          punto.setAttribute('aria-hidden', 'true');
          marca.append(punto, document.createTextNode('En curso'));
        }

        // Los templos en su color, igual que en el cartel de abajo: en «hoy» es
        // donde más importa saber de un vistazo a qué templo hay que ir. Si la
        // reunión coincide en varios, van todas las etiquetas en la misma línea.
        li.append(hora, texto);
        if (marca) li.append(marca);
        for (const s of r.sedes) {
          const sede = document.createElement('span');
          sede.className = 'distintivo ml-2 align-middle';
          sede.setAttribute('style', s.estilo);
          sede.textContent = s.short;
          li.append(sede);
        }
        elHoy.appendChild(li);
      });
      elSinHoy?.classList.toggle('hidden', hoy.length > 0);

      // La próxima: la de hoy si queda alguna, y si no se avanza día a día
      // hasta dar la vuelta a la semana.
      let proxima: (typeof suyas)[number] | null = null;
      let espera = Infinity;
      for (const r of suyas) {
        // «La próxima reunión» nunca puede ser una suspendida: sería mandar a
        // alguien a una puerta cerrada.
        if (r.suspendida) continue;
        const d = (r.diaIndice - ahora.dia + 7) % 7;
        let mins = d * 1440 + r.minutos - ahora.minutos;
        if (mins < 0) mins += 7 * 1440; // ya pasó hoy: toca la semana que viene
        if (mins < espera) {
          espera = mins;
          proxima = r;
        }
      }

      // ¿Hay algo pasando ahora mismo? Es lo primero que mira quien abre esta
      // página a la hora de una reunión, y hasta ahora no se decía en ninguna
      // parte: había que deducirlo del horario.
      const corriendo = suyas.find(
        (r) =>
          !r.suspendida &&
          r.diaIndice === ahora.dia &&
          ahora.minutos >= r.minutos &&
          ahora.minutos < r.minutos + DURACION_MIN,
      );
      const rotulo = document.querySelector<HTMLElement>('[data-ahora-rotulo]');
      if (rotulo) rotulo.textContent = corriendo ? 'Ahora mismo' : 'Próxima reunión';

      if (corriendo) {
        const sede = corriendo.sedes.find((s) => s.slug === slug) ?? corriendo.sedes[0];
        elProx.textContent = `${corriendo.nombre} · ${corriendo.sedes.map((s) => s.short).join(' · ')}`;
        elCuando.textContent = `En curso · empezó a las ${corriendo.hora}`;
        elEnlace.href = sede ? `/templos/${sede.slug}` : '/templos';
        elEnlace.classList.remove('hidden');
        panel.classList.remove('hidden');
        return;
      }

      if (proxima) {
        // Con el filtro puesto se enlaza a ESE templo; sin filtro, al primero
        // de los que la tienen, que es el orden en que están en el sitio.
        const sede = proxima.sedes.find((s) => s.slug === slug) ?? proxima.sedes[0];
        elProx.textContent = `${proxima.nombre} · ${proxima.sedes.map((s) => s.short).join(' · ')}`;
        elCuando.textContent = `${DIAS[proxima.diaIndice]} a las ${proxima.hora} — ${faltan(espera)}`;
        elEnlace.href = sede ? `/templos/${sede.slug}` : '/templos';
        elEnlace.classList.remove('hidden');
      } else {
        elProx.textContent = 'Ese templo no tiene reuniones cargadas.';
        elCuando.textContent = '';
        elEnlace.classList.add('hidden');
      }
      panel.classList.remove('hidden');
    }

    /* ── Filtro por templo ───────────────────────────────────────────────── */
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtro-chip'));
    const vacio = document.getElementById('sin-resultados');
    const etiqueta = cartel.querySelector<HTMLElement>('[data-hoy]');
    const activo = 'border-primary bg-primary text-primary-content';
    const inactivo = 'border-base-300 bg-base-100 hover:border-primary hover:text-primary';

    const aplicar = (slug: string) => {
      let visibles = 0;

      dias.forEach((dia) => {
        let n = 0;
        dia.querySelectorAll<HTMLElement>('[data-servicio]').forEach((fila) => {
          const suyos = (fila.dataset.templos ?? '').split(' ').filter(Boolean);
          const ok = slug === 'all' || suyos.includes(slug);
          fila.classList.toggle('hidden', !ok);
          // Cuenta reuniones, no líneas: una línea puede ser la misma reunión en
          // tres templos, y el día tiene tres.
          if (ok) n += slug === 'all' ? suyos.length : 1;
        });

        const conteo = dia.querySelector<HTMLElement>('[data-conteo]');
        if (conteo) conteo.textContent = `${n} ${n === 1 ? 'reunión' : 'reuniones'}`;
        dia.classList.toggle('hidden', n === 0);

        const esHoy = Number(dia.dataset.diaIndice) === ahora.dia;
        dia.classList.toggle('es-hoy', esHoy);
        // Solo hoy queda desplegado; el resto está a un clic. En el HTML todos
        // vienen con `open`, así que sin JavaScript se sigue viendo la semana
        // entera y nadie se queda sin la información.
        dia.open = esHoy;
        visibles += n;
      });

      vacio?.classList.toggle('hidden', visibles > 0);
      if (etiqueta) etiqueta.textContent = `Hoy · ${DIAS[ahora.dia]}`;

      chips.forEach((c) => {
        const on = c.dataset.filter === slug;
        c.setAttribute('aria-pressed', String(on));
        c.className = `filtro-chip shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition ${on ? activo : inactivo}`;
      });

      pintarAhora(slug);
    };

    chips.forEach((c) => c.addEventListener('click', () => aplicar(c.dataset.filter || 'all')));

    // Permite llegar filtrado desde otra página: /horarios?templo=limache
    const pedido = new URLSearchParams(location.search).get('templo');
    aplicar(pedido && chips.some((c) => c.dataset.filter === pedido) ? pedido : 'all');
  }

  document.addEventListener('astro:page-load', initHorarios);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHorarios);
  } else {
    initHorarios();
  }
</script>
