---
export const prerender = false;

// La página se arma en cada petición, pero su contenido cambia como mucho unas
// veces al mes. Se deja que la CDN de Cloudflare la sirva ya hecha durante un
// minuto y que siga sirviéndola hasta diez minutos más mientras la rehace por
// detrás: durante una transmisión, cien visitas seguidas son una sola consulta
// a la base en vez de cien.
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EmptyState from '../components/EmptyState.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../assets/images';
import { YOUTUBE_CHANNEL } from '../data/site';
import { youtubeId } from '../lib/youtube';
import { baseDeDatos } from '../lib/base';
import { ajustes } from '../lib/datos';

const settings = await ajustes(await baseDeDatos());
const live = settings?.vivo_activo === 1;
const vid = live && settings?.vivo_url ? youtubeId(settings.vivo_url) : null;
const title = settings?.vivo_titulo || 'Transmisión en vivo';
---

<Layout
  title="En vivo · La Casa de Dios"
  description="Mira la transmisión en vivo de La Casa de Dios — Conociendo la Palabra."
>
  <PageHero
    image={IMG.envivoPortada}
    alt="Adoración"
    eyebrow="Transmisión"
    title="En vivo"
    subtitle="Únete a nuestras reuniones y prédicas desde donde estés."
    height="min-h-[42vh]"
  />

  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'En vivo' }]} />

  <section class="section bg-base-100">
    <div class="wrap-narrow">
      {
        live && vid ? (
          <div data-reveal>
            <div class="mb-4 flex items-center gap-2">
              <span
                class="pulse-dot inline-block h-3 w-3 rounded-full bg-red-500"
                aria-hidden="true"
              />
              <span class="font-semibold text-red-500">En vivo ahora</span>
            </div>
            <div class="aspect-video overflow-hidden rounded-lg border border-base-300 bg-black shadow-lg">
              <iframe
                class="h-full w-full"
                src={`https://www.youtube-nocookie.com/embed/${vid}?autoplay=1`}
                title={title}
                loading="eager"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
            <h2 class="mt-5 font-display text-2xl">{title}</h2>
            <a
              href={YOUTUBE_CHANNEL}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent"
            >
              <Icon name="lucide:youtube" class="h-4 w-4" /> Verlo en YouTube
            </a>
          </div>
        ) : live && settings?.vivo_url ? (
          <EmptyState
            icon="lucide:radio"
            title={title}
            text="Estamos transmitiendo en vivo en este momento."
          >
            <a
              href={settings.vivo_url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary gap-2"
            >
              <Icon name="lucide:youtube" class="h-5 w-5" /> Ver transmisión
            </a>
          </EmptyState>
        ) : (
          <EmptyState
            icon="lucide:radio"
            title="No hay transmisión en este momento"
            text="Cuando estemos en vivo lo verás aquí. Mientras tanto, en el canal están todas las prédicas anteriores."
          >
            <a
              href={YOUTUBE_CHANNEL}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary gap-2"
            >
              <Icon name="lucide:youtube" class="h-5 w-5" /> Ir al canal
            </a>
            <a href="/videos" class="btn btn-ghost gap-2">
              <Icon name="lucide:play" class="h-5 w-5" /> Ver videos
            </a>
          </EmptyState>
        )
      }
    </div>
  </section>
</Layout>
