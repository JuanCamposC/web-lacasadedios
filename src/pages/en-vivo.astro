---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../assets/images';
import { youtubeId, type SiteSettings } from '../lib/supabase';

const supabase = Astro.locals.supabase;
let settings: SiteSettings | null = null;
if (supabase) {
  const { data } = await supabase
    .from('settings')
    .select('live_enabled, live_url, live_title')
    .eq('id', 1)
    .maybeSingle();
  settings = (data as SiteSettings) ?? null;
}
const live = settings?.live_enabled ?? false;
const vid = live && settings?.live_url ? youtubeId(settings.live_url) : null;
const title = settings?.live_title || 'Transmisión en vivo';
const channel = 'https://www.youtube.com/@casadediosconociendolapalabrad';
---

<Layout title="En vivo · La Casa de Dios" description="Mira la transmisión en vivo de La Casa de Dios — Conociendo la Palabra.">
  <PageHero image={IMG.adoracion} alt="Adoración" eyebrow="Transmisión" title="En vivo" subtitle="Únete a nuestros cultos y prédicas desde donde estés." height="min-h-[42vh]" />

  <section class="bg-base-100 px-4 py-16">
    <div class="container mx-auto max-w-4xl">
      {live && vid ? (
        <div data-reveal>
          <div class="mb-4 flex items-center gap-2">
            <span class="pulse-dot inline-block h-3 w-3 rounded-full bg-red-500"></span>
            <span class="font-semibold text-red-500">En vivo ahora</span>
          </div>
          <div class="aspect-video overflow-hidden rounded-2xl border border-base-300 shadow-lg">
            <iframe class="h-full w-full" src={`https://www.youtube-nocookie.com/embed/${vid}?autoplay=1`} title={title} loading="eager" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
          <h2 class="mt-5 font-display text-2xl font-bold">{title}</h2>
        </div>
      ) : live && settings?.live_url ? (
        <div data-reveal class="rounded-2xl border border-base-300 bg-base-100 p-10 text-center shadow-sm">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-red-500/10 text-red-500"><Icon name="lucide:radio" class="h-8 w-8" /></div>
          <h2 class="font-display text-2xl font-bold">{title}</h2>
          <p class="mt-2 opacity-70">Estamos transmitiendo en vivo.</p>
          <a href={settings.live_url} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-6 gap-2"><Icon name="lucide:youtube" class="h-5 w-5" /> Ver transmisión</a>
        </div>
      ) : (
        <div data-reveal class="rounded-2xl border border-base-300 bg-base-100 p-10 text-center shadow-sm">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-base-200 text-base-content/40"><Icon name="lucide:radio" class="h-8 w-8" /></div>
          <h2 class="font-display text-2xl font-bold">No hay transmisión en este momento</h2>
          <p class="mx-auto mt-2 max-w-md opacity-70">Cuando estemos en vivo lo verás aquí. Mientras tanto, visita nuestro canal y revisa los horarios de culto.</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href={channel} target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2"><Icon name="lucide:youtube" class="h-5 w-5" /> Ir al canal</a>
            <a href="/#templos" class="btn btn-outline gap-2"><Icon name="lucide:clock" class="h-5 w-5" /> Ver horarios</a>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
