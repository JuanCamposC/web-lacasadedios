---
export const prerender = false;

/**
 * El sitio entero en una sola hoja continua, para imprimirlo y revisarlo en
 * papel.
 *
 * ── PARA QUÉ ────────────────────────────────────────────────────────────────
 * Para llevarle los textos al pastor y que los corrija a mano. Revisar palabras
 * en una pantalla, saltando de página en página y perdiendo el hilo, no es lo
 * mismo que tener las hojas encima de la mesa y poder rayarlas.
 *
 * ── POR QUÉ JUNTA LAS PÁGINAS DE VERDAD ─────────────────────────────────────
 * Lo fácil habría sido escribir acá una copia de los textos. Sería mentira a
 * los dos días: alguien cambia una frase en el sitio y el papel ya no
 * corresponde, y entonces se revisa algo que no existe.
 *
 * Así que esta página pide las páginas COMPILADAS y les saca el contenido. Lo
 * que se imprime es el sitio, no una versión suya.
 *
 * ── POR QUÉ POR LA BINDING Y NO POR HTTP ────────────────────────────────────
 * `ASSETS.fetch()` no sale a la red: Cloudflare devuelve el archivo desde
 * dentro. Un `fetch()` normal a `https://pruebas.lacasadedios.cl/horarios`
 * saldría del Worker, entraría por la puerta principal y **se toparía con
 * Access**: nueve redirecciones a la pantalla de Google en vez de nueve
 * páginas.
 *
 * ── QUÉ NO ESTÁ ─────────────────────────────────────────────────────────────
 * Eventos, noticias y videos. Son listados que cambian solos y no tienen texto
 * que aprobar; además se arman al servir, así que no existen como archivo.
 */
import { archivos } from '../lib/base';
import { SITE } from '../data/site';
import { templos } from '../data/templos';

/**
 * Qué se imprime.
 *
 * Por defecto SOLO las dos páginas que se están revisando ahora: la de inicio y
 * la de «sobre nosotros». Un documento de dos páginas se revisa de una sentada;
 * uno de once se deja para después y no se retoma.
 *
 * Con `?todo=1` salen todas, para cuando toque revisar el resto.
 */
const TODAS: { ruta: string; titulo: string }[] = [
  { ruta: '/', titulo: 'Inicio' },
  { ruta: '/sobre-nosotros', titulo: 'Sobre nosotros' },
  { ruta: '/estudio-biblico', titulo: 'Estudio bíblico' },
  { ruta: '/horarios', titulo: 'Horarios' },
  { ruta: '/templos', titulo: 'Nuestros templos' },
  ...templos.map((t) => ({ ruta: `/templos/${t.slug}`, titulo: `Templo · ${t.name}` })),
  { ruta: '/contacto', titulo: 'Contacto' },
];

// Por defecto salen solo las tres páginas que el pastor tiene que revisar:
// inicio, sobre nosotros y el estudio bíblico. Esta última entra porque es nueva
// y es casi toda texto escrito a falta de su visto bueno —incluida la
// introducción de qué se estudia—, que es justo lo que se le está pidiendo que
// mire. Con `?todo=1` salen las once.
const todo = Astro.url.searchParams.get('todo') === '1';
const PAGINAS = todo ? TODAS : TODAS.slice(0, 3);

/** Lo que se saca de cada página: su contenido y las hojas de estilo que usa. */
interface Extraido {
  html: string;
  hojas: string[];
}

/**
 * Saca el contenido de una página compilada, **y sus hojas de estilo**.
 *
 * Lo del `<main>` es lo evidente: fuera quedan la navegación, el pie y el
 * formulario del boletín, que en papel no sirven de nada. Se quitan además los
 * `<script>` y los `<dialog>`, que acá se pegan como texto dentro de otro
 * documento y volverían a ejecutarse sin el HTML que esperan.
 *
 * ── LO DE LAS HOJAS DE ESTILO, QUE SE ME PASÓ ───────────────────────────────
 * La primera versión se quedaba solo con el HTML, y salía un desastre: imágenes
 * a tamaño original, textos encima de otros, ni un margen. Se entiende al verlo:
 * el contenido son clases de Tailwind —`grid`, `max-w-3xl`, `object-cover`— y
 * esta página no cargaba NINGUNA hoja de estilos. Sin ellas, una clase es un
 * atributo sin significado y el navegador apila todo en bruto.
 *
 * Astro compila una hoja por página y le pone un hash en el nombre, así que no
 * vale con importar `global.css` acá: los estilos con ámbito de cada componente
 * viven en la hoja de SU página. Hay que recoger las de todas y juntarlas.
 */
function contenidoDe(html: string): Extraido | null {
  const m = html.match(/<main[^>]*>([\s\S]*?)<\/main>/i);
  if (!m) return null;

  const hojas = [...html.matchAll(/<link[^>]+rel=["']stylesheet["'][^>]*>/gi)]
    .map((l) => l[0].match(/href=["']([^"']+)["']/i)?.[1])
    .filter((h): h is string => Boolean(h));

  return {
    html: m[1]
      .replace(/<script[\s\S]*?<\/script>/gi, '')
      .replace(/<dialog[\s\S]*?<\/dialog>/gi, '')
      /**
       * Los contadores que suben solos, ya subidos.
       *
       * El sitio escribe `<span data-count="4" …>0</span>` y un script lo anima
       * de 0 a 4 cuando entra en pantalla. Ese script no está acá, así que el
       * número se quedaba en **0**: el documento decía «0 Templos» de una
       * iglesia que tiene cuatro. En papel eso no se lee como una animación que
       * no corrió; se lee como un dato, y encima falso.
       */
      .replace(
        /(<(\w+)[^>]*\sdata-count="([^"]*)"[^>]*>)[\s\S]*?(<\/\2>)/gi,
        (_todo, apertura, _etiqueta, valor, cierre) => `${apertura}${valor}${cierre}`,
      ),
    hojas,
  };
}

const assets = await archivos();

/**
 * Trae una página, por el camino que haga falta.
 *
 * Primero por la binding, que es instantánea y no pasa por Access. Pero no todas
 * las páginas son archivos: `/contacto` se arma al servir, porque tiene
 * formulario y enseña el resultado del envío. Esas no están en la binding, y
 * hay que pedirlas por HTTP.
 *
 * Y ahí aparece el problema: el sitio está detrás de Cloudflare Access, así que
 * una petición del Worker a su propio dominio vuelve a entrar por la puerta
 * principal y se topa con el login. **La cookie de quien está leyendo esta
 * página sirve para eso**: ya pasó por Access, así que se reenvía y la
 * subpetición entra igual que entró la persona.
 */
async function traer(ruta: string): Promise<Extraido | null> {
  const destino = new URL(ruta, Astro.url);

  if (assets) {
    try {
      const res = await assets.fetch(new Request(destino));
      if (res.ok) {
        const extraido = contenidoDe(await res.text());
        if (extraido) return extraido;
      }
    } catch {
      /* no era un archivo; se intenta por HTTP */
    }
  }

  try {
    const cookie = Astro.request.headers.get('cookie');
    const res = await fetch(destino, { headers: cookie ? { cookie } : {} });
    return res.ok ? contenidoDe(await res.text()) : null;
  } catch {
    return null;
  }
}

const secciones = await Promise.all(
  PAGINAS.map(async (p) => ({ ...p, contenido: await traer(p.ruta) })),
);

// Todas las hojas de estilo que usa cualquiera de las páginas, sin repetir y en
// el orden en que aparecieron. Casi todas comparten la misma, pero las que
// tienen estilos propios traen la suya y sin ella esa página sale en bruto.
const hojas = [...new Set(secciones.flatMap((s) => s.contenido?.hojas ?? []))];

const hoy = new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(new Date());
const fallidas = secciones.filter((s) => !s.contenido).length;
---

<!doctype html>
<html lang="es" data-theme="church">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Que esto no llegue nunca a un buscador: es el sitio entero duplicado. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{SITE.name} · textos para revisar</title>

    {
      /* Las hojas de estilo de las páginas que se juntaron. Sin esto, el
        contenido son clases de Tailwind sin significado y el navegador lo apila
        en bruto: imágenes a tamaño original y textos unos encima de otros. */
    }
    {hojas.map((h) => <link rel="stylesheet" href={h} />)}
  </head>
  <body class="bg-white text-black">
    {/* ── Instrucciones. En pantalla sí; en papel, no. ────────────────────── */}
    <div data-no-print class="mx-auto max-w-3xl px-6 py-10">
      <h1 class="font-display text-3xl">Textos del sitio, para revisar en papel</h1>
      <p class="mt-3 text-base-content/75">
        Esta página junta {secciones.length} páginas del sitio en un solo documento, en el orden en que
        se recorren. No es una copia: se lee del sitio de verdad cada vez que se abre, así que siempre
        muestra lo que hay publicado hoy.
      </p>

      <div class="panel mt-6 p-5">
        <p class="font-semibold">Para llevarlo a papel o a PDF</p>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm text-base-content/75">
          <li>Pulsa <kbd class="kbd kbd-sm">Ctrl</kbd> + <kbd class="kbd kbd-sm">P</kbd>.</li>
          <li>
            En «Destino», elige la impresora, o <strong>Guardar como PDF</strong> si prefieres mandarlo
            por correo.
          </li>
          <li>Deja los márgenes como vienen: ya están ajustados a hoja carta.</li>
        </ol>
      </div>

      {
        /* El manejador va en un <script> aparte y no en un `onclick`: la CSP de
          este sitio usa hashes, y con hashes el navegador bloquea los atributos
          de evento en línea. El botón se habría quedado mudo, sin decir nada. */
      }
      <button id="imprimir" class="btn btn-primary mt-5">Imprimir ahora</button>

      {
        /* Sin `text-warning-content`: ese color va SOBRE un warning sólido, y
           sobre este fondo al 10 % salía blanco sobre crema, ilegible. */
        fallidas > 0 && (
          <p class="mt-5 rounded border border-warning/40 bg-warning/10 px-4 py-3 text-sm">
            No se pudieron leer {fallidas} de las {secciones.length} páginas. Las que faltan
            aparecen señaladas abajo; el resto se imprime igual.
          </p>
        )
      }

      {
        !assets && (
          <p class="mt-5 rounded bg-error/10 px-4 py-3 text-sm">
            Esto solo funciona con el sitio compilado. En desarrollo (<code>npm run dev</code>) no
            hay archivos que leer: compila con <code>npm run build</code> y sirve con{' '}
            <code>npx wrangler dev</code>.
          </p>
        )
      }
    </div>

    {/* ── Portada del documento, solo en papel ────────────────────────────── */}
    <div class="hoja-portada hidden print:block">
      <h1 class="font-display text-4xl">{SITE.name}</h1>
      <p class="mt-2 text-lg">Textos del sitio web</p>
      <p class="mt-8 text-sm">Impreso el {hoy}</p>
      <p class="mt-10 max-w-md text-sm leading-relaxed">
        Estas son las palabras que aparecen hoy en el sitio. Cada página va en su propia hoja y
        numerada. Puedes escribir encima: lo que corrijas se traslada tal cual.
      </p>
    </div>

    {
      secciones.map((s, i) => (
        <section class="pagina">
          <header class="encabezado">
            <span class="numero">{i + 1}</span>
            <span class="titulo">{s.titulo}</span>
            <span class="ruta">{s.ruta}</span>
          </header>
          {s.contenido ? (
            <div set:html={s.contenido.html} />
          ) : (
            <p class="aviso-fallo">
              Esta página no se pudo leer desde acá. Ábrela en <strong>{s.ruta}</strong> e imprímela
              aparte.
            </p>
          )}
        </section>
      ))
    }

    <script>
      document.getElementById('imprimir')?.addEventListener('click', () => window.print());
    </script>

    <style is:global>
      /* Lo específico de este documento. Lo general —colores, saltos de página,
         qué se esconde— está en el bloque `@media print` de global.css. */
      /**
       * A todo el ancho, NO en una columna estrecha.
       *
       * El primer intento las metía en 46rem «para que se leyera cómodo», y era
       * un error: el sitio está maquetado para pantallas anchas, con rejillas de
       * dos y tres columnas. Al estrecharlo, las tarjetas se apilaban, los
       * títulos se partían en cuatro líneas y las fotos salían recortadas. Lo
       * que había que revisar era cómo se ve el sitio, y así no se veía como el
       * sitio.
       */
      .pagina {
        padding: 0 0 3rem;
      }

      /**
       * Los heros llevan `-mt-16` para meterse DEBAJO del navbar fijo. Acá no
       * hay navbar, así que ese margen negativo se comía el encabezado con el
       * número y el nombre de la sección: la referencia justo que sirve para
       * decir «página 3, tercer párrafo».
       */
      .pagina > :first-child + * [class*='-mt-16'],
      .pagina [class*='-mt-16'] {
        margin-top: 0 !important;
      }

      .encabezado {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        border-bottom: 2px solid #0a1730;
        padding: 0 1.5rem 0.4rem;
        margin-bottom: 1.5rem;
      }
      .encabezado .numero {
        font-weight: 700;
        font-size: 1.5rem;
        color: #0a1730;
      }
      .encabezado .titulo {
        font-weight: 600;
        font-size: 1.1rem;
      }
      .encabezado .ruta {
        margin-left: auto;
        font-size: 0.8rem;
        color: #666;
      }

      .aviso-fallo {
        border: 1px dashed #999;
        padding: 1rem;
        color: #666;
      }

      /**
       * Lo que el sitio anima al aparecer, acá se queda quieto y visible.
       *
       * `[data-reveal]` arranca en `opacity: 0` y lo enciende un script al
       * entrar en pantalla. Ese script no está: se quita a propósito al pegar
       * el contenido de una página dentro de otra. Sin esta regla, ocho bloques
       * de texto salen INVISIBLES —en pantalla y en papel— y parece que
       * faltaran, no que estén escondidos.
       *
       * En global.css hay una regla igual, pero solo dentro de `@media print`.
       * Acá hace falta también en pantalla, porque esta página se mira antes de
       * imprimirla.
       */
      [data-reveal] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }

      @media print {
        /* Cada página del sitio, en su propia hoja: así se reparten por tema
           encima de la mesa, que es como se revisa un texto de verdad. */
        .pagina {
          break-before: page;
          page-break-before: always;
          padding: 0;
          max-width: none;
        }
        .pagina:first-of-type {
          break-before: avoid;
          page-break-before: avoid;
        }

        .hoja-portada {
          break-after: page;
          page-break-after: always;
        }

        /* El encabezado se repite arriba de cada hoja de esa sección: con
           veinte hojas sueltas en la mesa, saber de cuál es cada una deja de
           ser un detalle. */
        .encabezado {
          position: running(cabecera);
        }
      }
    </style>
  </body>
</html>
