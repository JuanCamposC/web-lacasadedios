---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../../assets/images';
import type { NewsItem } from '../../lib/supabase';

const supabase = Astro.locals.supabase;
let news: NewsItem[] = [];
if (supabase) {
  const { data } = await supabase
    .from('news')
    .select('*')
    .eq('published', true)
    .order('published_at', { ascending: false });
  news = data ?? [];
}

const fmtDate = (d: string) => new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(new Date(d));
---

<Layout title="Noticias · La Casa de Dios" description="Últimas noticias y novedades de La Casa de Dios.">
  <PageHero image={IMG.comunidad} alt="Nuestra comunidad" eyebrow="Novedades" title="Noticias" subtitle="Mantente al día con lo que Dios está haciendo en nuestra comunidad." height="min-h-[50vh]" />

  <section class="bg-base-100 px-4 py-20">
    <div class="container mx-auto max-w-6xl">
      {news.length === 0 && (
        <div class="py-16 text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-base-200 text-base-content/40">
            <Icon name="lucide:newspaper" class="h-8 w-8" />
          </div>
          <p class="text-lg text-base-content/70">Aún no hay noticias publicadas. ¡Vuelve pronto!</p>
        </div>
      )}

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {news.map((n, i) => (
          <Reveal delay={(i % 3) * 80}>
            <article class="group h-full overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
              <div class="relative h-44 overflow-hidden">
                {n.image_url ? (
                  <img src={n.image_url} alt={n.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent/20 to-primary/20 text-accent/40">
                    <Icon name="lucide:newspaper" class="h-12 w-12" />
                  </div>
                )}
              </div>
              <div class="p-6">
                <div class="flex items-center gap-1.5 text-xs text-base-content/60">
                  <Icon name="lucide:calendar" class="h-3.5 w-3.5" /> {fmtDate(n.published_at)}
                </div>
                <h2 class="card-title mt-1 text-xl">{n.title}</h2>
                {n.excerpt && <p class="mt-2 text-sm text-base-content/75">{n.excerpt}</p>}
                {n.body && !n.excerpt && <p class="mt-2 line-clamp-4 text-sm text-base-content/75">{n.body}</p>}
              </div>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </section>
</Layout>
