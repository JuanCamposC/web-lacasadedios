---
export const prerender = false;

// La página se arma en cada petición, pero su contenido cambia como mucho unas
// veces al mes. Se deja que la CDN de Cloudflare la sirva ya hecha durante un
// minuto y que siga sirviéndola hasta diez minutos más mientras la rehace por
// detrás: durante una transmisión, cien visitas seguidas son una sola consulta
// a la base en vez de cien.
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Reveal from '../../components/Reveal.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../../assets/images';
import { renderMarkdown, markdownAResumen } from '../../lib/markdown';
import { baseDeDatos } from '../../lib/base';
import { noticiaPorSlug, noticiaPorId, noticiasPublicadas, ajustes } from '../../lib/datos';
import { urlMedio } from '../../lib/medios';
import { fechaLarga } from '../../lib/hora';

const { slug } = Astro.params;
const base = await baseDeDatos();

// El slug es opcional en la base, así que la dirección puede traer un slug o un
// id. Se distinguen por la forma: los ids son UUID.
const esUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(slug ?? '');

const fila = slug
  ? esUuid
    ? await noticiaPorId(base, slug)
    : await noticiaPorSlug(base, slug)
  : null;

if (!fila) return Astro.redirect('/noticias', 302);

const item = { ...fila, imagen: urlMedio(fila.imagen_clave) };

// Se piden cuatro para poder descartar la actual y quedarse con tres, sin una
// segunda consulta ni un `where id <>` que complique el índice.
const otras = (await noticiasPublicadas(base, { limite: 4 }))
  .filter((n) => n.id !== item.id)
  .slice(0, 3)
  .map((n) => ({ ...n, imagen: urlMedio(n.imagen_clave) }));

const fmtDate = fechaLarga;

// El cuerpo se escribe en Markdown desde el panel y se convierte a HTML aquí,
// en el servidor: el visitante no descarga ninguna librería para leerlo. El
// texto se escapa antes de interpretarlo (ver src/lib/markdown.ts).
const cuerpoHtml = renderMarkdown(item.cuerpo);

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

/**
 * Texto del botón de WhatsApp, editable desde la tabla `ajustes`.
 *
 * Facebook NO admite mensaje propio: retiró el parámetro `quote` hace años y
 * arma la vista previa con las etiquetas Open Graph de la página, o sea con el
 * «Resumen breve» de cada noticia. Por eso esta plantilla solo afecta a
 * WhatsApp, que es el único de los dos que acepta texto.
 */
const PLANTILLA_POR_DEFECTO =
  'Hola, acabo de leer esta noticia que me bendijo. {titulo} — {enlace}';

const config = await ajustes(base);
const plantilla = config?.compartir_whatsapp || PLANTILLA_POR_DEFECTO;

const textoWhatsapp = plantilla
  .replaceAll('{titulo}', item.titulo)
  .replaceAll('{enlace}', canonical);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: item.titulo,
  datePublished: item.publicado_en,
  description: item.bajada ?? undefined,
  image: item.imagen ?? undefined,
  mainEntityOfPage: canonical,
  publisher: { '@type': 'Organization', name: 'La Casa de Dios' },
};
import { jsonLd as comoJsonLd } from '../../lib/jsonld';
---

<Layout
  title={`${item.titulo} · La Casa de Dios`}
  description={item.bajada ?? markdownAResumen(item.cuerpo)}
  image={item.imagen ?? undefined}
>
  <script type="application/ld+json" set:html={comoJsonLd(jsonLd)} is:inline />

  <!-- Cabecera del artículo -->
  <header class="relative overflow-hidden bg-base-200 pt-16">
    {
      item.imagen && (
        <>
          <img
            src={item.imagen}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover opacity-20"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-base-200/80 to-base-200" />
        </>
      )
    }
    <div class="wrap-narrow relative px-4 py-14 md:py-20">
      <a
        href="/noticias"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" /> Volver a noticias
      </a>
      {
        /* `block` a propósito: .eyebrow es inline-block y se pegaba al enlace
          de volver, encimándose con él. */
      }
      <p class="eyebrow mt-6 block text-accent">Noticias</p>
      <h1 class="mt-2 font-display leading-[1.1] text-[clamp(2rem,5.5vw,3.25rem)]">
        {item.titulo}
      </h1>
      <p class="mt-4 flex items-center gap-2 text-sm text-base-content/60">
        <Icon name="lucide:calendar" class="h-4 w-4" />
        <time datetime={item.publicado_en}>{fmtDate(item.publicado_en)}</time>
      </p>
    </div>
  </header>

  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Noticias', href: '/noticias' },
      { label: item.titulo },
    ]}
  />

  <!-- Cuerpo -->
  <article class="section bg-base-100">
    <div class="wrap-narrow">
      {
        item.imagen && (
          /* El hueco se reserva ANTES de que llegue la foto.

             De la base sale una clave de R2, no el tamaño de la imagen, así que
             el navegador no sabía cuánto alto reservar: la foto entraba de
             golpe y empujaba el texto hacia abajo justo cuando se empezaba a
             leer. Con una proporción fija, el sitio ya está hecho. */
          <Reveal class="mb-10 block aspect-[16/9] overflow-hidden rounded-xl bg-base-200">
            <img
              src={item.imagen}
              alt={item.titulo}
              class="h-full w-full object-cover"
              loading="eager"
            />
          </Reveal>
        )
      }

      {
        item.bajada && (
          <p
            data-reveal
            class="mb-8 border-l-4 border-accent pl-5 text-xl font-light leading-relaxed text-base-content/85"
          >
            {item.bajada}
          </p>
        )
      }

      {
        cuerpoHtml ? (
          <div data-reveal data-reveal-delay="60" class="prose-lcd" set:html={cuerpoHtml} />
        ) : (
          !item.bajada && (
            <p class="prose-lcd italic opacity-60">Esta noticia todavía no tiene contenido.</p>
          )
        )
      }

      <!-- Compartir -->
      <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-base-300 pt-8">
        <span class="text-sm font-medium text-base-content/60">Compartir:</span>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(textoWhatsapp)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost gap-1.5"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" /> WhatsApp
        </a>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost gap-1.5"
        >
          <Icon name="lucide:share-2" class="h-4 w-4" /> Facebook
        </a>
        <button
          type="button"
          id="copiar-enlace"
          data-url={canonical}
          class="btn btn-sm btn-ghost gap-1.5"
        >
          <Icon name="lucide:link" class="h-4 w-4" />
          <span data-label>Copiar enlace</span>
        </button>
      </div>
    </div>
  </article>

  <!-- Otras noticias -->
  {
    otras.length > 0 && (
      <section class="section bg-base-200">
        <div class="wrap">
          <h2 class="font-display text-2xl">Sigue leyendo</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {otras.map((n, i) => (
              <Reveal delay={(i % 3) * 80} class="h-full">
                <a
                  href={`/noticias/${n.slug ?? n.id}`}
                  class="panel panel-sm panel-lift group flex h-full flex-col overflow-hidden"
                >
                  <div class="h-36 overflow-hidden bg-base-300">
                    {n.imagen ? (
                      <img
                        src={n.imagen}
                        alt=""
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent/20 to-primary/20 text-accent/40">
                        <Icon name="lucide:newspaper" class="h-10 w-10" />
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <span class="text-xs text-base-content/55">{fmtDate(n.publicado_en)}</span>
                    <h3 class="mt-1 font-bold leading-snug clamp-3">{n.titulo}</h3>
                  </div>
                </a>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    title="No te pierdas nada"
    text="Suscríbete al boletín en el pie de página y te avisamos cuando publiquemos algo nuevo."
    image={IMG.comunidad}
    compact
  >
    <a href="/noticias" class="btn btn-primary gap-2">
      <Icon name="lucide:newspaper" class="h-5 w-5" /> Todas las noticias
    </a>
  </CtaBand>
</Layout>

<script>
  function initCompartir() {
    const btn = document.getElementById('copiar-enlace') as HTMLElement | null;
    if (!btn || btn.dataset.listo) return;
    btn.dataset.listo = '1';

    const label = btn.querySelector('[data-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        const antes = label.textContent;
        label.textContent = '¡Copiado!';
        setTimeout(() => (label.textContent = antes), 1800);
      } catch {
        /* el navegador bloqueó el portapapeles: se ignora */
      }
    });
  }

  document.addEventListener('astro:page-load', initCompartir);
</script>
