---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Reveal from '../../components/Reveal.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../../assets/images';
import { renderMarkdown, markdownAResumen } from '../../lib/markdown';
import type { NewsItem } from '../../lib/supabase';

const { slug } = Astro.params;
const supabase = Astro.locals.supabase;

let item: NewsItem | null = null;
let otras: NewsItem[] = [];

// El slug es opcional en la base. Si el parámetro tiene forma de UUID se busca
// por id; si no, por slug. (Consultar `id` con un valor no-UUID hace fallar la
// consulta completa en Postgres, no devuelve vacío.)
const esUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(slug ?? '');

if (supabase && slug) {
  const { data } = await supabase
    .from('news')
    .select('*')
    .eq('published', true)
    .eq(esUuid ? 'id' : 'slug', slug)
    .maybeSingle();
  item = (data as NewsItem) ?? null;

  if (item) {
    const { data: resto } = await supabase
      .from('news')
      .select('*')
      .eq('published', true)
      .neq('id', item.id)
      .order('published_at', { ascending: false })
      .limit(3);
    otras = (resto as NewsItem[]) ?? [];
  }
}

if (!item) return Astro.redirect('/noticias', 302);

const fmtDate = (d: string) =>
  new Intl.DateTimeFormat('es-CL', { dateStyle: 'long' }).format(new Date(d));

// El cuerpo se escribe en Markdown desde el panel y se convierte a HTML aquí,
// en el servidor: el visitante no descarga ninguna librería para leerlo. El
// texto se escapa antes de interpretarlo (ver src/lib/markdown.ts).
const cuerpoHtml = renderMarkdown(item.body);

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: item.title,
  datePublished: item.published_at,
  description: item.excerpt ?? undefined,
  image: item.image_url ?? undefined,
  mainEntityOfPage: canonical,
  publisher: { '@type': 'Organization', name: 'La Casa de Dios' },
};
---

<Layout
  title={`${item.title} · La Casa de Dios`}
  description={item.excerpt ?? markdownAResumen(item.body)}
  image={item.image_url ?? undefined}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <!-- Cabecera del artículo -->
  <header class="relative overflow-hidden bg-base-200 pt-16">
    {
      item.image_url && (
        <>
          <img
            src={item.image_url}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 h-full w-full object-cover opacity-20"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-base-200/80 to-base-200" />
        </>
      )
    }
    <div class="wrap-narrow relative px-4 py-14 md:py-20">
      <a
        href="/noticias"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent"
      >
        <Icon name="lucide:arrow-left" class="h-4 w-4" /> Volver a noticias
      </a>
      {
        /* `block` a propósito: .eyebrow es inline-block y se pegaba al enlace
          de volver, encimándose con él. */
      }
      <p class="eyebrow mt-6 block text-accent">Noticias</p>
      <h1 class="mt-2 font-display leading-[1.1] text-[clamp(2rem,5.5vw,3.25rem)]">
        {item.title}
      </h1>
      <p class="mt-4 flex items-center gap-2 text-sm text-base-content/60">
        <Icon name="lucide:calendar" class="h-4 w-4" />
        <time datetime={item.published_at}>{fmtDate(item.published_at)}</time>
      </p>
    </div>
  </header>

  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Noticias', href: '/noticias' },
      { label: item.title },
    ]}
  />

  <!-- Cuerpo -->
  <article class="section bg-base-100">
    <div class="wrap-narrow">
      {
        item.image_url && (
          <Reveal class="mb-10 block overflow-hidden rounded-xl">
            <img
              src={item.image_url}
              alt={item.title}
              class="w-full object-cover"
              loading="eager"
            />
          </Reveal>
        )
      }

      {
        item.excerpt && (
          <p
            data-reveal
            class="mb-8 border-l-4 border-accent pl-5 text-xl font-light leading-relaxed text-base-content/85"
          >
            {item.excerpt}
          </p>
        )
      }

      {
        cuerpoHtml ? (
          <div data-reveal data-reveal-delay="60" class="prose-lcd" set:html={cuerpoHtml} />
        ) : (
          !item.excerpt && (
            <p class="prose-lcd italic opacity-60">Esta noticia todavía no tiene contenido.</p>
          )
        )
      }

      <!-- Compartir -->
      <div class="mt-12 flex flex-wrap items-center gap-3 border-t border-base-300 pt-8">
        <span class="text-sm font-medium text-base-content/60">Compartir:</span>
        <a
          href={`https://wa.me/?text=${encodeURIComponent(item.title + ' — ' + canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost gap-1.5"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" /> WhatsApp
        </a>
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-sm btn-ghost gap-1.5"
        >
          <Icon name="lucide:share-2" class="h-4 w-4" /> Facebook
        </a>
        <button
          type="button"
          id="copiar-enlace"
          data-url={canonical}
          class="btn btn-sm btn-ghost gap-1.5"
        >
          <Icon name="lucide:link" class="h-4 w-4" />
          <span data-label>Copiar enlace</span>
        </button>
      </div>
    </div>
  </article>

  <!-- Otras noticias -->
  {
    otras.length > 0 && (
      <section class="section bg-base-200">
        <div class="wrap">
          <h2 class="font-display text-2xl">Sigue leyendo</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-3">
            {otras.map((n, i) => (
              <Reveal delay={(i % 3) * 80} class="h-full">
                <a
                  href={`/noticias/${n.slug ?? n.id}`}
                  class="panel panel-sm panel-lift group flex h-full flex-col overflow-hidden"
                >
                  <div class="h-36 overflow-hidden bg-base-300">
                    {n.image_url ? (
                      <img
                        src={n.image_url}
                        alt=""
                        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent/20 to-primary/20 text-accent/40">
                        <Icon name="lucide:newspaper" class="h-10 w-10" />
                      </div>
                    )}
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <span class="text-xs text-base-content/55">{fmtDate(n.published_at)}</span>
                    <h3 class="mt-1 font-bold leading-snug clamp-3">{n.title}</h3>
                  </div>
                </a>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    title="No te pierdas nada"
    text="Suscríbete al boletín en el pie de página y te avisamos cuando publiquemos algo nuevo."
    image={IMG.comunidad}
    compact
  >
    <a href="/noticias" class="btn btn-primary gap-2">
      <Icon name="lucide:newspaper" class="h-5 w-5" /> Todas las noticias
    </a>
  </CtaBand>
</Layout>

<script>
  function initCompartir() {
    const btn = document.getElementById('copiar-enlace') as HTMLElement | null;
    if (!btn || btn.dataset.listo) return;
    btn.dataset.listo = '1';

    const label = btn.querySelector('[data-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.url ?? location.href);
        const antes = label.textContent;
        label.textContent = '¡Copiado!';
        setTimeout(() => (label.textContent = antes), 1800);
      } catch {
        /* el navegador bloqueó el portapapeles: se ignora */
      }
    });
  }

  document.addEventListener('astro:page-load', initCompartir);
</script>
