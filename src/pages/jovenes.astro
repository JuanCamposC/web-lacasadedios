---
/**
 * Los enlaces de los jóvenes: lo que antes era su Linktree.
 *
 * La lista sale de la tabla `enlaces` y se edita en /admin/jovenes, porque
 * cambia con cada evento. El icono de cada botón se deduce de la dirección
 * (ver src/lib/enlaces.ts).
 *
 * PENDIENTE: el logo de los jóvenes. Mientras no exista, arriba va un círculo
 * con las iniciales. Cuando llegue, se guarda en public/marca/ y se cambia el
 * círculo por la imagen; es lo único de esta página que no se toca desde el
 * panel.
 */
export const prerender = false;
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import { Icon } from 'astro-icon/components';
import EnlacesLayout from '../layouts/EnlacesLayout.astro';
import { baseDeDatos } from '../lib/base';
import { enlacesPublicados, type Enlace } from '../lib/datos';
import { plataformaDe, esEnlaceSeguro } from '../lib/enlaces';

let enlaces: Enlace[] = [];
try {
  enlaces = (await enlacesPublicados(await baseDeDatos())).filter((e) => esEnlaceSeguro(e.url));
} catch (e) {
  console.error('[jovenes]', e);
}

const botones = enlaces.map((e) => ({ ...e, plataforma: plataformaDe(e.url) }));
---

<EnlacesLayout
  title="Jóvenes Casa de Dios"
  description="Playlists, redes y todo lo de los jóvenes de La Casa de Dios."
  tema="jovenes"
>
  {
    /* Burbujas de luz detrás del contenido. Solo decoran: sin ellas la página
      se lee igual, y no reciben toques. */
  }
  <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
    <span
      class="absolute -right-16 top-4 h-48 w-48 sm:right-[calc(50%-18rem)] rounded-full bg-[#d4a72c]/35 blur-3xl"
    ></span>
    <span
      class="absolute -left-20 top-56 h-56 w-56 sm:left-[calc(50%-20rem)] rounded-full bg-[#4ca68d]/45 blur-3xl"
    ></span>
  </div>

  <div class="relative">
    <header class="text-center">
      <div
        class="mx-auto grid h-[clamp(5rem,24vw,6rem)] w-[clamp(5rem,24vw,6rem)] rotate-[-6deg] place-items-center rounded-[1.75rem] bg-white shadow-xl shadow-[#2f4156]/40"
        aria-hidden="true"
      >
        <span
          class="bg-gradient-to-br from-[#4ca68d] via-[#4c6fa6] to-[#7e4ca6] bg-clip-text font-display text-[clamp(1.6rem,8vw,2rem)] font-bold text-transparent"
        >
          JCD
        </span>
      </div>
      <h1 class="e-titulo mt-5 text-white drop-shadow-[0_2px_10px_rgba(47,65,86,0.5)]">
        Jóvenes Casa de Dios
      </h1>
    </header>

    {
      botones.length > 0 ? (
        <ul class="mt-7 flex flex-col gap-3">
          {botones.map((b) => (
            <li>
              <a
                href={b.url}
                target="_blank"
                rel="noopener noreferrer"
                class="enlace-boton"
                style={`--acento:${b.plataforma.color}`}
              >
                <span class="enlace-icono">
                  <Icon name={b.plataforma.icono} class="h-5 w-5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="enlace-nombre">{b.titulo}</span>
                  {b.plataforma.nombre && (
                    <span class="e-suave block text-sm">{b.plataforma.nombre}</span>
                  )}
                </span>
                <Icon name="lucide:arrow-up-right" class="enlace-flecha" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-10 text-center font-medium text-white">Pronto habrá enlaces por aquí.</p>
      )
    }

    {
      /* Fijo y no desde el panel: la web no cambia con cada evento, y así no
        se puede borrar por descuido junto con una playlist vieja. */
    }
    <a href="/" class="enlace-boton mt-3" style="--acento:#2f4156">
      <span class="enlace-icono"><Icon name="lucide:globe" class="h-5 w-5" /></span>
      <span class="min-w-0 flex-1">
        <span class="enlace-nombre">Iglesia La Casa de Dios</span>
        <span class="e-suave block text-sm">lacasadedios.cl</span>
      </span>
      <Icon name="lucide:chevron-right" class="enlace-flecha" aria-hidden="true" />
    </a>
  </div>
</EnlacesLayout>
