---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout
  title="Eventos"
  description="Cultos especiales, encuentros y actividades con fecha."
  active="eventos"
>
  <div id="crud-root"></div>

  <script>
    import { setupCrud } from '../../scripts/adminCrud';
    import { etiquetas } from '../../data/etiquetas';
    setupCrud({
      table: 'eventos',
      singular: 'evento',
      titleField: 'titulo',
      subtitleField: 'lugar',
      orderBy: { column: 'fecha', ascending: false },
      notify: { type: 'evento', urlBase: '/eventos' },
      fields: [
        { name: 'titulo', label: 'Título', type: 'text', required: true },
        { name: 'fecha', label: 'Fecha y hora', type: 'datetime-local', required: true },
        { name: 'lugar', label: 'Lugar', type: 'text' },
        { name: 'descripcion', label: 'Descripción', type: 'textarea' },
        { name: 'imagen_clave', label: 'Imagen (opcional)', type: 'image' },
        {
          name: 'templo',
          label: 'Templo',
          type: 'select',
          required: true,
          options: etiquetas,
          help: 'A qué templo pertenece. «General» si vale para todos.',
        },
        { name: 'publicado', label: 'Publicado', type: 'checkbox' },
      ],
    });
  </script>
</AdminLayout>
