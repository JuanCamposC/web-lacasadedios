---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

const supabase = Astro.locals.supabase;
if (!supabase) return Astro.redirect('/admin/login');

const { data } = await supabase
  .from('subscribers')
  .select('*')
  .order('created_at', { ascending: false });
const subs = data ?? [];
const emails = subs.map((s: any) => s.email).join(', ');
const fmt = (d: string) =>
  new Intl.DateTimeFormat('es-CL', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(d));
---

<AdminLayout
  title="Suscriptores"
  description="Quiénes reciben el boletín cuando publicas algo."
  active="suscriptores"
>
  {
    subs.length > 0 && (
      <button
        slot="acciones"
        id="copy-emails"
        data-emails={emails}
        class="btn btn-outline btn-sm gap-2"
      >
        <Icon name="lucide:copy" class="h-4 w-4" />
        <span class="hidden sm:inline">Copiar correos</span>
      </button>
    )
  }

  <div class="max-w-3xl">
    <div class="panel mb-4 flex items-center gap-4 p-5">
      <span class="tile tile-lg">
        <Icon name="lucide:mail" class="h-6 w-6" />
      </span>
      <div>
        <p class="font-data text-3xl font-bold leading-none text-primary">{subs.length}</p>
        <p class="mt-1 text-sm text-base-content/60">
          {subs.length === 1 ? 'persona suscrita' : 'personas suscritas'} · se dan de alta desde el pie
          del sitio
        </p>
      </div>
    </div>

    {
      subs.length === 0 ? (
        <div class="panel p-10 text-center">
          <span class="tile tile-lg tile-muted mx-auto mb-4">
            <Icon name="lucide:mail" class="h-6 w-6" />
          </span>
          <p class="text-sm text-base-content/60">
            Todavía no hay suscriptores. El formulario está en el pie del sitio público.
          </p>
        </div>
      ) : (
        <div class="panel overflow-hidden">
          <table class="table">
            <thead>
              <tr>
                <>
                  <th>Correo</th>
                  <th class="text-right">Se suscribió</th>
                </>
              </tr>
            </thead>
            <tbody>
              {subs.map((s: any) => (
                <tr>
                  <td class="font-medium">{s.email}</td>
                  <td class="font-data text-right text-sm text-base-content/55">
                    {fmt(s.created_at)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  <script>
    const btn = document.getElementById('copy-emails');
    btn?.addEventListener('click', async () => {
      const emails = (btn as HTMLElement).dataset.emails || '';
      try {
        await navigator.clipboard.writeText(emails);
        btn.textContent = '¡Copiado!';
        setTimeout(() => location.reload(), 1200);
      } catch {
        alert(emails);
      }
    });
  </script>
</AdminLayout>
