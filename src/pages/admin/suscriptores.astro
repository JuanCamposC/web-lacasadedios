---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

const supabase = Astro.locals.supabase;
if (!supabase) return Astro.redirect('/admin/login');

const { data } = await supabase
  .from('subscribers')
  .select('*')
  .order('created_at', { ascending: false });
const subs = data ?? [];
const emails = subs.map((s: any) => s.email).join(', ');
const fmt = (d: string) => new Intl.DateTimeFormat('es-CL', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(d));
---

<AdminLayout title="Suscriptores" active="suscriptores">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold">Suscriptores</h1>
      <p class="mt-1 opacity-70">{subs.length} {subs.length === 1 ? 'persona suscrita' : 'personas suscritas'} al newsletter.</p>
    </div>
    {subs.length > 0 && (
      <button id="copy-emails" data-emails={emails} class="btn btn-outline btn-sm gap-2">
        <Icon name="lucide:copy" class="h-4 w-4" /> Copiar correos
      </button>
    )}
  </div>

  {subs.length === 0 ? (
    <div class="rounded-2xl border border-dashed border-base-300 p-10 text-center">
      <div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-base-200 text-base-content/40">
        <Icon name="lucide:mail" class="h-7 w-7" />
      </div>
      <p class="opacity-70">Aún no hay suscriptores. El formulario está en el pie del sitio.</p>
    </div>
  ) : (
    <div class="overflow-hidden rounded-2xl border border-base-300 bg-base-100">
      <table class="table">
        <thead>
          <tr><th>Correo</th><th class="text-right">Fecha</th></tr>
        </thead>
        <tbody>
          {subs.map((s: any) => (
            <tr>
              <td class="font-medium">{s.email}</td>
              <td class="text-right text-sm opacity-60">{fmt(s.created_at)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <script>
    const btn = document.getElementById('copy-emails');
    btn?.addEventListener('click', async () => {
      const emails = (btn as HTMLElement).dataset.emails || '';
      try {
        await navigator.clipboard.writeText(emails);
        btn.textContent = '¡Copiado!';
        setTimeout(() => location.reload(), 1200);
      } catch {
        alert(emails);
      }
    });
  </script>
</AdminLayout>
