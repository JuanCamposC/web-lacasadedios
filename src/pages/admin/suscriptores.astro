---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

import { baseDeDatos } from '../../lib/base';
// `pendientes` llega renombrada: esta página ya tiene una variable con ese
// nombre —cuántos hay sin confirmar— y son dos cosas distintas.
import {
  listarSuscriptores,
  pendientes as contarPendientes,
  DIAS_PARA_CONFIRMAR,
} from '../../lib/boletin';
import { fechaYHora } from '../../lib/hora';

const base = await baseDeDatos();
const subs = await listarSuscriptores(base);
// Cuántos no han confirmado y cuántos de ellos ya pasaron el plazo. Abrir esta
// pantalla NO borra nada: para eso está el botón. Ver /api/admin/suscriptores.
const sinConfirmar = await contarPendientes(base);

/** Días que le quedan a un alta pendiente antes de caducar. */
const diasQueQuedan = (creadoEn: string) =>
  DIAS_PARA_CONFIRMAR - Math.floor((Date.now() - new Date(creadoEn).getTime()) / 86_400_000);

// Solo se copian los confirmados. Quien está pendiente no dio permiso para que
// le escriban, y una lista que se copia al portapapeles termina pegada en el
// «Para:» de algún correo: mezclarlos sería regalar ese error.
const emails = subs
  .filter((s) => s.pendiente === 0)
  .map((s) => s.correo)
  .join(', ');

const confirmados = subs.filter((s) => s.pendiente === 0).length;
const pendientes = subs.length - confirmados;
const fmt = fechaYHora;
---

<AdminLayout
  title="Suscriptores"
  description="Quiénes reciben el boletín cuando publicas algo."
  active="suscriptores"
>
  <div slot="acciones" class="flex items-center gap-2">
    {
      /* Solo cuando hay algo que limpiar. Un botón que no haría nada enseña a
        no mirar los botones. */
      sinConfirmar.caducados > 0 && (
        <button id="limpiar-pendientes" class="btn btn-outline btn-sm gap-2 text-warning">
          <Icon name="lucide:eraser" class="h-4 w-4" />
          <span class="hidden sm:inline">Limpiar {sinConfirmar.caducados} sin confirmar</span>
          <span class="sm:hidden">Limpiar {sinConfirmar.caducados}</span>
        </button>
      )
    }
    {
      subs.length > 0 && (
        <button id="copy-emails" data-emails={emails} class="btn btn-outline btn-sm gap-2">
          <Icon name="lucide:copy" class="h-4 w-4" />
          <span class="hidden sm:inline">Copiar correos</span>
        </button>
      )
    }
  </div>

  <div class="max-w-3xl">
    <div class="panel mb-4 flex items-center gap-4 p-5">
      <span class="tile tile-lg">
        <Icon name="lucide:mail" class="h-6 w-6" />
      </span>
      <div>
        {
          /* El número grande es el de CONFIRMADOS, que son a quienes de verdad
            les llega el boletín. Contar también los pendientes daría una cifra
            más bonita y equivocada: al pulsar «avisar» saldrían menos correos
            de los que dice este número, y eso parece un fallo del envío. */
        }
        <p class="font-data text-3xl font-bold leading-none text-primary">{confirmados}</p>
        <p class="mt-1 text-sm text-base-content/70">
          {confirmados === 1 ? 'persona recibe el boletín' : 'personas reciben el boletín'} · se dan de
          alta desde el pie del sitio
          {
            pendientes > 0 && (
              <span class="mt-1 block text-warning">
                {pendientes === 1
                  ? 'Otra persona se apuntó y no ha confirmado todavía.'
                  : `Otras ${pendientes} se apuntaron y no han confirmado todavía.`}
                {' '}Las que no confirmen en {DIAS_PARA_CONFIRMAR} días se borran solas.
              </span>
            )
          }
        </p>
      </div>
    </div>

    {
      subs.length === 0 ? (
        <div class="panel p-10 text-center">
          <span class="tile tile-lg tile-muted mx-auto mb-4">
            <Icon name="lucide:mail" class="h-6 w-6" />
          </span>
          <p class="text-sm text-base-content/70">
            Todavía no hay suscriptores. El formulario está en el pie del sitio público.
          </p>
        </div>
      ) : (
        <div class="panel overflow-hidden">
          <table class="table">
            <thead>
              <tr>
                <>
                  <th>Correo</th>
                  <th>Estado</th>
                  <th class="text-right">Se suscribió</th>
                </>
              </tr>
            </thead>
            <tbody>
              {subs.map((s) => (
                <tr>
                  <td class="font-medium">{s.correo}</td>
                  {/* Los pendientes se enseñan a propósito: es la explicación de
                      la mitad de los «me suscribí y no me llega nada». A esos
                      NO se les escribe hasta que confirmen desde su bandeja. */}
                  <td>
                    {s.pendiente === 1 ? (
                      <>
                        <span class="badge badge-warning badge-sm">Sin confirmar</span>
                        {/* Cuánto le queda antes de borrarse sola. Sin esto, un
                            «sin confirmar» de hace dos meses y otro de ayer se
                            ven igual, y solo uno de los dos va a desaparecer. */}
                        <span class="mt-0.5 block text-xs text-base-content/70">
                          {diasQueQuedan(s.creado_en) > 0
                            ? `Se borra en ${diasQueQuedan(s.creado_en)} ${diasQueQuedan(s.creado_en) === 1 ? 'día' : 'días'}`
                            : 'Ya pasó el plazo'}
                        </span>
                      </>
                    ) : (
                      <span class="badge badge-success badge-sm">Confirmado</span>
                    )}
                  </td>
                  <td class="font-data text-right text-sm text-base-content/70">
                    {fmt(s.creado_en)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  <script>
    import { api } from '../../scripts/admin/api';
    import { toast } from '../../scripts/admin/ui';

    document.getElementById('limpiar-pendientes')?.addEventListener('click', async (e) => {
      const boton = e.currentTarget as HTMLButtonElement;
      boton.disabled = true;
      try {
        const r = await api.limpiarPendientes();
        toast(
          r.borrados === 1
            ? 'Se borró 1 alta que nunca se confirmó'
            : `Se borraron ${r.borrados} altas que nunca se confirmaron`,
        );
        setTimeout(() => location.reload(), 1200);
      } catch (err) {
        boton.disabled = false;
        toast('No se pudo limpiar: ' + (err as Error).message, 'error');
      }
    });

    const btn = document.getElementById('copy-emails');
    btn?.addEventListener('click', async () => {
      const emails = (btn as HTMLElement).dataset.emails || '';
      try {
        await navigator.clipboard.writeText(emails);
        btn.textContent = '¡Copiado!';
        setTimeout(() => location.reload(), 1200);
      } catch {
        alert(emails);
      }
    });
  </script>
</AdminLayout>
