---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

import { baseDeDatos } from '../../lib/base';
import { ajustes as leerAjustes } from '../../lib/datos';
import { enChile } from '../../lib/hora';

const db = await baseDeDatos();

/**
 * Totales y publicados en UNA consulta por tabla, no en dos.
 *
 * Antes eran dos viajes por recurso —uno para el total y otro para los
 * publicados—, ocho en total. `sum(publicado)` los junta: SQLite cuenta las dos
 * cosas en la misma pasada. Con D1 en Norteamérica cada viaje se nota, y esta
 * es la primera pantalla que se ve al entrar al panel.
 */
const cuenta = (tabla: string) =>
  db
    .prepare(`select count(*) as total, sum(publicado) as publicados from ${tabla}`)
    .bind()
    .first<{ total: number; publicados: number | null }>();

const recientesDe = (tabla: string) =>
  db
    .prepare(
      `select id, titulo, creado_en, publicado from ${tabla} order by creado_en desc limit 4`,
    )
    .bind()
    .all<{ id: string; titulo: string; creado_en: string; publicado: number }>();

const [ev, nw, vd, subs, aj, evR, nwR, vdR] = await Promise.all([
  cuenta('eventos'),
  cuenta('noticias'),
  cuenta('videos'),
  db
    .prepare('select count(*) as total from suscriptores where pendiente = 0')
    .bind()
    .first<{ total: number }>(),
  leerAjustes(db),
  recientesDe('eventos'),
  recientesDe('noticias'),
  recientesDe('videos'),
]);

const enVivo = aj?.vivo_activo === 1;

const tarjetas = [
  {
    href: '/admin/eventos',
    label: 'Eventos',
    icon: 'lucide:calendar-days',
    total: ev?.total ?? 0,
    publicados: ev?.publicados ?? 0,
    tile: 'tile',
  },
  {
    href: '/admin/noticias',
    label: 'Noticias',
    icon: 'lucide:newspaper',
    total: nw?.total ?? 0,
    publicados: nw?.publicados ?? 0,
    tile: 'tile tile-accent',
  },
  {
    href: '/admin/videos',
    label: 'Videos',
    icon: 'lucide:youtube',
    total: vd?.total ?? 0,
    publicados: vd?.publicados ?? 0,
    tile: 'tile tile-secondary',
  },
  {
    href: '/admin/suscriptores',
    label: 'Suscriptores',
    icon: 'lucide:mail',
    total: subs?.total ?? 0,
    publicados: null,
    tile: 'tile tile-muted',
  },
];

const acciones = [
  { href: '/admin/eventos', label: 'Nuevo evento', icon: 'lucide:calendar-plus' },
  { href: '/admin/noticias', label: 'Nueva noticia', icon: 'lucide:file-plus-2' },
  { href: '/admin/videos', label: 'Nuevo video', icon: 'lucide:video' },
];

const TIPO = {
  eventos: { label: 'Evento', icon: 'lucide:calendar-days', href: '/admin/eventos' },
  noticias: { label: 'Noticia', icon: 'lucide:newspaper', href: '/admin/noticias' },
  videos: { label: 'Video', icon: 'lucide:youtube', href: '/admin/videos' },
} as const;

type Fila = { id: string; titulo: string; creado_en: string; publicado: number };
const actividad = [
  ...(evR.results as Fila[]).map((r) => ({ ...r, tipo: 'eventos' as const })),
  ...(nwR.results as Fila[]).map((r) => ({ ...r, tipo: 'noticias' as const })),
  ...(vdR.results as Fila[]).map((r) => ({ ...r, tipo: 'videos' as const })),
]
  .sort((a, b) => +new Date(b.creado_en) - +new Date(a.creado_en))
  .slice(0, 6);

const fecha = (d: string) => enChile(d, { day: '2-digit', month: 'short' });
---

<AdminLayout
  title="Inicio"
  description="Todo el contenido del sitio, en un solo lugar."
  active="inicio"
>
  <!-- Estado de la transmisión: lo primero, porque es lo único que cambia el
       sitio al instante y lo que más se consulta un domingo. -->
  <a
    href="/admin/en-vivo"
    data-reveal
    class={`panel panel-lift mb-6 flex items-center gap-4 p-5 ${enVivo ? 'border-error/45 bg-error/5' : ''}`}
  >
    <span class={enVivo ? 'tile tile-lg bg-error/15 text-error' : 'tile tile-lg tile-muted'}>
      <Icon name="lucide:radio" class="h-6 w-6" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="flex items-center gap-2">
        {
          enVivo && (
            <span
              class="pulse-dot inline-block h-2.5 w-2.5 rounded-full bg-error"
              aria-hidden="true"
            />
          )
        }
        <strong class={enVivo ? 'text-error' : ''}>
          {enVivo ? 'El sitio está mostrando una transmisión en vivo' : 'No hay transmisión activa'}
        </strong>
      </span>
      <span class="mt-0.5 block truncate text-sm text-base-content/60">
        {
          enVivo
            ? (aj?.vivo_titulo || 'Sin título') + ' — toca para cambiarla o apagarla'
            : 'Toca para activar la transmisión cuando empiece la reunión'
        }
      </span>
    </span>
    <Icon name="lucide:chevron-right" class="h-5 w-5 shrink-0 text-base-content/35" />
  </a>

  <!-- Cifras -->
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      tarjetas.map((c, i) => (
        <a href={c.href} data-reveal data-reveal-delay={i * 70} class="panel panel-lift group p-5">
          <div class="flex items-start justify-between">
            <span class={c.tile}>
              <Icon name={c.icon} class="h-5 w-5" />
            </span>
            <Icon
              name="lucide:arrow-up-right"
              class="h-4 w-4 text-base-content/25 transition group-hover:text-primary"
            />
          </div>
          <p class="mt-4 flex items-baseline gap-2">
            <span
              data-count={c.total}
              class="font-data text-4xl font-bold leading-none text-primary"
            >
              0
            </span>
            <span class="text-sm font-semibold">{c.label}</span>
          </p>
          <p class="mt-1.5 text-xs text-base-content/55">
            {c.publicados === null
              ? 'Personas suscritas al boletín'
              : `${c.publicados} publicado${c.publicados === 1 ? '' : 's'} · ${c.total - c.publicados} borrador${c.total - c.publicados === 1 ? '' : 'es'}`}
          </p>
        </a>
      ))
    }
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <!-- Actividad -->
    <section data-reveal class="panel p-5 lg:col-span-2">
      <h2 class="flex items-center gap-2 text-base font-bold">
        <Icon name="lucide:history" class="h-4 w-4 text-accent" /> Lo último que se cargó
      </h2>

      {
        actividad.length === 0 ? (
          <p class="mt-5 rounded border border-dashed border-base-300 px-4 py-8 text-center text-sm text-base-content/55">
            Todavía no hay contenido. Empieza creando un evento o una noticia.
          </p>
        ) : (
          <ul class="mt-4 divide-y divide-base-300/70">
            {actividad.map((r) => (
              <li>
                <a
                  href={TIPO[r.tipo].href}
                  class="flex items-center gap-3 py-3 transition-colors hover:bg-base-200/50"
                >
                  <span class="tile h-9 w-9 shrink-0">
                    <Icon name={TIPO[r.tipo].icon} class="h-4 w-4" />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm font-medium">{r.titulo}</span>
                    <span class="font-data text-xs uppercase tracking-wide text-base-content/50">
                      {TIPO[r.tipo].label} · {fecha(r.creado_en)}
                    </span>
                  </span>
                  <span
                    class={`badge badge-sm shrink-0 ${r.publicado === 1 ? 'badge-success' : 'badge-ghost'}`}
                  >
                    {r.publicado === 1 ? 'Publicado' : 'Borrador'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <!-- Acciones y ayuda -->
    <div class="space-y-6">
      <section data-reveal class="panel p-5">
        <h2 class="flex items-center gap-2 text-base font-bold">
          <Icon name="lucide:zap" class="h-4 w-4 text-accent" /> Crear algo
        </h2>
        <div class="mt-4 space-y-2">
          {
            acciones.map((a) => (
              <a href={a.href} class="btn btn-outline btn-sm w-full justify-start gap-2">
                <Icon name={a.icon} class="h-4 w-4" /> {a.label}
              </a>
            ))
          }
        </div>
      </section>

      <section data-reveal class="panel p-5">
        <h2 class="flex items-center gap-2 text-base font-bold">
          <Icon name="lucide:life-buoy" class="h-4 w-4 text-accent" /> Cómo funciona
        </h2>
        <ul class="mt-4 space-y-3 text-sm text-base-content/75">
          <li class="flex items-start gap-2">
            <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-success" />
            Lo que está en <strong>borrador</strong> no se ve en el sitio. Publícalo cuando esté listo.
          </li>
          <li class="flex items-start gap-2">
            <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-success" />
            En videos basta pegar la dirección de YouTube; la miniatura sale sola.
          </li>
          <li class="flex items-start gap-2">
            <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-success" />
            Las imágenes se suben solas al guardar.
          </li>
        </ul>
      </section>
    </div>
  </div>
</AdminLayout>
