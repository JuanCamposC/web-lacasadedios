---
export const prerender = false;

/**
 * Los horarios, como tablero de la semana.
 *
 * El porqué de dejar el CRUD genérico está en src/scripts/admin/horarios.ts, que
 * es donde vive el comportamiento. Esta página solo pone la marca: el tablero
 * vacío, el formulario y el diálogo de borrado.
 *
 * El formulario describe lo que la reunión ES —en qué templos, qué día, a qué
 * hora, cómo se llama y qué se celebra—. Lo de «solo esta vez» no está acá: es
 * una acción del menú de cada línea, porque es algo que se le hace a una
 * reunión que ya existe, no una propiedad suya.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';
import { templos } from '../../data/templos';
import { DIAS } from '../../lib/reuniones';

/* Las reglas, dichas para quien las elige.
   `reglaEnPalabras` necesita un día para concordar («el primer domingo»), pero
   en el desplegable todavía no se sabe cuál: se usa una forma neutra, y la
   frase con el día de verdad la da la línea de vista previa. */
const REGLAS = [
  { value: 'siempre', label: 'Todas las semanas' },
  { value: 'primer', label: 'El primero de cada mes' },
  { value: 'primer-par', label: 'El primero de los meses pares (feb, abr, jun…)' },
  { value: 'primer-impar', label: 'El primero de los meses impares (ene, mar, may…)' },
  { value: 'ultimo', label: 'El último de cada mes' },
];
---

<AdminLayout
  title="Horarios"
  description="La semana completa. Suspende o mueve una reunión desde el menú de su línea."
  active="horarios"
>
  <button slot="acciones" id="form-nueva" class="btn btn-primary btn-sm gap-1.5">
    <Icon name="lucide:plus" class="h-4 w-4" />
    <span class="hidden sm:inline">Nueva reunión</span>
  </button>

  <div class="grid gap-6 lg:grid-cols-12">
    <!-- ══ El tablero ════════════════════════════════════════════════════ -->
    <section class="lg:col-span-7 xl:col-span-8">
      <div class="panel mb-4 flex items-start gap-3 p-3">
        <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
        <p class="text-xs text-base-content/75">
          Una línea puede ser la misma reunión en varios templos: se editan las dos a la vez. Para
          suspenderla o moverla <strong>solo una vez</strong>, usa el menú{' '}
          <span class="font-bold">⋯</span> de su línea — la fecha de término la pone el panel y la
          reunión vuelve sola.
        </p>
      </div>

      <div id="tablero">
        <div class="panel p-6 text-center">
          <span class="loading loading-spinner loading-sm"></span>
        </div>
      </div>

      <section class="panel mt-6">
        <header class="rounded-t-[calc(0.5rem-1px)] border-b border-base-300 bg-base-200/60 px-3 py-2">
          <h2 class="font-data text-xs font-bold uppercase tracking-[0.14em]">
            Cambios de un día programados
          </h2>
          <p class="mt-0.5 text-xs text-base-content/70">
            Cada uno rige solo en su fecha y desaparece solo después. Se ven en /horarios esa semana
            y en el calendario desde ya.
          </p>
        </header>
        <div id="programados">
          <p class="px-3 py-3 text-xs text-base-content/60">Cargando…</p>
        </div>
      </section>
    </section>

    <!-- ══ El formulario ═════════════════════════════════════════════════ -->
    <section class="lg:col-span-5 xl:col-span-4">
      <form id="form-reunion" class="panel space-y-4 p-5 lg:sticky lg:top-24">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-base font-bold" id="form-titulo">
            Nueva reunión
          </h2>
          <button type="button" class="btn btn-ghost btn-xs hidden" id="form-cancelar">
            Cancelar
          </button>
        </div>

        <fieldset class="space-y-2 rounded border border-base-300 p-3">
          <legend class="px-1.5 text-xs font-semibold uppercase tracking-wider text-base-content/70">
            En qué templos
          </legend>
          {/* Casillas y no un desplegable, y eso es la mitad del arreglo: el
              estudio bíblico de los lunes se hace en los cuatro templos, y con
              un desplegable había que rellenar este formulario cuatro veces y
              después acordarse de editar las cuatro filas. */}
          <div class="grid grid-cols-1 gap-1.5 sm:grid-cols-2">
            {templos.map((t) => (
              <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-sm hover:bg-base-200">
                <input
                  type="checkbox"
                  name="templos"
                  value={t.slug}
                  class="checkbox checkbox-primary checkbox-sm"
                />
                {t.short}
              </label>
            ))}
          </div>
          <p class="px-1.5 text-xs text-base-content/70">
            Se guarda una vez en cada templo marcado. Si desmarcas uno, su reunión se va a la
            papelera y se puede recuperar.
          </p>
        </fieldset>

        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">
            Día <span class="text-error">*</span>
          </span>
          <select name="dia" required class="select select-bordered w-full">
            {DIAS.map((d, i) => (
              <option value={i}>{d}</option>
            ))}
          </select>
        </label>

        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">
            Hora <span class="text-error">*</span>
          </span>
          <input type="time" name="hora" required class="input input-bordered w-full" />
          <span class="mt-1 block text-xs text-base-content/70">
            La hora de siempre. Para cambiarla una sola vez, usa el menú de la línea.
          </span>
        </label>

        <label class="block">
          <span class="mb-1.5 block text-sm font-medium">
            Cómo se llama <span class="text-error">*</span>
          </span>
          <input
            type="text"
            name="nombre"
            required
            placeholder="Reunión General"
            class="input input-bordered w-full"
          />
          <span class="mt-1 block text-xs text-base-content/70">
            Ej.: Reunión General, Estudio Bíblico, Reunión de Jóvenes.
          </span>
        </label>

        <fieldset class="space-y-3 rounded border border-base-300 p-3">
          <legend class="px-1.5 text-xs font-semibold uppercase tracking-wider text-base-content/70">
            Algo que se repite
          </legend>
          <p class="-mt-1 px-1.5 text-xs text-base-content/70">
            Para lo que vuelve cada tanto y siempre es igual. Se pone una vez y el sitio lo enseña
            cuando toca, sin que nadie se acuerde de quitarlo.
          </p>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Qué pasa ese día</span>
            <input
              type="text"
              name="marca"
              placeholder="Santa Cena"
              class="input input-bordered w-full"
            />
            <span class="mt-1 block text-xs text-base-content/70">
              Aparece junto al nombre de la reunión, en dorado.
            </span>
          </label>

          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Cada cuánto</span>
            <select name="marca_regla" class="select select-bordered w-full">
              <option value="">Nunca — esta reunión no lleva marca</option>
              {REGLAS.map((r) => (
                <option value={r.value}>{r.label}</option>
              ))}
            </select>
            <p id="previa-marca" class="mt-1 text-xs" role="status"></p>
          </label>
        </fieldset>

        <label class="flex cursor-pointer items-start gap-3 rounded border border-base-300 bg-base-200/50 p-3">
          <input
            type="checkbox"
            name="publicado"
            checked
            class="toggle toggle-primary toggle-sm mt-0.5"
          />
          <span>
            <span class="block text-sm font-medium">Se muestra en la web</span>
            <span class="block text-xs text-base-content/70">
              Si lo apagas, la reunión sigue acá pero desaparece de los horarios del sitio.
            </span>
          </span>
        </label>

        <button type="submit" class="btn btn-primary w-full" id="form-guardar">
          Guardar
        </button>
      </form>
    </section>
  </div>

  <dialog id="dlg-excepcion" class="modal">
    <form id="form-excepcion" class="modal-box max-w-md space-y-4">
      <div>
        <h3 class="text-lg font-bold">Programar un cambio de un día</h3>
        <p class="mt-1 text-sm text-base-content/70" id="exc-reunion"></p>
      </div>

      <label class="block">
        <span class="mb-1.5 block text-sm font-medium">
          Qué día <span class="text-error">*</span>
        </span>
        <input type="date" name="fecha" required class="input input-bordered w-full" />
        <span id="exc-previa" class="mt-1 block text-xs" role="status"></span>
      </label>

      <fieldset class="space-y-1.5">
        <legend class="mb-1.5 text-sm font-medium">Qué pasa ese día</legend>
        <label class="flex cursor-pointer items-center gap-2 text-sm">
          <input
            type="radio"
            name="estado"
            value="suspendida"
            checked
            class="radio radio-primary radio-sm"
          />
          Se suspende
        </label>
        <label class="flex cursor-pointer items-center gap-2 text-sm">
          <input type="radio" name="estado" value="cambiada" class="radio radio-primary radio-sm" />
          Se hace, pero distinta (otra hora u otro nombre)
        </label>
      </fieldset>

      <div id="exc-solo-cambio" class="hidden">
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Hora ese día</span>
            <input type="time" name="hora" class="input input-bordered w-full" />
          </label>
          <label class="block">
            <span class="mb-1.5 block text-sm font-medium">Nombre ese día</span>
            <input type="text" name="nombre" class="input input-bordered w-full" />
          </label>
          <span class="col-span-2 -mt-1 block text-xs text-base-content/70">
            Vacío o igual al de siempre = no cambia.
          </span>
        </div>
      </div>

      <label class="block">
        <span class="mb-1.5 block text-sm font-medium">Qué decirle a la gente</span>
        <input
          type="text"
          name="aviso"
          placeholder="Reunión en familia, en cada casa"
          class="input input-bordered w-full"
        />
        <span class="mt-1 block text-xs text-base-content/70">
          Opcional. Aparece junto a la reunión ese día.
        </span>
      </label>

      <div class="modal-action">
        <button type="button" id="exc-cancelar" class="btn btn-ghost">
          Cancelar
        </button>
        <button type="submit" id="exc-guardar" class="btn btn-primary">
          Programar
        </button>
      </div>
    </form>
    <form method="dialog" class="modal-backdrop">
      <button>cerrar</button>
    </form>
  </dialog>

  <dialog id="dlg-borrar" class="modal">
    <div class="modal-box max-w-sm">
      <h3 class="text-lg font-bold">¿Borrar esta reunión?</h3>
      <p class="mt-2 text-sm text-base-content/70">
        <strong data-nombre class="break-words"></strong> deja de verse en los horarios del sitio.
        Queda 30 días en la papelera del panel, así que se puede recuperar.
      </p>
      <p class="mt-2 text-sm text-base-content/70">
        Si solo se suspende por esta vez, cancela y usa «Suspender» en el menú de la línea: así
        vuelve sola.
      </p>
      <div class="modal-action">
        <form method="dialog" class="flex w-full gap-2">
          <button value="no" class="btn btn-ghost flex-1">
            Cancelar
          </button>
          <button value="si" class="btn btn-error flex-1">
            Sí, borrar
          </button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>cerrar</button>
    </form>
  </dialog>

  <script>
    import { initHorarios } from '../../scripts/admin/horarios';

    // El panel no monta el ClientRouter, así que `astro:page-load` no llega
    // nunca: hace falta el respaldo. Ver la nota en Navigation.astro.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHorarios);
    } else {
      initHorarios();
    }
  </script>
</AdminLayout>
