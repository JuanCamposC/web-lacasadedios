---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout
  title="Videos"
  description="Prédicas y enseñanzas alojadas en YouTube."
  active="videos"
>
  <div id="crud-root"></div>

  <script>
    import { setupCrud } from '../../scripts/adminCrud';
    import { etiquetas } from '../../data/etiquetas';
    setupCrud({
      table: 'videos',
      singular: 'video',
      titleField: 'titulo',
      subtitleField: 'youtube_url',
      orderBy: { column: 'orden', ascending: true },
      orderable: { column: 'orden' },
      notify: { type: 'video', urlBase: '/videos' },
      fields: [
        { name: 'titulo', label: 'Título', type: 'text', required: true },
        {
          name: 'youtube_url',
          label: 'Link de YouTube',
          type: 'url',
          required: true,
          help: 'Pega la URL del video (youtube.com/watch?v=… o youtu.be/…).',
        },
        { name: 'descripcion', label: 'Descripción', type: 'textarea' },
        {
          name: 'templo',
          label: 'Templo',
          type: 'select',
          required: true,
          options: etiquetas,
          help: 'A qué templo pertenece. «General» si vale para todos.',
        },
        { name: 'publicado', label: 'Publicado', type: 'checkbox' },
      ],
    });
  </script>
</AdminLayout>
