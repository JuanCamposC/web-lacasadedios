---
// Confirmación del alta al boletín. Se llega desde el enlace del correo, sin
// sesión: el token del enlace es la única credencial, igual que en /baja.
//
// El alta queda `pending` hasta que se pasa por aquí. Ese es todo el sentido
// del doble opt-in: dejar un correo en un formulario no prueba que sea tuyo,
// abrir el mensaje que llega a esa dirección sí.
//
// ── POR QUÉ NO SE CONFIRMA AL ABRIR EL ENLACE ──
// Porque los enlaces de los correos no los abre solo la persona. Los antivirus
// de correo, los filtros de empresa y los escáneres de seguridad los visitan
// por su cuenta, sin que nadie pulse nada. Con la acción en el GET, eso
// confirmaba suscripciones que nadie confirmó, que es exactamente lo que
// el doble opt-in existe para impedir: bastaba con escribir la dirección de
// otra persona y esperar a que su antivirus abriera el enlace.
// Por eso al abrir se enseña un botón, y lo que actúa es el POST de ese botón:
// un escáner no rellena formularios.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import { Icon } from 'astro-icon/components';
import { baseDeDatos } from '../lib/base';
import { confirmarSuscriptor } from '../lib/boletin';
import { CONTACT } from '../data/site';

const ES_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const esConfirmacion = Astro.request.method === 'POST';

let token = Astro.url.searchParams.get('t')?.trim() ?? '';
if (esConfirmacion) {
  const datos = await Astro.request.formData();
  token = String(datos.get('t') ?? '').trim();
}

type Estado = 'sin-token' | 'confirmar' | 'listo' | 'no-encontrado' | 'error';
let estado: Estado = 'sin-token';

if (token) {
  if (!ES_UUID.test(token)) {
    estado = 'no-encontrado';
  } else if (!esConfirmacion) {
    estado = 'confirmar';
  } else {
    // `true` si esta llamada fue la que confirmó. Confirmar dos veces no da
    // «listo» la segunda, y está bien: quien recarga ya está dentro y lo que
    // ve es la página de «este enlace ya no sirve», no un error.
    try {
      const confirmado = await confirmarSuscriptor(await baseDeDatos(), token);
      estado = confirmado ? 'listo' : 'no-encontrado';
    } catch (e) {
      console.error(`[confirmar] ${(e as Error).message}`);
      estado = 'error';
    }
  }
}

const TEXTOS: Record<Estado, { icono: string; titulo: string; texto: string }> = {
  confirmar: {
    icono: 'lucide:mail-check',
    titulo: 'Confirma tu suscripción',
    texto:
      'Un último paso: pulsa el botón y empezarás a recibir el boletín con eventos, noticias y prédicas.',
  },
  'sin-token': {
    icono: 'lucide:link-2-off',
    titulo: 'Enlace incompleto',
    texto:
      'Para confirmar tu suscripción usa el botón del correo que te enviamos. Si no llegó, revisa la carpeta de correo no deseado.',
  },
  listo: {
    icono: 'lucide:check-circle-2',
    titulo: '¡Listo! Ya estás suscrito',
    texto:
      'Te avisaremos cuando publiquemos eventos, noticias y prédicas. Cada correo lleva un enlace para darte de baja cuando quieras.',
  },
  'no-encontrado': {
    icono: 'lucide:search-x',
    titulo: 'No encontramos esa suscripción',
    texto:
      'Puede que el enlace esté incompleto o que ya te hubieras dado de baja. Vuelve a suscribirte desde el pie del sitio y te mandamos un correo nuevo.',
  },
  error: {
    icono: 'lucide:alert-triangle',
    titulo: 'No pudimos confirmar tu suscripción',
    texto: `Hubo un problema al procesar tu solicitud. Escríbenos a ${CONTACT.email} y te agregamos a mano.`,
  },
};

const t = TEXTOS[estado];
---

<Layout
  title="Confirmar suscripción · La Casa de Dios"
  description="Confirma tu suscripción al boletín de La Casa de Dios."
  noindex
>
  <section class="section flex min-h-[70vh] items-center bg-base-100">
    <div class="wrap-narrow">
      <EmptyState icon={t.icono} title={t.titulo} text={t.texto}>
        {
          estado === 'confirmar' && (
            <form method="post" class="contents">
              <input type="hidden" name="t" value={token} />
              <button type="submit" class="btn btn-primary gap-2">
                <Icon name="lucide:mail-check" class="h-5 w-5" /> Confirmar mi suscripción
              </button>
            </form>
          )
        }
        <a href="/" class={`btn gap-2 ${estado === 'confirmar' ? 'btn-ghost' : 'btn-primary'}`}>
          <Icon name="lucide:home" class="h-5 w-5" />
          Ir al inicio
        </a>
        {
          estado === 'listo' && (
            <a href="/eventos" class="btn btn-ghost gap-2">
              <Icon name="lucide:calendar-days" class="h-5 w-5" /> Ver los próximos eventos
            </a>
          )
        }
      </EmptyState>

      {
        /* El token viaja en un atributo y no dentro del script porque el sitio
           publica su CSP con hashes: un `<script>` con datos incrustados
           cambiaría de hash en cada visita y quedaría bloqueado. */
        estado === 'listo' && <span hidden data-bienvenida={token} />
      }
    </div>
  </section>
</Layout>

<script>
  /**
   * Bienvenida.
   *
   * Se pide desde aquí y no al pintar la página para no hacer esperar a nadie
   * mientras sale un correo. Si falla, falla en silencio: la suscripción ya
   * quedó confirmada, que es lo que la persona vino a hacer, y el servidor se
   * encarga de que no salgan dos.
   */
  function pedirBienvenida() {
    const marca = document.querySelector<HTMLElement>('[data-bienvenida]');
    const t = marca?.dataset.bienvenida;
    if (!t || marca.dataset.pedida) return;
    marca.dataset.pedida = '1';

    fetch('/api/bienvenida', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ t }),
    }).catch(() => {
      /* sin conexión: no hay nada que decirle a quien ya está suscrito */
    });
  }

  document.addEventListener('astro:page-load', pedirBienvenida);
</script>
