---
// Baja del boletín. Se llega desde el enlace del pie de cada correo, sin
// sesión: el token del enlace es la única credencial.
//
// ── POR QUÉ NO SE DA DE BAJA AL ABRIR EL ENLACE ──
// Porque los enlaces de los correos no los abre solo la persona. Los antivirus
// de correo, los filtros de empresa y los escáneres de seguridad los visitan
// por su cuenta, sin que nadie pulse nada. Con la acción en el GET, eso
// daba de baja a gente que no lo había pedido, y era indepurable:
// la queja es «dejé de recibir el boletín sin hacer nada».
// Por eso al abrir se enseña un botón, y lo que actúa es el POST de ese botón:
// un escáner no rellena formularios.
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import EmptyState from '../components/EmptyState.astro';
import { Icon } from 'astro-icon/components';
import { baseDeDatos } from '../lib/base';
import { bajaSuscriptor } from '../lib/boletin';
import { CONTACT } from '../data/site';

const ES_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const esPeticionDeBaja = Astro.request.method === 'POST';

let token = Astro.url.searchParams.get('t')?.trim() ?? '';
if (esPeticionDeBaja) {
  const datos = await Astro.request.formData();
  token = String(datos.get('t') ?? '').trim();
}

type Estado = 'sin-token' | 'confirmar' | 'listo' | 'no-encontrado' | 'error';
let estado: Estado = 'sin-token';

if (token) {
  if (!ES_UUID.test(token)) {
    estado = 'no-encontrado';
  } else if (!esPeticionDeBaja) {
    estado = 'confirmar';
  } else {
    // `true` si borró una fila. Quien ya se dio de baja y vuelve a pulsar el
    // enlace ve «no encontrado», que en la práctica dice lo mismo: no está.
    try {
      const borrado = await bajaSuscriptor(await baseDeDatos(), token);
      estado = borrado ? 'listo' : 'no-encontrado';
    } catch (e) {
      console.error(`[baja] ${(e as Error).message}`);
      estado = 'error';
    }
  }
}

const TEXTOS: Record<Estado, { icono: string; titulo: string; texto: string }> = {
  confirmar: {
    icono: 'lucide:mail-x',
    titulo: '¿Quieres darte de baja?',
    texto: 'Pulsa el botón y dejarás de recibir el boletín. No te pedimos ningún dato más.',
  },
  'sin-token': {
    icono: 'lucide:link-2-off',
    titulo: 'Enlace incompleto',
    texto:
      'Para darte de baja usa el enlace que aparece al final de cualquiera de nuestros correos.',
  },
  listo: {
    icono: 'lucide:check-circle-2',
    titulo: 'Listo, te diste de baja',
    texto:
      'No volverás a recibir el boletín. Si algún día cambias de opinión, puedes suscribirte otra vez desde el pie del sitio.',
  },
  'no-encontrado': {
    icono: 'lucide:search-x',
    titulo: 'Ese correo ya no está en la lista',
    texto:
      'Puede que ya te hubieras dado de baja antes, o que el enlace esté incompleto. En cualquier caso, no vas a recibir más correos con esa dirección.',
  },
  error: {
    icono: 'lucide:alert-triangle',
    titulo: 'No pudimos completar la baja',
    texto: `Hubo un problema al procesar tu solicitud. Escríbenos a ${CONTACT.email} y te sacamos de la lista a mano.`,
  },
};

const t = TEXTOS[estado];
---

<Layout
  title="Baja del boletín · La Casa de Dios"
  description="Cancela tu suscripción al boletín de La Casa de Dios."
  noindex
>
  <section class="section flex min-h-[70vh] items-center bg-base-100">
    <div class="wrap-narrow">
      <EmptyState icon={t.icono} title={t.titulo} text={t.texto}>
        {
          estado === 'confirmar' && (
            <form method="post" class="contents">
              <input type="hidden" name="t" value={token} />
              <button type="submit" class="btn btn-primary gap-2">
                <Icon name="lucide:mail-x" class="h-5 w-5" /> Darme de baja
              </button>
            </form>
          )
        }
        <a href="/" class={`btn gap-2 ${estado === 'confirmar' ? 'btn-ghost' : 'btn-primary'}`}>
          <Icon name="lucide:home" class="h-5 w-5" />
          {estado === 'confirmar' ? 'Seguir recibiéndolo' : 'Ir al inicio'}
        </a>
        {
          estado === 'listo' && (
            <a href="/contacto" class="btn btn-ghost gap-2">
              <Icon name="lucide:message-square" class="h-5 w-5" /> Contarnos por qué
            </a>
          )
        }
      </EmptyState>
    </div>
  </section>
</Layout>
