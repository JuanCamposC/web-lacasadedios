---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { youtubeId, type VideoItem } from '../../lib/supabase';

const supabase = Astro.locals.supabase;
let videos: VideoItem[] = [];
if (supabase) {
  const { data } = await supabase
    .from('videos')
    .select('*')
    .eq('published', true)
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: false });
  videos = data ?? [];
}

const withId = videos
  .map((v) => ({ ...v, vid: youtubeId(v.youtube_url) }))
  .filter((v) => v.vid);
---

<Layout
  title="Videos · La Casa de Dios"
  description="Prédicas y enseñanzas en video de La Casa de Dios — Conociendo la Palabra."
>
  <section class="hero min-h-[36vh] bg-gradient-to-br from-primary/10 via-base-100 to-accent/10">
    <div class="hero-content text-center">
      <div class="max-w-3xl">
        <div class="badge badge-primary badge-lg mb-4">Conociendo la Palabra</div>
        <h1 class="font-display text-5xl md:text-6xl font-bold text-primary mb-4">Videos</h1>
        <p class="text-lg opacity-80">Prédicas y enseñanzas para crecer en la fe</p>
      </div>
    </div>
  </section>

  <section class="py-16 px-4 bg-base-100">
    <div class="container mx-auto max-w-6xl">
      {withId.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-lg opacity-70 mb-6">Pronto publicaremos más videos. Mientras tanto, visita nuestro canal:</p>
          <a href="https://www.youtube.com/@casadediosconociendolapalabrad" target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/></svg>
            Ver canal en YouTube
          </a>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {withId.map((v) => (
            <div class="card bg-base-100 shadow-lg border border-base-300 overflow-hidden">
              <div class="aspect-video">
                <iframe
                  class="w-full h-full"
                  src={`https://www.youtube-nocookie.com/embed/${v.vid}`}
                  title={v.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="card-body p-5">
                <h2 class="card-title text-lg">{v.title}</h2>
                {v.description && <p class="opacity-80 text-sm">{v.description}</p>}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
