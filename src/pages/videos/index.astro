---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Reveal from '../../components/Reveal.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../../assets/images';
import { youtubeId, type VideoItem } from '../../lib/supabase';

const supabase = Astro.locals.supabase;
let videos: VideoItem[] = [];
if (supabase) {
  const { data } = await supabase
    .from('videos')
    .select('*')
    .eq('published', true)
    .order('sort_order', { ascending: true })
    .order('created_at', { ascending: false });
  videos = data ?? [];
}

const withId = videos.map((v) => ({ ...v, vid: youtubeId(v.youtube_url) })).filter((v) => v.vid);
---

<Layout title="Videos · La Casa de Dios" description="Prédicas y enseñanzas en video de La Casa de Dios — Conociendo la Palabra.">
  <PageHero image={IMG.camara} alt="Cámara de video" eyebrow="Conociendo la Palabra" title="Videos" subtitle="Prédicas y enseñanzas para crecer en la fe." height="min-h-[50vh]" />

  <section class="bg-base-100 px-4 py-20">
    <div class="container mx-auto max-w-6xl">
      {withId.length === 0 ? (
        <div class="py-12 text-center">
          <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-base-200 text-base-content/40">
            <Icon name="lucide:youtube" class="h-8 w-8" />
          </div>
          <p class="mb-6 text-lg text-base-content/70">Pronto publicaremos más videos. Mientras tanto, visita nuestro canal:</p>
          <a href="https://www.youtube.com/@casadediosconociendolapalabrad" target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2">
            <Icon name="lucide:youtube" class="h-5 w-5" /> Ver canal en YouTube
          </a>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {withId.map((v, i) => (
            <Reveal delay={(i % 3) * 80}>
              <div class="group h-full overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm transition-all duration-300 hover:shadow-xl">
                <div class="aspect-video overflow-hidden">
                  <iframe
                    class="h-full w-full"
                    src={`https://www.youtube-nocookie.com/embed/${v.vid}`}
                    title={v.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
                <div class="p-5">
                  <h2 class="card-title text-lg">{v.title}</h2>
                  {v.description && <p class="mt-1 text-sm text-base-content/75">{v.description}</p>}
                </div>
              </div>
            </Reveal>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
