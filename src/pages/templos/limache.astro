---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
---

<Layout title="Templo Limache - La Casa de Dios" description="Información del Templo Limache">
	<Navigation />
	
	<!-- Hero Section -->
	<section class="hero min-h-[60vh] bg-gradient-to-br from-primary/20 via-base-100 to-accent/20">
		<div class="hero-content text-center">
			<div class="max-w-4xl animate-fade-in-up">
				<div class="text-7xl mb-6">🏘️</div>
				<h1 class="text-5xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent">
					Templo Limache
				</h1>
				<p class="text-xl md:text-2xl opacity-80">
					Sirviendo a la comunidad de Limache con amor y fe
				</p>
				<div class="badge badge-primary badge-lg mt-4">Región de Valparaíso</div>
			</div>
		</div>
	</section>

	<!-- Información Principal -->
	<section class="py-20 px-4 bg-base-100">
		<div class="container mx-auto max-w-7xl">
			<div class="grid md:grid-cols-3 gap-8">
				
				<!-- Ubicación -->
				<div class="card bg-gradient-to-br from-primary/10 to-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 animate-fade-in-up">
					<div class="card-body">
						<div class="flex items-center gap-3 mb-4">
							<div class="bg-primary text-primary-content p-4 rounded-full">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
								</svg>
							</div>
							<h2 class="card-title text-2xl">Ubicación</h2>
						</div>
						<div class="space-y-3">
							<div class="flex items-start gap-2">
								<span class="font-semibold">📍</span>
								<p>Avenida Urmeneta 890, Limache</p>
							</div>
							<div class="flex items-start gap-2">
								<span class="font-semibold">🏙️</span>
								<p>Comuna de Limache</p>
							</div>
							<div class="flex items-start gap-2">
								<span class="font-semibold">🗺️</span>
								<p>Región de Valparaíso</p>
							</div>
						</div>
						<div class="card-actions justify-end mt-4">
							<a href="https://www.google.com/maps/search/Avenida+Urmeneta+890+Limache" target="_blank" class="btn btn-primary btn-sm">
								Ver en Google Maps
							</a>
						</div>
					</div>
				</div>

				<!-- Horarios -->
				<div class="card bg-gradient-to-br from-secondary/10 to-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 animate-fade-in-up" style="animation-delay: 0.1s;">
					<div class="card-body">
						<div class="flex items-center gap-3 mb-4">
							<div class="bg-secondary text-secondary-content p-4 rounded-full">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<h2 class="card-title text-2xl">Horarios</h2>
						</div>
						<div class="space-y-4">
							<div class="bg-base-200 p-4 rounded-lg">
								<div class="badge badge-primary mb-2">Domingo</div>
								<p class="text-sm">⏰ 10:30 - Escuela Dominical</p>
								<p class="text-sm">⏰ 11:30 - Culto Principal</p>
								<p class="text-sm">⏰ 18:30 - Culto Vespertino</p>
							</div>
							<div class="bg-base-200 p-4 rounded-lg">
								<div class="badge badge-secondary mb-2">Miércoles</div>
								<p class="text-sm">⏰ 19:00 - Reunión de Oración</p>
							</div>
							<div class="bg-base-200 p-4 rounded-lg">
								<div class="badge badge-accent mb-2">Viernes</div>
								<p class="text-sm">⏰ 19:30 - Estudio Bíblico</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Pastor/Hermano a Cargo -->
				<div class="card bg-gradient-to-br from-accent/10 to-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 animate-fade-in-up" style="animation-delay: 0.2s;">
					<div class="card-body">
						<div class="flex items-center gap-3 mb-4">
							<div class="bg-accent text-accent-content p-4 rounded-full">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
								</svg>
							</div>
							<h2 class="card-title text-2xl">Liderazgo</h2>
						</div>
						<div class="text-center mb-4">
							<div class="avatar placeholder mb-3">
								<div class="bg-neutral text-neutral-content rounded-full w-20">
									<span class="text-3xl">👤</span>
								</div>
							</div>
							<h3 class="text-xl font-bold">Hermano Miguel Ramírez</h3>
							<p class="text-sm opacity-70">Hermano a Cargo</p>
						</div>
						<div class="space-y-2">
							<div class="flex items-center gap-2 justify-center">
								<span>📞</span>
								<a href="tel:+56955556666" class="link link-hover">+56 9 5555 6666</a>
							</div>
							<div class="flex items-center gap-2 justify-center">
								<span>✉️</span>
								<a href="mailto:hermano.limache@lacasadedios.cl" class="link link-hover text-sm">hermano.limache@lacasadedios.cl</a>
							</div>
						</div>
						<p class="text-sm opacity-80 mt-4 text-center">
							Sirviendo fielmente con un corazón de siervo, dedicado al cuidado de las familias y al crecimiento espiritual de la comunidad.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Actividades y Ministerios -->
	<section class="py-20 px-4 bg-gradient-to-b from-base-100 to-base-200">
		<div class="container mx-auto max-w-7xl">
			<div class="text-center mb-16 animate-fade-in-up">
				<h2 class="text-4xl md:text-5xl font-bold mb-4">Nuestras Actividades</h2>
				<div class="divider divider-primary max-w-xs mx-auto"></div>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
					<div class="card-body items-center text-center">
						<div class="text-5xl mb-4">👶</div>
						<h3 class="card-title text-lg">Ministerio de Niños</h3>
						<p class="text-sm opacity-70">Educación y formación para los más pequeños</p>
					</div>
				</div>

				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
					<div class="card-body items-center text-center">
						<div class="text-5xl mb-4">🎸</div>
						<h3 class="card-title text-lg">Alabanza</h3>
						<p class="text-sm opacity-70">Adoración con música y canto</p>
					</div>
				</div>

				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
					<div class="card-body items-center text-center">
						<div class="text-5xl mb-4">📖</div>
						<h3 class="card-title text-lg">Estudio Bíblico</h3>
						<p class="text-sm opacity-70">Profundizando en la Palabra</p>
					</div>
				</div>

				<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
					<div class="card-body items-center text-center">
						<div class="text-5xl mb-4">🤝</div>
						<h3 class="card-title text-lg">Servicio Comunitario</h3>
						<p class="text-sm opacity-70">Ayudando a quienes lo necesitan</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Call to Action -->
	<section class="py-20 px-4 bg-gradient-to-br from-primary/20 via-secondary/10 to-accent/20">
		<div class="container mx-auto max-w-4xl text-center animate-fade-in-up">
			<h2 class="text-4xl md:text-5xl font-bold mb-6">¡Te Esperamos!</h2>
			<p class="text-xl opacity-80 mb-8">
				Ven y sé parte de nuestra familia en Limache. Todos son bienvenidos.
			</p>
			<div class="flex flex-wrap gap-4 justify-center">
				<a href="https://www.google.com/maps/search/Avenida+Urmeneta+890+Limache" target="_blank" class="btn btn-primary btn-lg gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
					</svg>
					Cómo Llegar
				</a>
				<a href="/" class="btn btn-outline btn-lg">Volver al Inicio</a>
			</div>
		</div>
	</section>

</Layout>
<style>
	@keyframes float {
		0%, 100% { transform: translateY(0px) scale(1); }
		50% { transform: translateY(-30px) scale(1.1); }
	}

	.hero-shape {
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 100%;
		height: 100px;
		background: linear-gradient(135deg, #f8fafc 0%, #e0f2fe 100%);
		clip-path: polygon(0 40%, 100% 0, 100% 100%, 0 100%);
	}

	.hero-content {
		text-align: center;
		position: relative;
		z-index: 2;
	}

	.temple-icon {
		font-size: 4rem;
		margin-bottom: 1rem;
		filter: drop-shadow(0 0 20px rgba(251, 191, 36, 0.5));
		animation: pulse 2s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.1); }
	}

	.temple-hero h1 {
		font-size: 3.5rem;
		margin-bottom: 1rem;
		color: white;
		font-weight: 800;
		text-shadow: 2px 2px 20px rgba(0, 0, 0, 0.3);
	}

	.subtitle {
		font-size: 1.4rem;
		color: #e0f2fe;
		font-weight: 400;
		font-style: italic;
	}

	.container {
		max-width: 1400px;
		margin: 0 auto;
	}

	.temple-content {
		padding: 5rem 2rem;
	}

	.info-grid {
		display: grid;
		gap: 2.5rem;
	}

	.info-card {
		background: white;
		padding: 3rem;
		border-radius: 24px;
		box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
		position: relative;
		overflow: hidden;
		transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.info-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
	}

	.card-decoration {
		position: absolute;
		top: -60px;
		right: -60px;
		width: 200px;
		height: 200px;
		border-radius: 50%;
		opacity: 0.1;
		transition: all 0.4s;
	}

	.location-card .card-decoration { background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); }
	.schedule-card .card-decoration { background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); }
	.pastor-card .card-decoration { background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%); }

	.info-card:hover .card-decoration {
		transform: scale(1.5);
		opacity: 0.15;
	}

	.card-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.1));
	}

	.info-card h2 {
		color: #1e3a8a;
		margin-bottom: 2rem;
		font-size: 1.8rem;
		font-weight: 700;
	}

	.info-content p {
		margin-bottom: 1rem;
		line-height: 1.7;
		font-size: 1.05rem;
	}

	.map-placeholder {
		background: linear-gradient(135deg, #f1f5f9 0%, #e0f2fe 100%);
		padding: 3rem;
		border-radius: 16px;
		text-align: center;
		margin-top: 1.5rem;
		border: 2px dashed #cbd5e1;
		transition: all 0.3s;
	}

	.map-placeholder:hover {
		background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
		border-color: #3b82f6;
	}

	.schedule {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.schedule-item {
		padding: 1.5rem;
		background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
		border-radius: 16px;
		border-left: 4px solid #3b82f6;
		transition: all 0.3s;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
	}

	.schedule-item:hover {
		transform: translateX(8px);
		box-shadow: 0 4px 16px rgba(59, 130, 246, 0.2);
	}

	.day-badge {
		display: inline-block;
		background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
		color: white;
		padding: 0.5rem 1.2rem;
		border-radius: 20px;
		font-weight: 600;
		font-size: 0.95rem;
		margin-bottom: 1rem;
	}

	.schedule-item p {
		margin-bottom: 0.5rem;
		padding-left: 1.5rem;
		position: relative;
		color: #475569;
	}

	.schedule-item p::before {
		content: '•';
		position: absolute;
		left: 0.5rem;
		color: #3b82f6;
		font-weight: bold;
	}

	.pastor-info h3 {
		color: #1e3a8a;
		font-size: 1.6rem;
		margin-bottom: 1.5rem;
		font-weight: 700;
	}

	.contact-info {
		background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
		padding: 1.5rem;
		border-radius: 16px;
		margin-bottom: 1.5rem;
	}

	.contact-info p {
		margin-bottom: 0.8rem;
		font-size: 1.05rem;
		color: #475569;
	}

	.contact-info p:last-child {
		margin-bottom: 0;
	}

	.pastor-info .bio {
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 2px solid #e0f2fe;
		font-style: italic;
		line-height: 1.8;
		color: #64748b;
	}

	@media (max-width: 768px) {
		.temple-hero {
			padding: 4rem 1.5rem 5rem;
		}

		.temple-hero h1 {
			font-size: 2.5rem;
		}

		.temple-icon {
			font-size: 3rem;
		}

		.info-card {
			padding: 2rem 1.5rem;
		}
	}

	.info-card {
		background: white;
		padding: 3rem;
		border-radius: 16px;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
	}

	.info-card h2 {
		color: #1e3a8a;
		margin-bottom: 1.5rem;
		font-size: 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 2px solid #e2e8f0;
	}

	.info-card p {
		margin-bottom: 0.8rem;
		line-height: 1.6;
	}

	.map-placeholder {
		background: #f1f5f9;
		padding: 3rem;
		border-radius: 8px;
		text-align: center;
		margin-top: 1rem;
		border: 2px dashed #cbd5e1;
	}

	.schedule {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.schedule-item {
		padding: 1rem;
		background: #f8fafc;
		border-radius: 8px;
		border-left: 4px solid #3b82f6;
	}

	.schedule-item strong {
		display: block;
		color: #1e3a8a;
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}

	.schedule-item p {
		margin-bottom: 0.3rem;
		padding-left: 1rem;
	}

	.pastor-info h3 {
		color: #1e3a8a;
		font-size: 1.3rem;
		margin-bottom: 1rem;
	}

	.pastor-info .bio {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid #e2e8f0;
		font-style: italic;
	}

	@media (max-width: 768px) {
		.temple-hero h1 {
			font-size: 2rem;
		}
	}
</style>
