---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../assets/images';

// Contenido tomado de lacasadedios.cl/nosotros

const valores = [
	{ icon: 'lucide:heart', title: 'Amor', text: 'Reflejamos el amor de Dios en nuestras acciones diarias.' },
	{ icon: 'lucide:heart-handshake', title: 'Servicio', text: 'Servimos con dedicación, excelencia y disposición.' },
	{ icon: 'lucide:users', title: 'Unidad', text: 'Crecemos juntos en armonía, comunión y propósito.' },
	{ icon: 'lucide:handshake', title: 'Compromiso', text: 'Nos entregamos fielmente a la obra de Dios.' },
	{ icon: 'lucide:megaphone', title: 'Evangelismo', text: 'Compartimos el mensaje de salvación con convicción y alegría.' },
];

const liderazgo = [
	{ icon: 'lucide:user-round', title: 'Pastores', text: 'Guían la iglesia y su crecimiento espiritual por la Palabra de Dios.' },
	{ icon: 'lucide:shield-check', title: 'Ancianos', text: 'Brindan apoyo en la enseñanza y la consejería.' },
	{ icon: 'lucide:hand-helping', title: 'Diáconos', text: 'Sirven en la administración, apoyo logístico y enseñanza.' },
	{ icon: 'lucide:sparkles', title: 'Colaboradores', text: 'Apoyan en adoración, enseñanza y servicio general.' },
];

const personas = [
	{ group: 'Pastores', people: [
		{ name: 'Pastor Arturo Salas Olguín', place: 'Iglesia Matriz', slug: 'san-miguel' },
		{ name: 'Pastor Alberto Gutiérrez Plaza', place: 'Iglesia de Limache', slug: 'limache' },
		{ name: 'Pastor Manuel Silva Salas', place: 'Iglesia de Santiago Centro', slug: 'santiago-centro' },
	]},
	{ group: 'Ancianos', people: [
		{ name: 'Hermano Rubén Salas Orellana', place: 'San Miguel', slug: 'san-miguel' },
		{ name: 'Hermano Marcos Pezoa Pavez', place: 'San Miguel', slug: 'san-miguel' },
	]},
	{ group: 'Obreros', people: [
		{ name: 'Hermano Juan Enrique Plaza Morales', place: 'Coya', slug: 'coya' },
	]},
];

const credo = [
	{ icon: 'lucide:sun', title: 'Dios Padre', ref: '1ª Corintios 8:6a', text: 'Creemos en Dios Padre, de quien proceden todas las cosas.' },
	{ icon: 'lucide:crown', title: 'Jesucristo como Señor', ref: '1ª Corintios 8:6b', text: 'Creemos en Jesucristo como Señor, por quien son todas las cosas.' },
	{ icon: 'lucide:book-open', title: 'La Biblia', ref: '', text: 'La Biblia es la máxima autoridad en nuestra fe y práctica.' },
];

const sacramentos = [
	{ icon: 'lucide:droplets', title: 'El Bautismo', text: 'Como declaración pública de fe en Jesucristo.' },
	{ icon: 'lucide:wheat', title: 'La Santa Cena', text: 'Participación en memoria del sacrificio de Cristo.' },
];

const initials = (name: string) =>
	name.replace(/^(Pastor|Pastora|Hermano|Hermana|Rev\.?)\s+/i, '').split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---

<Layout
	title="Nosotros · La Casa de Dios"
	description="Conoce la misión, visión, valores, liderazgo y declaración de fe de La Casa de Dios."
>
	<PageHero image={IMG.congregacion} alt="Congregación en adoración" eyebrow="La Casa de Dios" title="Nosotros" subtitle="La Palabra de Dios es el fundamento de todo lo que hacemos." />

	<!-- Misión y Visión -->
	<section class="bg-base-100 px-4 py-24">
		<div class="container mx-auto max-w-6xl">
			<div class="grid gap-6 md:grid-cols-2">
				<Reveal>
					<div class="h-full rounded-3xl border border-base-300 bg-gradient-to-br from-primary/10 to-base-100 p-8">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15 text-primary">
							<Icon name="lucide:target" class="h-6 w-6" />
						</div>
						<h2 class="card-title text-3xl">Misión</h2>
						<p class="mt-3 text-lg leading-relaxed text-base-content/80">Predicar el evangelio, discipular creyentes y servir a otros con amor y excelencia.</p>
					</div>
				</Reveal>
				<Reveal delay={100}>
					<div class="h-full rounded-3xl border border-base-300 bg-gradient-to-br from-accent/10 to-base-100 p-8">
						<div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/15 text-accent">
							<Icon name="lucide:eye" class="h-6 w-6" />
						</div>
						<h2 class="card-title text-3xl">Visión</h2>
						<p class="mt-3 text-lg leading-relaxed text-base-content/80">Ser una iglesia vibrante que transforma vidas con el amor y la Palabra de Dios, extendiendo su Reino.</p>
					</div>
				</Reveal>
			</div>
		</div>
	</section>

	<!-- Valores -->
	<section class="bg-base-200 px-4 py-24">
		<div class="container mx-auto max-w-6xl">
			<SectionHeading eyebrow="Nuestros principios" title="Valores" />
			<div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
				{valores.map((v, i) => (
					<Reveal delay={(i % 5) * 70}>
						<div class="group h-full rounded-2xl border border-base-300 bg-base-100 p-6 text-center transition-all duration-300 hover:-translate-y-1.5 hover:shadow-lg">
							<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-content">
								<Icon name={v.icon} class="h-7 w-7" />
							</div>
							<h3 class="card-title justify-center text-xl">{v.title}</h3>
							<p class="mt-1 text-sm text-base-content/70">{v.text}</p>
						</div>
					</Reveal>
				))}
			</div>
		</div>
	</section>

	<!-- Estructura de liderazgo -->
	<section class="bg-base-100 px-4 py-24">
		<div class="container mx-auto max-w-6xl">
			<SectionHeading eyebrow="Cómo servimos" title="Estructura de liderazgo" tone="primary" />
			<div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{liderazgo.map((l, i) => (
					<Reveal delay={(i % 4) * 80}>
						<div class="h-full rounded-2xl border border-base-300 bg-base-100 p-7 text-center shadow-sm">
							<div class="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/10 text-accent">
								<Icon name={l.icon} class="h-7 w-7" />
							</div>
							<h3 class="card-title justify-center text-xl">{l.title}</h3>
							<p class="mt-1 text-sm text-base-content/70">{l.text}</p>
						</div>
					</Reveal>
				))}
			</div>
		</div>
	</section>

	<!-- Pastores y líderes -->
	<section class="bg-base-200 px-4 py-24">
		<div class="container mx-auto max-w-6xl">
			<SectionHeading eyebrow="Nuestro equipo" title="Pastores y líderes" subtitle="Quienes sirven al pueblo de Dios en cada templo." />
			<div class="mt-14 space-y-12">
				{personas.map((grupo) => (
					<div>
						<h3 class="mb-6 text-center font-display text-2xl font-bold text-primary">{grupo.group}</h3>
						<div class="mx-auto grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
							{grupo.people.map((p, i) => (
								<Reveal delay={(i % 3) * 80}>
									<a href={`/templos/${p.slug}`} class="flex h-full items-center gap-4 rounded-2xl border border-base-300 bg-base-100 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
										<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary to-secondary font-display text-lg font-bold text-primary-content">
											{initials(p.name)}
										</div>
										<div>
											<h4 class="font-bold leading-tight">{p.name}</h4>
											<p class="text-sm text-accent">{p.place}</p>
										</div>
									</a>
								</Reveal>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Declaración de fe (banda oscura) -->
	<section class="section-dark px-4 py-24">
		<div class="container mx-auto max-w-6xl">
			<SectionHeading eyebrow="Nuestras creencias" title="Declaración de fe" invert tone="accent" />
			<div class="mt-14 grid gap-6 md:grid-cols-3">
				{credo.map((c, i) => (
					<Reveal delay={(i % 3) * 90}>
						<div class="h-full rounded-2xl border border-white/10 bg-white/5 p-7 backdrop-blur-sm">
							<div class="mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/20 text-accent">
								<Icon name={c.icon} class="h-6 w-6" />
							</div>
							<h3 class="text-xl font-bold text-white">{c.title}</h3>
							{c.ref && <span class="mt-1 inline-block rounded-full border border-white/20 px-2 py-0.5 text-xs text-white/70">{c.ref}</span>}
							<p class="mt-2 text-white/75">{c.text}</p>
						</div>
					</Reveal>
				))}
			</div>
		</div>
	</section>

	<!-- Sacramentos -->
	<section class="bg-base-100 px-4 py-24">
		<div class="container mx-auto max-w-5xl">
			<SectionHeading eyebrow="Ordenanzas" title="Sacramentos" />
			<div class="mt-14 grid gap-6 md:grid-cols-2">
				{sacramentos.map((s, i) => (
					<Reveal delay={(i % 2) * 90}>
						<div class="flex h-full items-start gap-5 rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
							<div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-primary/10 text-primary">
								<Icon name={s.icon} class="h-7 w-7" />
							</div>
							<div>
								<h3 class="card-title text-2xl">{s.title}</h3>
								<p class="mt-1 text-base-content/80">{s.text}</p>
							</div>
						</div>
					</Reveal>
				))}
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="section-dark border-t border-white/10 px-4 py-20 text-center">
		<Reveal>
			<h2 class="font-display text-3xl font-bold text-white md:text-4xl">¿Quieres conocernos mejor?</h2>
			<p class="mx-auto mt-3 max-w-2xl text-white/70">Te invitamos a visitarnos y ser parte de nuestra familia de fe.</p>
			<div class="mt-8 flex flex-wrap justify-center gap-4">
				<a href="/#templos" class="btn btn-primary gap-2"><Icon name="lucide:church" class="h-5 w-5" /> Visita un templo</a>
				<a href="/" class="btn gap-2 border-white/60 bg-transparent text-white hover:bg-white hover:text-neutral">Volver al inicio</a>
			</div>
		</Reveal>
	</section>
</Layout>
