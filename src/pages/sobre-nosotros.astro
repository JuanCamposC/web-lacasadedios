---
import Layout from '../layouts/Layout.astro';
import { templos } from '../data/templos';

const valores = [
	{ icon: '✝️', title: 'Fe', text: 'Confiamos plenamente en la Palabra de Dios como nuestra guía absoluta.' },
	{ icon: '❤️', title: 'Amor', text: 'Amamos a Dios sobre todas las cosas y a nuestro prójimo como a nosotros mismos.' },
	{ icon: '✨', title: 'Santidad', text: 'Vivimos vidas apartadas para Dios, reflejando Su carácter.' },
	{ icon: '🤝', title: 'Unidad', text: 'Cultivamos la comunión fraterna y la unidad del cuerpo de Cristo.' },
	{ icon: '🙏', title: 'Servicio', text: 'Servimos con humildad siguiendo el ejemplo de Jesús.' },
	{ icon: '⭐', title: 'Excelencia', text: 'Hacemos todo con excelencia para la gloria de Dios.' },
];

const credo = [
	{ icon: '📜', title: 'La Biblia', border: 'border-primary', text: 'Creemos que la Biblia es la Palabra inspirada e infalible de Dios, nuestra única regla de fe y conducta.' },
	{ icon: '🌟', title: 'Dios', border: 'border-secondary', text: 'Creemos en un solo Dios eternamente existente en tres personas: Padre, Hijo y Espíritu Santo.' },
	{ icon: '✝️', title: 'Jesucristo', border: 'border-accent', text: 'Creemos en la deidad de nuestro Señor Jesucristo, su nacimiento virginal, su vida sin pecado, su muerte expiatoria, su resurrección corporal y su segunda venida.' },
	{ icon: '🕊️', title: 'El Espíritu Santo', border: 'border-primary', text: 'Creemos en la persona y obra del Espíritu Santo, quien convence de pecado, regenera y capacita al creyente para vivir una vida santa.' },
	{ icon: '💝', title: 'La Salvación', border: 'border-secondary', text: 'Creemos que la salvación es un regalo de Dios por gracia mediante la fe en Jesucristo, no por obras.' },
	{ icon: '⛪', title: 'La Iglesia', border: 'border-accent', text: 'Creemos en la iglesia universal, el cuerpo de Cristo, compuesta por todos los verdaderos creyentes en Jesucristo.' },
];
---

<Layout
	title="Sobre nosotros · La Casa de Dios"
	description="Conoce la visión, misión, valores y declaración de fe de La Casa de Dios, y a los pastores de nuestros templos."
>
	<!-- Hero -->
	<section class="hero min-h-[45vh] bg-gradient-to-br from-primary/15 via-base-100 to-accent/15">
		<div class="hero-content text-center">
			<div class="max-w-4xl animate-fade-in-up">
				<div class="badge badge-accent badge-lg mb-4">Nuestra historia</div>
				<h1 class="font-display text-5xl md:text-7xl font-bold mb-6 text-primary">Sobre nosotros</h1>
				<p class="text-xl md:text-2xl opacity-80 max-w-2xl mx-auto">
					La Palabra de Dios es el fundamento de todo lo que hacemos.
				</p>
				<p class="text-sm md:text-base mt-4 italic opacity-60">
					"Porque donde dos o tres se reúnen en mi nombre, allí estoy yo en medio de ellos" — Mateo 18:20
				</p>
			</div>
		</div>
	</section>

	<!-- Visión y Misión -->
	<section class="py-20 bg-base-100">
		<div class="container mx-auto px-4 max-w-7xl">
			<div class="grid md:grid-cols-2 gap-8">
				<div class="card bg-gradient-to-br from-primary/10 to-primary/5 shadow-xl hover:shadow-2xl transition-all duration-300">
					<div class="card-body">
						<div class="flex items-center gap-4 mb-4">
							<div class="bg-primary text-primary-content p-4 rounded-full">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
							</div>
							<h2 class="card-title text-3xl font-display">Nuestra visión</h2>
						</div>
						<p class="text-lg leading-relaxed opacity-80">
							Ser una iglesia que transforma vidas a través del poder del Evangelio de
							Jesucristo, alcanzando a nuestra comunidad con el amor de Dios y siendo un
							faro de esperanza donde cada persona encuentre su propósito en Cristo y
							crezca en su fe.
						</p>
					</div>
				</div>

				<div class="card bg-gradient-to-br from-accent/10 to-accent/5 shadow-xl hover:shadow-2xl transition-all duration-300">
					<div class="card-body">
						<div class="flex items-center gap-4 mb-4">
							<div class="bg-accent text-accent-content p-4 rounded-full">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
							</div>
							<h2 class="card-title text-3xl font-display">Nuestra misión</h2>
						</div>
						<p class="text-lg leading-relaxed opacity-80">
							En La Casa de Dios buscamos vivir y compartir Su verdad, crecer en la fe y
							servir con amor conforme a Su propósito: adorar a Dios, proclamar el
							Evangelio, discipular a los creyentes y equipar a cada miembro para el
							servicio cristiano.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Valores -->
	<section class="py-20 bg-gradient-to-b from-base-100 to-base-200">
		<div class="container mx-auto px-4 max-w-7xl">
			<div class="text-center mb-16">
				<div class="badge badge-accent badge-lg mb-4">Nuestros principios</div>
				<h2 class="font-display text-4xl md:text-5xl font-bold mb-4">Nuestros valores</h2>
				<p class="text-xl opacity-70 max-w-2xl mx-auto">Los valores que guían cada aspecto de nuestra vida como iglesia</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{valores.map((v) => (
					<div class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2">
						<div class="card-body items-center text-center">
							<div class="text-5xl mb-4">{v.icon}</div>
							<h3 class="card-title text-2xl">{v.title}</h3>
							<p class="text-base opacity-80">{v.text}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Pastores (datos reales de los templos) -->
	<section class="py-20 bg-base-100">
		<div class="container mx-auto px-4 max-w-7xl">
			<div class="text-center mb-16">
				<div class="badge badge-primary badge-lg mb-4">Nuestro equipo</div>
				<h2 class="font-display text-4xl md:text-5xl font-bold mb-4">Pastores y obreros</h2>
				<p class="text-xl opacity-70 max-w-2xl mx-auto">Sirviendo con dedicación en cada uno de nuestros templos</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				{templos.map((t) => (
					<a href={`/templos/${t.slug}`} class="card bg-gradient-to-br from-primary/10 to-base-100 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-2 border border-base-300">
						<div class="card-body items-center text-center">
							<div class="avatar placeholder mb-2">
								<div class="bg-primary text-primary-content rounded-full w-20"><span class="text-3xl">👤</span></div>
							</div>
							<h3 class="card-title text-lg">{t.leader.name}</h3>
							<p class="font-semibold text-primary text-sm">{t.leader.role}</p>
							<p class="text-sm opacity-70">{t.short} · {t.region}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Declaración de Fe -->
	<section class="py-20 bg-gradient-to-b from-base-200 to-base-100">
		<div class="container mx-auto px-4 max-w-7xl">
			<div class="text-center mb-16">
				<div class="badge badge-secondary badge-lg mb-4">Nuestras creencias</div>
				<h2 class="font-display text-4xl md:text-5xl font-bold mb-4">Declaración de fe</h2>
				<p class="text-xl opacity-70 max-w-2xl mx-auto">Los fundamentos doctrinales que guían nuestra fe</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
				{credo.map((c) => (
					<div class={`card bg-base-100 shadow-lg border-l-4 ${c.border} hover:shadow-xl transition-all`}>
						<div class="card-body">
							<h3 class="card-title text-xl flex items-center gap-2">
								<span class="text-2xl">{c.icon}</span>
								{c.title}
							</h3>
							<p class="opacity-80">{c.text}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Sacramentos -->
	<section class="py-20 bg-base-100">
		<div class="container mx-auto px-4 max-w-7xl">
			<div class="text-center mb-16">
				<div class="badge badge-accent badge-lg mb-4">Ordenanzas</div>
				<h2 class="font-display text-4xl md:text-5xl font-bold mb-4">Sacramentos</h2>
				<p class="text-xl opacity-70 max-w-2xl mx-auto">Las ordenanzas que Cristo estableció para su iglesia</p>
			</div>

			<div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
				<div class="card bg-gradient-to-br from-primary/5 to-base-100 shadow-xl hover:shadow-2xl transition-all duration-300">
					<div class="card-body">
						<div class="flex items-center gap-4 mb-4">
							<div class="bg-primary/20 p-4 rounded-full"><span class="text-5xl">💧</span></div>
							<h3 class="card-title text-2xl">El Bautismo</h3>
						</div>
						<p class="text-lg leading-relaxed opacity-80">
							Practicamos el bautismo por inmersión como testimonio público de fe en
							Jesucristo. Es un acto de obediencia que simboliza la muerte al pecado y el
							nacimiento a una nueva vida en Cristo, para quienes han hecho una profesión
							consciente de fe.
						</p>
					</div>
				</div>

				<div class="card bg-gradient-to-br from-accent/5 to-base-100 shadow-xl hover:shadow-2xl transition-all duration-300">
					<div class="card-body">
						<div class="flex items-center gap-4 mb-4">
							<div class="bg-accent/20 p-4 rounded-full"><span class="text-5xl">🍞</span></div>
							<h3 class="card-title text-2xl">La Santa Cena</h3>
						</div>
						<p class="text-lg leading-relaxed opacity-80">
							Celebramos la Santa Cena como memorial de la muerte de Cristo y proclamación
							de su segunda venida. El pan representa su cuerpo y la copa su sangre
							derramada para el perdón de pecados: un tiempo de reflexión y comunión.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-20 bg-gradient-to-br from-primary/15 via-accent/10 to-secondary/15">
		<div class="container mx-auto px-4 max-w-4xl text-center">
			<h2 class="font-display text-4xl md:text-5xl font-bold mb-6">¿Quieres conocernos mejor?</h2>
			<p class="text-xl opacity-80 mb-8 max-w-2xl mx-auto">
				Te invitamos a visitarnos y ser parte de nuestra familia. Estamos seguros de que
				Dios tiene un propósito maravilloso para tu vida.
			</p>
			<div class="flex flex-wrap gap-4 justify-center">
				<a href="/#templos" class="btn btn-primary btn-lg gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
					Visítanos
				</a>
				<a href="/" class="btn btn-outline btn-lg">Volver al inicio</a>
			</div>
		</div>
	</section>
</Layout>
