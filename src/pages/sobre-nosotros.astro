---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { IMG } from '../assets/images';
import { HISTORIA } from '../data/historia';
import { SITE } from '../data/site';

// Contenido tomado de lacasadedios.cl/nosotros

const secciones = [
  { href: '#fe', label: 'Declaración de fe' },
  { href: '#estructura', label: 'Estructura de liderazgo' },
  { href: '#sacramentos', label: 'Sacramentos' },
  { href: '#mision', label: 'Misión y visión' },
  { href: '#historia', label: 'Historia' },
  { href: '#valores', label: 'Valores' },
  { href: '#liderazgo', label: 'Pastores' },
];

const valores = [
  {
    icon: 'lucide:heart',
    title: 'Amor',
    text: 'Reflejamos el amor de Dios en nuestras acciones diarias.',
  },
  {
    icon: 'lucide:heart-handshake',
    title: 'Servicio',
    text: 'Servimos con dedicación, excelencia y disposición.',
  },
  {
    icon: 'lucide:users',
    title: 'Unidad',
    text: 'Crecemos juntos en armonía, comunión y propósito.',
  },
  {
    icon: 'lucide:handshake',
    title: 'Compromiso',
    text: 'Nos entregamos fielmente a la obra de Dios.',
  },
  {
    icon: 'lucide:megaphone',
    title: 'Evangelismo',
    text: 'Compartimos el mensaje de salvación con convicción y alegría.',
  },
];

const liderazgo = [
  {
    icon: 'lucide:user-round',
    title: 'Pastores',
    text: 'Guían la iglesia y su crecimiento espiritual por la Palabra de Dios.',
  },
  {
    icon: 'lucide:shield-check',
    title: 'Ancianos',
    text: 'Brindan apoyo en la enseñanza y la consejería.',
  },
  {
    icon: 'lucide:hand-helping',
    title: 'Diáconos',
    text: 'Sirven en la administración, apoyo logístico y enseñanza.',
  },
  {
    icon: 'lucide:sparkles',
    title: 'Colaboradores',
    text: 'Apoyan en adoración, enseñanza y servicio general.',
  },
];

// Solo los pastores. Los ancianos y el obrero se muestran en la ficha de su
// templo (ver `leader` en src/data/templos.ts), que es donde tienen contexto.
const pastores = [
  { name: 'Pastor Arturo Salas Olguín', place: 'Iglesia Matriz', slug: 'san-miguel' },
  { name: 'Pastor Alberto Gutiérrez Plaza', place: 'Iglesia de Limache', slug: 'limache' },
  {
    name: 'Pastor Manuel Silva Salas',
    place: 'Iglesia de Santiago Centro',
    slug: 'santiago-centro',
  },
];

const credo = [
  {
    icon: 'lucide:sun',
    title: 'Dios Padre',
    ref: '1ª Corintios 8:6a',
    text: 'Creemos en Dios Padre, de quien proceden todas las cosas.',
  },
  {
    icon: 'lucide:crown',
    title: 'Jesucristo como Señor',
    ref: '1ª Corintios 8:6b',
    text: 'Creemos en Jesucristo como Señor, por quien son todas las cosas.',
  },
  {
    icon: 'lucide:book-open',
    title: 'La Biblia',
    ref: '',
    text: 'La Biblia es la máxima autoridad en nuestra fe y práctica.',
  },
];

const sacramentos = [
  {
    icon: 'lucide:droplets',
    title: 'El Bautismo',
    text: 'Como declaración pública de fe en Jesucristo.',
  },
  {
    icon: 'lucide:wheat',
    title: 'La Santa Cena',
    text: 'Participación en memoria del sacrificio de Cristo.',
  },
];

const initials = (name: string) =>
  name
    .replace(/^(Pastor|Pastora|Hermano|Hermana|Rev\.?)\s+/i, '')
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
---

<Layout
  title="Nosotros · La Casa de Dios"
  description="Conoce la historia, misión, visión, valores, liderazgo y declaración de fe de La Casa de Dios."
>
  <PageHero
    image={IMG.congregacion}
    alt="Congregación en adoración"
    eyebrow="La Casa de Dios"
    title="Nosotros"
    subtitle={SITE.claim}
  />

  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Nosotros' }]} />

  <!-- Índice de la página -->
  <nav
    aria-label="Secciones de la página"
    class="sticky top-16 z-30 border-b border-base-300 bg-base-100/90 backdrop-blur-md"
  >
    {
      /* El desplazamiento vive aquí y no en el `.wrap`: así los chips llegan
         hasta el borde de la pantalla en vez de cortarse contra un ancho
         centrado, que era lo que hacía parecer roto el último. Desde `md`
         dejan de desplazarse y se reparten en varias líneas. */
    }
    <div class="indice wrap overflow-x-auto px-4 py-3">
      <ul
        class="flex w-max items-center gap-2 pe-8 md:w-full md:flex-wrap md:justify-center md:pe-0"
      >
        {
          secciones.map((s) => (
            <li class="shrink-0">
              <a
                href={s.href}
                class="rounded-full border border-base-300 px-4 py-1.5 text-sm font-medium transition hover:border-primary hover:text-primary"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- Declaración de fe (banda oscura) -->
  <section id="fe" class="section-dark section">
    <div class="wrap">
      <SectionHeading eyebrow="Nuestras creencias" title="Declaración de fe" invert tone="accent" />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          credo.map((c, i) => (
            <Reveal delay={(i % 3) * 90} class="h-full">
              <div class="panel-invert h-full p-7">
                <div class="mb-3 tile tile-accent">
                  <Icon name={c.icon} class="h-6 w-6" />
                </div>
                <h3 class="text-xl font-bold text-white">{c.title}</h3>
                {c.ref && (
                  <span class="mt-1 inline-block rounded-full border border-white/20 px-2 py-0.5 text-xs text-white/70">
                    {c.ref}
                  </span>
                )}
                <p class="mt-2 text-white/75">{c.text}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Estructura de liderazgo -->
  <section id="estructura" class="section bg-base-100">
    <div class="wrap">
      <SectionHeading eyebrow="Cómo servimos" title="Estructura de liderazgo" tone="primary" />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          liderazgo.map((l, i) => (
            <Reveal delay={(i % 4) * 80} class="h-full">
              <div class="panel panel-sm h-full p-7 text-center">
                <div class="mx-auto mb-3 tile tile-lg tile-accent">
                  <Icon name={l.icon} class="h-7 w-7" />
                </div>
                <h3 class="card-title justify-center text-xl">{l.title}</h3>
                <p class="mt-1 text-sm text-base-content/70">{l.text}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sacramentos -->
  <section id="sacramentos" class="section bg-base-200">
    <div class="wrap">
      <SectionHeading eyebrow="Las dos ordenanzas" title="Sacramentos" />
      <div class="mx-auto mt-12 grid max-w-4xl gap-5 md:grid-cols-2">
        {
          sacramentos.map((s, i) => (
            <Reveal delay={(i % 2) * 90} class="h-full">
              <div class="panel panel-sm flex h-full items-start gap-5 p-7">
                <div class="tile tile-accent">
                  <Icon name={s.icon} class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="card-title text-xl">{s.title}</h3>
                  <p class="mt-1 text-base-content/70">{s.text}</p>
                </div>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Misión y Visión -->
  <section id="mision" class="section bg-base-100">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-2">
        <Reveal>
          <div
            class="h-full rounded-xl border border-base-300 bg-gradient-to-br from-primary/10 to-base-100 p-8"
          >
            <div class="mb-4 tile">
              <Icon name="lucide:target" class="h-6 w-6" />
            </div>
            <h2 class="card-title text-3xl">Misión</h2>
            <p class="mt-3 text-lg leading-relaxed text-base-content/80">
              Predicar el evangelio, discipular creyentes y servir a otros con amor y excelencia.
            </p>
          </div>
        </Reveal>
        <Reveal delay={100}>
          <div
            class="h-full rounded-xl border border-base-300 bg-gradient-to-br from-accent/10 to-base-100 p-8"
          >
            <div class="mb-4 tile tile-accent">
              <Icon name="lucide:eye" class="h-6 w-6" />
            </div>
            <h2 class="card-title text-3xl">Visión</h2>
            <p class="mt-3 text-lg leading-relaxed text-base-content/80">
              Ser una iglesia vibrante que transforma vidas con el amor y la Palabra de Dios,
              extendiendo su Reino.
            </p>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section id="historia" class="section bg-base-200">
    <div class="wrap">
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <Reveal class="lg:col-span-5">
          <div class="relative overflow-hidden rounded-xl">
            <Image
              src={IMG[HISTORIA.imagen]}
              alt="Biblia abierta"
              widths={[500, 900]}
              sizes="(max-width:1024px) 100vw, 40vw"
              class="aspect-[4/3] w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/45 to-transparent"></div>
          </div>
        </Reveal>

        <div class="lg:col-span-7">
          <SectionHeading
            eyebrow={HISTORIA.eyebrow}
            title={HISTORIA.title}
            subtitle={HISTORIA.lead}
            align="left"
            tone="primary"
          />
          <div data-reveal data-reveal-delay="90" class="prose-lcd mt-6">
            {HISTORIA.parrafos.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </div>

      {
        HISTORIA.hitos.length > 0 && (
          <ol class="relative mt-16 space-y-8 border-l border-base-300 pl-6 sm:pl-8">
            {HISTORIA.hitos.map((h, i) => (
              <li data-reveal data-reveal-delay={Math.min(i, 5) * 70} class="relative">
                <span class="absolute -left-[1.85rem] top-1.5 flex h-3.5 w-3.5 items-center justify-center rounded-full bg-primary ring-4 ring-base-200 sm:-left-[2.35rem]" />
                <span class="eyebrow text-accent">{h.year}</span>
                <h3 class="mt-1 font-display text-xl">{h.title}</h3>
                <p class="mt-1 text-base-content/75">{h.text}</p>
                {h.templo && (
                  <a
                    href={`/templos/${h.templo}`}
                    class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent"
                  >
                    <Icon name="lucide:map-pin" class="h-4 w-4" /> Ver el templo
                  </a>
                )}
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>

  <!-- Valores -->
  <section id="valores" class="section bg-base-100">
    <div class="wrap">
      <SectionHeading eyebrow="Nuestros principios" title="Valores" />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
        {
          valores.map((v, i) => (
            <Reveal delay={(i % 5) * 70} class="h-full">
              <div class="panel panel-sm panel-lift group h-full p-6 text-center">
                <div class="mx-auto mb-4 tile tile-lg transition-colors group-hover:bg-primary group-hover:text-primary-content">
                  <Icon name={v.icon} class="h-7 w-7" />
                </div>
                <h3 class="card-title justify-center text-xl">{v.title}</h3>
                <p class="mt-1 text-sm text-base-content/70">{v.text}</p>
              </div>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pastores y líderes -->
  <section id="liderazgo" class="section bg-base-200">
    <div class="wrap">
      <SectionHeading
        eyebrow="Nuestro equipo"
        title="Pastores"
        subtitle="Quienes pastorean cada templo de la congregación."
      />
      <div class="mx-auto mt-12 grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          pastores.map((p, i) => (
            <Reveal delay={(i % 3) * 80} class="h-full">
              <a
                href={`/templos/${p.slug}`}
                class="panel panel-sm panel-lift flex h-full items-center gap-4 p-5"
              >
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary to-secondary font-data text-lg font-bold text-primary-content">
                  {initials(p.name)}
                </div>
                <div class="min-w-0">
                  <h4 class="font-bold leading-tight">{p.name}</h4>
                  <p class="text-sm text-accent">{p.place}</p>
                </div>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Da el primer paso"
    title="¿Quieres conocernos mejor?"
    text="Te invitamos a visitarnos y ser parte de nuestra familia de fe."
    image={IMG.manosAlzadas}
    compact
  >
    <a href="/templos" class="btn btn-primary gap-2"
      ><Icon name="lucide:church" class="h-5 w-5" /> Visita un templo</a
    >
    <a href="/contacto" class="btn gap-2 btn-invert">
      <Icon name="lucide:mail" class="h-5 w-5" /> Escríbenos
    </a>
  </CtaBand>
</Layout>

<style>
  /* Esta página suma navbar fijo (4rem) + índice pegajoso (~3,3rem):
	   los anclajes necesitan más margen que el global. */
  section[id] {
    scroll-margin-top: 9rem;
  }
</style>
