---
export const prerender = false;

// La página se arma en cada visita porque los audios viven en RSS.com y ahí
// aparece uno nuevo cada semana. Para que eso no signifique un viaje a un
// servidor ajeno por cada visita, la CDN de Cloudflare la sirve ya hecha
// durante un minuto y sigue sirviéndola hasta diez minutos más mientras la
// rehace por detrás. Además `leerFeed` guarda la respuesta de rss.com cinco
// minutos en el borde (ver src/lib/rss.ts).
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Reveal from '../components/Reveal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EmptyState from '../components/EmptyState.astro';
import CtaBand from '../components/CtaBand.astro';
import ListaEstudios from '../components/ListaEstudios.astro';
import { IMG } from '../assets/images';
import { ESTUDIO } from '../data/estudio';
import { templos, correoDe } from '../data/templos';
import { SOCIAL } from '../data/site';
import { leerFeed } from '../lib/rss';
import { baseDeDatos } from '../lib/base';
import { reunionesPublicadas, guidsOcultos } from '../lib/datos';
import { DIAS, type Reunion } from '../lib/reuniones';

/**
 * Cuántas grabaciones se enseñan.
 *
 * El tope no es una precaución teórica: probando con un feed real de 355
 * episodios, esta página medía 336 664 px de alto —trescientas setenta y cuatro
 * pantallas— y traía 355 reproductores.
 *
 * Los que pasan del tope NO se mandan a RSS.com: los audios tienen que poder
 * escucharse solo desde esta página. Van dentro de un desplegable cerrado, que
 * no pesa nada hasta que alguien lo abre (`preload="none"` en cada audio).
 */
const MAXIMO = 12;

const feed = await leerFeed();

/*
 * Los episodios que el panel marcó como ocultos no llegan a la página.
 *
 * RSS.com no sabe ocultar: un episodio está publicado o borrado, no hay
 * término medio. Así que lo que se esconde acá sigue publicado allá y en
 * todas las aplicaciones de podcast; lo único que cambia es que no aparece en
 * lacasadedios.cl. Se marca en /admin/estudios.
 *
 * Si la base no responde no se esconde nada, y es lo correcto: lo normal es
 * que no haya ninguno oculto, y dejar la página sin audios por un fallo de la
 * base sería peor que enseñar de más algo que casi nunca hay.
 */
let ocultos = new Set<string>();
try {
  ocultos = await guidsOcultos(await baseDeDatos());
} catch (e) {
  console.error('[estudio-biblico] ocultos', e);
}
const visibles = (feed?.episodios ?? []).filter((e) => !ocultos.has(e.guid));

const episodios = visibles.slice(0, MAXIMO);
const anteriores = visibles.slice(MAXIMO);

// La descripción del programa, tal como se escribió en RSS.com. Sin texto de
// respaldo: si allá no hay nada, la sección enseña solo el nombre.
const descripcion = feed?.descripcion?.trim() ?? '';

const sanMiguel = templos.find((t) => t.estudio === 'presencial')!;
const porZoom = templos.filter((t) => t.estudio === 'zoom');

/*
 * El día y la hora salen de la base, no de este archivo.
 *
 * Son los mismos datos que edita el panel en /admin/horarios, así que un
 * cambio de horario se ve acá sin que nadie se acuerde de esta página. Antes
 * el «todos los lunes a las 20:00» estaba escrito a mano en el encabezado y
 * habría quedado mintiendo el día que cambiara.
 *
 * Se buscan por nombre porque la tabla no marca cuál es el estudio. Se usa
 * `ESTUDIO.corto` («Instituto Bíblico») y no el nombre completo para que
 * siga calzando si en el panel le agregan o le quitan el «Bet-El».
 */
let reuniones: Reunion[] = [];
try {
  reuniones = await reunionesPublicadas(await baseDeDatos());
} catch (e) {
  // Sin base, las tarjetas se enseñan sin horario en vez de caerse.
  console.error('[estudio-biblico]', e);
}

const delEstudio = reuniones.filter((r) => r.nombre.includes(ESTUDIO.corto));
const horarioDe = (slug: string) => delEstudio.find((r) => r.templo === slug);

/** «Lunes · 20:00», o nada si ese templo no tiene el estudio en la base. */
function cuandoEn(slug: string): string | null {
  const r = horarioDe(slug);
  return r ? `${DIAS[r.dia]} · ${r.hora}` : null;
}

/**
 * Un aviso solo si lo hay: reunión suspendida o cambiada esta semana.
 * Lo escribe quien edita los horarios, y aparece tal cual.
 */
const avisoDe = (slug: string) => horarioDe(slug)?.aviso ?? null;

// Los tres templos por Zoom con su horario, para no repetir la hora cuatro
// veces cuando coinciden ni callarla cuando no.
const zoomConHorario = porZoom.map((t) => ({ templo: t, cuando: cuandoEn(t.slug) }));
const horasZoom = [...new Set(zoomConHorario.map((z) => z.cuando).filter(Boolean))];
const zoomCoincide = horasZoom.length === 1;

/*
 * Lo demás que pasa en San Miguel durante la semana.
 *
 * Va en la tarjeta del templo presencial y no en la de Zoom porque es lo
 * único que se puede decir de un templo al que se LLEGA: quien viene al
 * estudio el lunes está a un paso de saber que el jueves hay reunión. A los
 * otros tres se entra por un enlace, y su semana la cuenta su propia ficha.
 *
 * Sale de la misma consulta de arriba, así que no cuesta otra visita a la
 * base, y se actualiza sola cuando alguien cambie los horarios en el panel.
 */
const otrasEnSanMiguel = reuniones.filter(
  (r) => r.templo === sanMiguel.slug && !r.nombre.includes(ESTUDIO.corto),
);
const asuntoZoom = encodeURIComponent('Enlace del estudio bíblico por Zoom');

const youtube = SOCIAL.find((s) => s.key === 'youtube')!;
---

<Layout
  title={`${ESTUDIO.programa} · La Casa de Dios`}
  description="Todos los lunes abrimos juntos la Palabra de Dios en los cuatro templos de La Casa de Dios. Presencial en San Miguel y por Zoom en Santiago Centro, Limache y Coya. Escucha los estudios grabados."
>
  <PageHero
    image={IMG.estudioPortada}
    alt="Biblia y cuaderno abiertos sobre una mesa"
    eyebrow={ESTUDIO.eyebrow}
    title={ESTUDIO.titulo}
    subtitle={ESTUDIO.bajada}
    height="min-h-[52vh]"
  />

  <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: ESTUDIO.corto }]} />

  <!-- ══ Qué es y qué esperar ════════════════════════════════════════════ -->
  <section class="section bg-base-100">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:items-start">
      <Reveal>
        <div class="max-w-prose space-y-5">
          {
            ESTUDIO.introduccion.map((parrafo, i) => (
              <p
                class={i === 0 ? 'text-lg leading-relaxed' : 'leading-relaxed text-base-content/80'}
              >
                {parrafo}
              </p>
            ))
          }
        </div>
      </Reveal>

      <Reveal delay={120}>
        <div class="panel p-7">
          <h2 class="font-display text-xl">Si vienes por primera vez</h2>
          <ul class="mt-5 space-y-5">
            {
              ESTUDIO.queEsperar.map((item) => (
                <li class="flex gap-4">
                  <span class="tile tile-accent shrink-0">
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-bold">{item.titulo}</h3>
                    <p class="mt-0.5 text-sm text-base-content/70">{item.texto}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ══ Lo que se está estudiando ═══════════════════════════════════════ -->
  <section class="section bg-base-200">
    <div class="wrap">
      <SectionHeading eyebrow="En curso" title={ESTUDIO.programa} align="left" />
      {
        descripcion && (
          <Reveal>
            <p class="mt-6 max-w-prose leading-relaxed whitespace-pre-line text-base-content/85">
              {descripcion}
            </p>
          </Reveal>
        )
      }
    </div>
  </section>

  <!-- ══ Audios y recursos ═══════════════════════════════════════════════
       Va acá arriba, antes de «cómo participar», y no al final: es lo que
       viene a buscar quien ya conoce el estudio, que son casi todos los que
       vuelven a esta página.
  ══════════════════════════════════════════════════════════════════════ -->
  <section id="audios" class="section bg-base-100">
    <div class="wrap">
      <SectionHeading
        eyebrow="Grabaciones"
        title={ESTUDIO.audios.titulo}
        subtitle={ESTUDIO.audios.texto}
      />

      {
        /* La portada del programa, tal como se ve en las aplicaciones de
           podcast. No pasa por <Image /> porque no es un archivo del
           repositorio sino una dirección de rss.com, y Astro solo optimiza lo
           que tiene en disco al compilar. */
        feed?.imagen && (
          <Reveal class="mt-10 flex justify-center">
            <img
              src={feed.imagen}
              alt={`Portada de ${ESTUDIO.programa}`}
              width="176"
              height="176"
              loading="lazy"
              decoding="async"
              class="h-44 w-44 rounded-2xl border border-base-300 object-cover shadow-md"
            />
          </Reveal>
        )
      }

      {
        /* Se mira la lista, no el feed: un programa recién creado se lee
           perfectamente y todavía no tiene ni un episodio. */
        episodios.length === 0 ? (
          <Reveal class="mt-12">
            <EmptyState
              icon="lucide:headphones"
              title="Todavía no hay estudios publicados"
              text="En cuanto subamos la primera grabación aparecerá acá. Mientras tanto, te esperamos el lunes."
            />
          </Reveal>
        ) : (
          <ListaEstudios estudios={episodios} class="mt-12" />
        )
      }

      {
        anteriores.length > 0 && (
          <details class="group/ant mt-10">
            <summary class="btn btn-outline mx-auto flex w-fit cursor-pointer list-none gap-2 [&::-webkit-details-marker]:hidden">
              <span class="group-open/ant:hidden">Ver {anteriores.length} estudios anteriores</span>
              <span class="hidden group-open/ant:inline">Ocultar los anteriores</span>
              <Icon
                name="lucide:chevron-down"
                class="h-4 w-4 transition-transform group-open/ant:rotate-180"
              />
            </summary>
            <ListaEstudios estudios={anteriores} class="mt-8" />
          </details>
        )
      }
    </div>
  </section>

  <!-- ══ Cómo participar ═════════════════════════════════════════════════
       Dos tarjetas y poco texto. Antes eran una tarjeta grande con foto, tres
       tarjetas de templo y cuatro párrafos; para decir dos cosas —a San Miguel
       se va, al resto se pide el enlace— era demasiado.
  ══════════════════════════════════════════════════════════════════════ -->
  <section id="participar" class="section bg-base-200">
    <div class="wrap">
      {
        /* El encabezado ya no dice el día ni la hora: eso lo dice cada
          tarjeta con el dato de su templo, sacado de la base. Repetirlo
          arriba obligaba a mantener la misma frase en dos sitios. */
      }
      <SectionHeading
        eyebrow="Cómo participar"
        title="Dos maneras, según tu templo"
        subtitle="A San Miguel se llega y ya está. En los otros tres se entra por Zoom con un enlace que se pide."
      />

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        <Reveal class="h-full">
          <div class="panel flex h-full flex-col p-7">
            <span class="badge badge-primary badge-sm w-fit gap-1.5">
              <Icon name="lucide:map-pin" class="h-3.5 w-3.5" /> Presencial
            </span>
            <h3 class="mt-3 font-display text-xl">{sanMiguel.short}</h3>
            <p class="mt-1 text-sm text-base-content/70">{sanMiguel.address}</p>

            {
              /* El dato que trae a alguien hasta acá: cuándo. Va primero y
                grande; lo demás de la tarjeta explica, esto se consulta. */
            }
            {
              cuandoEn(sanMiguel.slug) && (
                <p class="mt-5 flex items-center gap-2 font-data text-lg font-semibold text-primary">
                  <Icon name="lucide:calendar-clock" class="h-5 w-5 shrink-0" />
                  {cuandoEn(sanMiguel.slug)}
                </p>
              )
            }
            {
              avisoDe(sanMiguel.slug) && (
                <p class="mt-2 text-sm font-medium text-warning">{avisoDe(sanMiguel.slug)}</p>
              )
            }

            <p class="mt-4 text-base-content/85">{ESTUDIO.participar.presencial}</p>

            {
              otrasEnSanMiguel.length > 0 && (
                <div class="mt-6 border-t border-base-300 pt-5">
                  <p class="text-xs font-semibold tracking-wider text-base-content/70 uppercase">
                    El resto de la semana en este templo
                  </p>
                  <ul class="mt-3 space-y-1.5">
                    {otrasEnSanMiguel.map((r) => (
                      <li class="flex flex-wrap items-baseline gap-x-2 text-sm">
                        <span class="font-data w-20 shrink-0 text-base-content/70">
                          {DIAS[r.dia]}
                        </span>
                        <span class="font-data font-semibold tabular-nums">{r.hora}</span>
                        <span class="text-base-content/80">{r.nombre}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              <a href={`/templos/${sanMiguel.slug}`} class="btn btn-sm btn-primary gap-1.5">
                Cómo llegar <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
              <a
                href={sanMiguel.mapLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-ghost btn-sm gap-1.5"
              >
                <Icon name="lucide:navigation" class="h-4 w-4" /> Abrir en el mapa
              </a>
            </div>
          </div>
        </Reveal>

        <Reveal delay={90} class="h-full">
          <div class="panel flex h-full flex-col p-7">
            <span class="badge badge-secondary badge-sm w-fit gap-1.5">
              <Icon name="lucide:video" class="h-3.5 w-3.5" /> Por Zoom
            </span>
            <h3 class="mt-3 font-display text-xl">
              {
                porZoom
                  .map((t) => t.short)
                  .join(', ')
                  .replace(/, ([^,]*)$/, ' y $1')
              }
            </h3>
            {
              /* Si los tres coinciden, la hora va una vez. Si algún templo
                cambia la suya, se enseña templo por templo en vez de
                enseñar una hora que sería falsa para uno de los tres. */
            }
            {
              zoomCoincide ? (
                <p class="mt-5 flex items-center gap-2 font-data text-lg font-semibold text-secondary">
                  <Icon name="lucide:calendar-clock" class="h-5 w-5 shrink-0" />
                  {horasZoom[0]}
                </p>
              ) : (
                <ul class="mt-5 space-y-1">
                  {zoomConHorario.map(({ templo, cuando }) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-3 text-sm">
                      <span class="text-base-content/80">{templo.short}</span>
                      <span class="font-data font-semibold text-secondary">{cuando ?? '—'}</span>
                    </li>
                  ))}
                </ul>
              )
            }

            <p class="mt-4 text-base-content/85">{ESTUDIO.participar.zoom}</p>
            <p class="mt-3 text-sm text-base-content/70">{ESTUDIO.participar.porQue}</p>

            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              {
                porZoom.map((t) => (
                  <a
                    href={`/contacto?asunto=${asuntoZoom}&templo=${encodeURIComponent(t.short)}`}
                    class="btn btn-sm btn-primary gap-1.5"
                  >
                    <Icon name="lucide:mail" class="h-4 w-4" /> {t.short}
                  </a>
                ))
              }
            </div>

            {
              /* Los correos personales solo aparecen cuando existen de verdad:
                 ver `emailListo` en src/data/templos.ts. */
              porZoom.some((t) => correoDe(t.leader)) && (
                <ul class="mt-4 space-y-1 text-xs text-base-content/70">
                  {porZoom.map((t) => {
                    const correo = correoDe(t.leader);
                    return (
                      correo && (
                        <li>
                          {t.short}:{' '}
                          <a
                            href={`mailto:${correo}?subject=${asuntoZoom}`}
                            class="link-hover link break-all"
                          >
                            {correo}
                          </a>
                        </li>
                      )
                    );
                  })}
                </ul>
              )
            }
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Sigue estudiando"
    title="La Palabra, también entre semana"
    text="Prédicas y enseñanzas en video, y la vida de la congregación día a día."
    image={IMG.estudioCierre}
  >
    <a
      href={youtube.href}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-lg gap-2 btn-invert"
    >
      <Icon name="lucide:youtube" class="h-5 w-5" /> Ver en YouTube
    </a>
    <a href="/horarios" class="btn btn-lg gap-2 btn-invert">
      <Icon name="lucide:clock" class="h-5 w-5" /> Todos los horarios
    </a>
  </CtaBand>
</Layout>
