---
export const prerender = false;

// La página se arma en cada petición, pero su contenido cambia como mucho unas
// veces al mes. Se deja que la CDN de Cloudflare la sirva ya hecha durante un
// minuto y que siga sirviéndola hasta diez minutos más mientras la rehace por
// detrás: durante una transmisión, cien visitas seguidas son una sola consulta
// a la base en vez de cien.
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import RutaJsonLd from '../../components/RutaJsonLd.astro';
import FiltroTemplos from '../../components/FiltroTemplos.astro';
import Reveal from '../../components/Reveal.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EmptyState from '../../components/EmptyState.astro';
import AccionesEvento from '../../components/AccionesEvento.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { IMG } from '../../assets/images';
import { templos } from '../../data/templos';
import { SITE } from '../../data/site';
import { baseDeDatos } from '../../lib/base';
import { eventosProximos, eventosPasados, eventoPorClave } from '../../lib/datos';
import { urlMedio } from '../../lib/medios';
import { deIsoAChile, enChile, fechaLarga, horaCorta } from '../../lib/hora';

/*
 * La vista de calendario se mudó a /calendario, con página propia. Quien tenga
 * guardada o compartida la dirección vieja llega al mismo mes y templo.
 */
if (Astro.url.searchParams.get('vista') === 'calendario') {
  const p = new URLSearchParams();
  for (const k of ['mes', 'templo']) {
    const v = Astro.url.searchParams.get(k);
    if (v) p.set(k, v);
  }
  return Astro.redirect(p.size ? `/calendario?${p}` : '/calendario', 301);
}

// Dos consultas acotadas en vez de traer la tabla entera y partirla acá, que es
// lo que hacía antes: un archivo de diez años de eventos no tiene por qué
// viajar por la red para que el navegador se quede con seis.
const base = await baseDeDatos();
// Genérico para que el tipo de la fila sobreviva al paso: sin `<T>`, el
// resultado se estrecha a `{ imagen, imagen_clave }` y la plantilla pierde
// todos los demás campos.
const conImagen = <T extends { imagen_clave: string | null }>(e: T) => ({
  ...e,
  imagen: urlMedio(e.imagen_clave),
});
/*
 * El evento que se compartió, si la dirección trae uno.
 *
 * Al compartir, lo que se manda es `/eventos?e=<slug>`. WhatsApp pide esa
 * misma dirección para armar la vista previa, así que acá se busca el evento y
 * la página se presenta como él: su título, su descripción y, sobre todo, su
 * afiche. Sin el parámetro, /eventos es la agenda de siempre.
 *
 * Lo que va después de `#` no sirve para esto: el fragmento nunca sale del
 * navegador, así que `/eventos#e-<id>` —la forma anterior— le llegaba a
 * WhatsApp como `/eventos` a secas y todos los eventos compartían la misma
 * tarjeta.
 */
const clave = Astro.url.searchParams.get('e');
const filaCompartida = clave ? await eventoPorClave(base, clave) : null;
const compartido = filaCompartida ? conImagen(filaCompartida) : null;

const [upcoming, past] = await Promise.all([
  eventosProximos(base).then((f) => f.map(conImagen)),
  eventosPasados(base, { limite: 6 }).then((f) => f.map(conImagen)),
]);

// Todas en hora de Chile. Ver src/lib/hora.ts: esta página se arma en el
// Worker, que corre en UTC, y sin fijar el huso anunciaba las reuniones tres
// horas más tarde de lo que decía el panel.
const fmtDate = fechaLarga;
const fmtTime = horaCorta;
const fmtDay = (d: string) => enChile(d, { day: '2-digit' });
const fmtMonth = (d: string) => enChile(d, { month: 'short' }).replace('.', '');

/**
 * El instante en que termina, o `null` si nadie dijo cuánto dura.
 *
 * Se devuelve `null` en vez de «inicio + dos horas» a propósito: las dos horas
 * son una suposición para que el calendario no deje un hueco raro, no un dato.
 * Anunciarla en la tarjeta —«19:00 a 21:00»— sería inventarle a la gente una
 * hora de término que nadie prometió.
 */
const terminaEn = (e: { fecha: string; duracion_min: number | null }) =>
  e.duracion_min && e.duracion_min > 0
    ? new Date(new Date(e.fecha).getTime() + e.duracion_min * 60_000).toISOString()
    : null;

// Datos estructurados de evento: Google los usa para mostrar la agenda en los
// resultados de búsqueda. El lugar se resuelve contra los templos reales.
const sitio = Astro.site?.toString().replace(/\/$/, '') ?? '';
const matriz = templos.find((t) => t.matriz) ?? templos[0];

function lugarDe(nombre: string | null) {
  const t =
    (nombre && templos.find((x) => nombre.toLowerCase().includes(x.short.toLowerCase()))) || matriz;
  return {
    '@type': 'Place',
    name: nombre || t.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: t.address,
      addressLocality: t.city,
      addressRegion: t.region,
      addressCountry: 'CL',
    },
  };
}

const eventosJsonLd =
  upcoming.length > 0
    ? {
        '@context': 'https://schema.org',
        '@graph': upcoming.map((e) => ({
          '@type': 'Event',
          name: e.titulo,
          // Día completo: solo la fecha, sin hora, que es como schema.org
          // dice «todo el día». Con el instante, Google anunciaría las 12:00.
          startDate: e.todo_el_dia ? deIsoAChile(e.fecha).slice(0, 10) : e.fecha,
          ...(!e.todo_el_dia && terminaEn(e) ? { endDate: terminaEn(e) } : {}),
          eventStatus: 'https://schema.org/EventScheduled',
          eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
          location: lugarDe(e.lugar),
          ...(e.descripcion ? { description: e.descripcion } : {}),
          ...(e.imagen ? { image: e.imagen } : {}),
          organizer: { '@type': 'Organization', name: SITE.name, url: sitio },
        })),
      }
    : null;
import { jsonLd as comoJsonLd } from '../../lib/jsonld';
---

<Layout
  title={compartido ? `${compartido.titulo} · La Casa de Dios` : 'Eventos · La Casa de Dios'}
  description={
    compartido
      ? (compartido.descripcion ??
        `${fmtDate(compartido.fecha)} · ${compartido.lugar ?? SITE.name}`)
      : 'Próximos eventos y actividades de La Casa de Dios: reuniones especiales, encuentros y celebraciones.'
  } /* La tarjeta de 1200×630 si existe; si no, la imagen normal, que al menos
      da una vista previa aunque sea pequeña. Ver la migración 0013. */
  image={urlMedio(compartido?.imagen_social_clave ?? null) ?? compartido?.imagen ?? undefined}
  ogUrl={compartido ? `${sitio}/eventos?e=${encodeURIComponent(clave!)}` : undefined}
>
  <PageHero
    image={IMG.eventosPortada}
    alt="Reunión de adoración"
    eyebrow="Agenda"
    title="Eventos"
    subtitle="Actividades, reuniones especiales y encuentros de nuestra comunidad."
    height="min-h-[50vh]"
  />

  {eventosJsonLd && (
    <script type="application/ld+json" set:html={comoJsonLd(eventosJsonLd)} is:inline />
  )}

  <RutaJsonLd items={[{ label: 'Inicio', href: '/' }, { label: 'Eventos' }]} />

  {/* La barra de filtro y lo que filtra viven en el mismo bloque a propósito:
      así la barra deja de estar pegada arriba cuando termina el listado, en vez
      de seguir flotando sobre el pie de página. */}
  <div class="ambito-filtro">
    <FiltroTemplos plural="eventos" />

    <section class="section bg-base-100">
      <div class="wrap">
        {/* El mes entero, con las reuniones y sus cambios, vive en /calendario. */}
        <div class="mb-8 flex justify-end">
          <a href="/calendario" class="btn btn-outline btn-sm gap-1.5">
            <Icon name="lucide:calendar-range" class="h-4 w-4" /> Ver el calendario del mes
          </a>
        </div>

        {upcoming.length === 0 && past.length === 0 && (
          <EmptyState
            icon="lucide:calendar-days"
            title="Todavía no hay eventos publicados"
            text="Nuestras reuniones habituales sí siguen su curso: revisa los horarios de cada templo."
          >
            <a href="/horarios" class="btn btn-primary gap-2">
              <Icon name="lucide:clock" class="h-5 w-5" /> Ver los horarios
            </a>
          </EmptyState>
        )}

        {upcoming.length > 0 && (
          <>
            {/* Con el componente, igual que las otras cinco páginas: mismo
                  tamaño de titular, mismo antetítulo y el mismo revelado al
                  entrar. Escrito a mano, esta página —y la de noticias— eran
                  las dos únicas que no seguían el ritmo del resto, y son
                  justo las dos que más cambian. */}
            <SectionHeading
              eyebrow="Lo que viene"
              title="Próximos eventos"
              subtitle={`${upcoming.length} ${upcoming.length === 1 ? 'evento programado' : 'eventos programados'}`}
              align="left"
            />

            <div class="mt-8 grid gap-6 md:grid-cols-2">
              {upcoming.map((e, i) => (
                <Reveal delay={(i % 2) * 80} class="h-full" data-etiqueta={e.templo}>
                  <article
                    id={`e-${e.id}`}
                    class="panel panel-lift group flex h-full scroll-mt-24 flex-col overflow-hidden"
                  >
                    <div class="relative h-48 overflow-hidden">
                      {/* El afiche entero, sobre una copia suya desenfocada.
                            Casi todo lo que se sube acá son afiches, y un afiche
                            es vertical: recortándolo a la forma del recuadro se
                            le va el título por arriba y la dirección por abajo,
                            que es justo lo que el afiche venía a decir. Con
                            `contain` se ve completo, y el fondo borroso evita
                            las dos franjas vacías a los lados. La foto se
                            descarga una sola vez: las dos etiquetas apuntan al
                            mismo archivo. */}
                      {e.imagen ? (
                        <>
                          <img
                            src={e.imagen}
                            alt=""
                            aria-hidden="true"
                            class="absolute inset-0 h-full w-full scale-125 object-cover blur-xl"
                            loading="lazy"
                          />
                          <img
                            src={e.imagen}
                            alt={e.imagen_alt ?? e.titulo}
                            class="relative h-full w-full object-contain transition-transform duration-700 group-hover:scale-105"
                            loading="lazy"
                          />
                        </>
                      ) : (
                        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary/20 to-accent/20 text-primary/40">
                          <Icon name="lucide:calendar-days" class="h-14 w-14" />
                        </div>
                      )}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/55 to-transparent" />

                      {/* Taco de calendario */}
                      <div class="absolute left-4 top-4 flex w-14 flex-col items-center overflow-hidden rounded-xl bg-base-100 shadow-lg">
                        <span class="w-full bg-primary py-0.5 text-center text-[0.65rem] font-bold uppercase text-primary-content">
                          {fmtMonth(e.fecha)}
                        </span>
                        <span class="py-1 font-data text-xl font-bold leading-none">
                          {fmtDay(e.fecha)}
                        </span>
                      </div>

                      <span class="absolute bottom-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white backdrop-blur">
                        <Icon name="lucide:clock" class="h-3.5 w-3.5" />{' '}
                        {e.todo_el_dia
                          ? 'Todo el día'
                          : terminaEn(e)
                            ? `${fmtTime(e.fecha)} a ${fmtTime(terminaEn(e)!)}`
                            : fmtTime(e.fecha)}
                      </span>
                    </div>

                    <div class="flex flex-1 flex-col p-6">
                      <span class="text-xs text-base-content/70">{fmtDate(e.fecha)}</span>
                      <h3 class="card-title mt-1 text-2xl leading-snug">{e.titulo}</h3>
                      {e.lugar && (
                        <p class="mt-1 flex items-center gap-1.5 text-sm font-medium text-accent">
                          <Icon name="lucide:map-pin" class="h-4 w-4 shrink-0" /> {e.lugar}
                        </p>
                      )}
                      {e.descripcion && <p class="mt-3 text-base-content/75">{e.descripcion}</p>}

                      <AccionesEvento evento={e} sitio={sitio} />
                    </div>
                  </article>
                </Reveal>
              ))}
            </div>
          </>
        )}

        {past.length > 0 && (
          <div class={upcoming.length > 0 ? 'mt-16' : ''}>
            {/* Secundario: es el archivo, no a lo que se viene. */}
            <SectionHeading eyebrow="Archivo" title="Eventos anteriores" align="left" secundario />
            <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {past.map((e) => (
                <Reveal class="h-full" data-etiqueta={e.templo}>
                  <div class="h-full rounded-xl border border-base-300 bg-base-200/50 p-5">
                    <div class="text-xs text-base-content/70">{fmtDate(e.fecha)}</div>
                    <h3 class="mt-1 font-bold leading-snug">{e.titulo}</h3>
                    {e.lugar && (
                      <p class="mt-1 flex items-center gap-1.5 text-sm text-base-content/70">
                        <Icon name="lucide:map-pin" class="h-4 w-4 shrink-0" /> {e.lugar}
                      </p>
                    )}
                  </div>
                </Reveal>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </div>

  <CtaBand
    eyebrow="Cada semana"
    title="Además de los eventos, nos reunimos todas las semanas"
    text="Reuniones generales, estudios bíblicos, discipulado y encuentros de jóvenes en los cuatro templos."
    image={IMG.eventosCierre}
    compact
  >
    <a href="/horarios" class="btn btn-primary gap-2">
      <Icon name="lucide:clock" class="h-5 w-5" /> Ver horarios
    </a>
    <a href="/templos" class="btn gap-2 btn-invert">
      <Icon name="lucide:church" class="h-5 w-5" /> Nuestros templos
    </a>
  </CtaBand>

  {compartido && <span hidden data-evento-compartido={compartido.id} />}

  <script>
    /*
     * Quien llega desde un enlace compartido entra por la agenda entera, así
     * que hay que dejarlo frente al evento que le mandaron.
     *
     * El evento viaja en el parámetro `e` y no en el `#` porque el `#` no sale
     * del navegador, y sin él el servidor no sabría de cuál es la vista previa.
     * El precio de esa decisión es este desplazamiento a mano.
     *
     * El id llega en un atributo y no incrustado en el script para que no haga
     * falta un script en línea: la política de seguridad del sitio solo deja
     * correr los que Astro empaqueta y firma.
     *
     * Si la tarjeta no está —un evento viejo que ya no se lista— no se hace
     * nada: la página se queda arriba, que es mejor que saltar a ninguna parte.
     */
    const marca = document.querySelector<HTMLElement>('[data-evento-compartido]');
    const tarjeta = marca && document.getElementById(`e-${marca.dataset.eventoCompartido}`);
    if (tarjeta) {
      tarjeta.scrollIntoView({ block: 'center' });
      // Un resalte breve para que se note cuál de todos es. Se quita solo, y
      // respeta a quien pidió menos movimiento en su sistema.
      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      tarjeta.style.transition = quieto ? 'none' : 'box-shadow .5s ease';
      tarjeta.style.boxShadow = '0 0 0 3px var(--color-accent, #d4a72c)';
      setTimeout(() => {
        tarjeta.style.boxShadow = '';
      }, 2400);
    }
  </script>
</Layout>
