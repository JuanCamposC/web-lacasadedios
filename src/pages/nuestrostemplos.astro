---
/**
 * La entrada desde la biografía de Instagram de la iglesia (@lacasadedioscl).
 *
 * Lo que busca quien toca ese enlace es un templo: dónde queda y cuándo hay
 * reunión. Por eso lo primero son los cuatro templos con su próxima reunión, y
 * debajo, lo poco más que vale la pena a un toque: el Instituto Bíblico, el
 * canal y la web.
 *
 * Se arma sola con los templos y la tabla de horarios; no hay lista que
 * mantener. Va con la misma caché que /horarios: un minuto servida hecha, y
 * rehecha por detrás hasta diez más.
 */
export const prerender = false;
Astro.response.headers.set('Cache-Control', 's-maxage=60, stale-while-revalidate=600');

import { Icon } from 'astro-icon/components';
import EnlacesLayout from '../layouts/EnlacesLayout.astro';
import { templos } from '../data/templos';
import { YOUTUBE_CHANNEL } from '../data/site';
import { baseDeDatos } from '../lib/base';
import { reunionesPublicadas } from '../lib/datos';
import { momentoEnChile, proximaReunion, type Reunion } from '../lib/reuniones';

let reuniones: Reunion[] = [];
try {
  reuniones = await reunionesPublicadas(await baseDeDatos());
} catch (e) {
  // Sin base, cada templo se sigue viendo con su dirección y su enlace; solo
  // falta la línea de la próxima reunión.
  console.error('[nuestrostemplos]', e);
}

const ahora = momentoEnChile();
const fichas = templos.map((t) => {
  const propias = reuniones.filter((r) => r.templo === t.slug);
  return { templo: t, propias, proxima: proximaReunion(propias, ahora) };
});

/**
 * El color de cada templo EN ESTA PÁGINA, sacado de la paleta de la iglesia.
 *
 * No se usa `Templo.color` porque la paleta nueva, por ahora, es solo de las
 * páginas de enlaces: /horarios y las fichas siguen con los colores de antes.
 * Cuando la paleta llegue al resto de la web, esto se mueve a templos.ts.
 */
const COLOR_TEMPLO: Record<string, string> = {
  'santiago-centro': '#d4a72c',
  'san-miguel': '#4c6fa6',
  limache: '#4ca68d',
  coya: '#a44d4d',
};

const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
const lineaSuspendidas = (lista: Reunion[]) =>
  lista
    .map((r) => `Suspendida la del ${DIAS[r.dia]} ${r.hora}${r.aviso ? `: ${r.aviso}` : ''}`)
    .join(' · ');
---

<EnlacesLayout
  title="Nuestros templos · Iglesia La Casa de Dios"
  description="Los cuatro templos de la Iglesia La Casa de Dios —Santiago Centro, San Miguel, Limache y Coya— con su próxima reunión."
  tema="templos"
>
  <header class="text-center">
    <img
      src="/marca/isotipo-azul.png"
      alt=""
      width="480"
      height="792"
      class="mx-auto h-[clamp(3.25rem,15vw,4.25rem)] w-auto"
    />
    <h1 class="e-titulo mt-3">Iglesia La Casa de Dios</h1>
    <div
      class="mx-auto mt-3 h-[3px] w-12 rounded-full bg-gradient-to-r from-[#2f4156] to-[#d4a72c]"
      aria-hidden="true"
    >
    </div>
  </header>

  <section class="mt-7" aria-labelledby="titulo-templos">
    <h2
      id="titulo-templos"
      class="font-data e-suave mb-3 text-center text-xs font-semibold uppercase tracking-[0.2em]"
    >
      Nuestros templos
    </h2>

    <ul class="flex flex-col gap-3">
      {
        fichas.map(({ templo: t, propias, proxima }) => (
          <li>
            <a
              href={`/templos/${t.slug}`}
              class="enlace-boton overflow-hidden py-3.5 pl-5"
              style={`--t-color:${COLOR_TEMPLO[t.slug] ?? '#53697e'}`}
              data-reuniones={JSON.stringify(propias)}
            >
              {/* El color del templo: con una franja por templo, al bajar la
                  lista se distingue uno de otro sin leer. */}
              <span class="absolute inset-y-0 left-0 w-2 bg-[var(--t-color)]" aria-hidden="true" />
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span class="font-display text-[1.2rem] leading-tight">{t.short}</span>
                  {t.matriz && (
                    <span class="font-data rounded-full bg-[#d4a72c] px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-wider text-[#2f4156]">
                      Matriz
                    </span>
                  )}
                </span>
                <span class="e-suave mt-0.5 block text-sm">{t.address}</span>

                <span class="mt-2.5 block">
                  <span
                    class="font-data block text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-[#53697e]"
                    data-etiqueta
                  >
                    {proxima.enCurso ? 'Ahora mismo' : 'Próxima reunión'}
                  </span>
                  <span class="mt-0.5 block font-semibold" data-linea>
                    {proxima.enCurso
                      ? `En curso · ${proxima.enCurso.nombre}`
                      : proxima.reunion
                        ? `${proxima.cuando} ${proxima.reunion.hora} · ${proxima.reunion.nombre}`
                        : 'Consulta los horarios'}
                  </span>
                  <span
                    class="mt-1 block text-sm font-medium text-[#8a5a00]"
                    data-cambio
                    hidden={!proxima.reunion?.aviso}
                  >
                    {proxima.reunion?.aviso}
                  </span>
                  <span
                    class="mt-1 block text-sm font-medium text-[#b42318]"
                    data-suspendidas
                    hidden={proxima.suspendidas.length === 0}
                  >
                    {lineaSuspendidas(proxima.suspendidas)}
                  </span>
                </span>
              </span>
              <Icon name="lucide:chevron-right" class="enlace-flecha" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-7 flex flex-col gap-3" aria-label="Más enlaces">
    <a href="/estudio-biblico" class="enlace-boton" style="--acento:#d4a72c">
      <span class="enlace-icono"><Icon name="lucide:book-open" class="h-5 w-5" /></span>
      <span class="min-w-0 flex-1">
        <span class="enlace-nombre">Instituto Bíblico Bet-El</span>
        <span class="e-suave block text-sm">Todos los lunes · escucha los estudios</span>
      </span>
      <Icon name="lucide:chevron-right" class="enlace-flecha" aria-hidden="true" />
    </a>

    <a
      href={YOUTUBE_CHANNEL}
      target="_blank"
      rel="noopener noreferrer"
      class="enlace-boton"
      style="--acento:#a44d4d"
    >
      <span class="enlace-icono"><Icon name="lucide:youtube" class="h-5 w-5" /></span>
      <span class="min-w-0 flex-1">
        <span class="enlace-nombre">YouTube</span>
        <span class="e-suave block text-sm">@lacasadedioscl</span>
      </span>
      <Icon name="lucide:arrow-up-right" class="enlace-flecha" aria-hidden="true" />
    </a>

    <a href="/" class="enlace-boton" style="--acento:#4c6fa6">
      <span class="enlace-icono"><Icon name="lucide:globe" class="h-5 w-5" /></span>
      <span class="min-w-0 flex-1">
        <span class="enlace-nombre">Nuestra web</span>
        <span class="e-suave block text-sm">lacasadedios.cl</span>
      </span>
      <Icon name="lucide:chevron-right" class="enlace-flecha" aria-hidden="true" />
    </a>
  </section>
</EnlacesLayout>

<script>
  import { momentoEnChile, proximaReunion, type Reunion } from '../lib/reuniones';

  /*
   * La próxima reunión se vuelve a calcular acá, con el reloj de quien mira.
   *
   * La página sale de la caché de la CDN hasta once minutos después de
   * armarse: sin esto, a las 20:05 seguiría diciendo «Hoy 20:00» de una reunión
   * que ya empezó. Lo del servidor queda para quien no tiene JavaScript.
   */
  const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
  const ahora = momentoEnChile();

  document.querySelectorAll<HTMLElement>('[data-reuniones]').forEach((ficha) => {
    let propias: Reunion[];
    try {
      propias = JSON.parse(ficha.dataset.reuniones ?? '[]');
    } catch {
      return;
    }
    const p = proximaReunion(propias, ahora);
    const linea = ficha.querySelector<HTMLElement>('[data-linea]');
    const cambio = ficha.querySelector<HTMLElement>('[data-cambio]');
    const suspendidas = ficha.querySelector<HTMLElement>('[data-suspendidas]');

    const etiqueta = ficha.querySelector<HTMLElement>('[data-etiqueta]');
    if (etiqueta) etiqueta.textContent = p.enCurso ? 'Ahora mismo' : 'Próxima reunión';

    if (linea) {
      // Lo que está pasando ahora va primero: es lo que decide si alguien sale
      // de casa en este momento.
      linea.textContent = p.enCurso
        ? `En curso · ${p.enCurso.nombre}`
        : p.reunion
          ? `${p.cuando} ${p.reunion.hora} · ${p.reunion.nombre}`
          : 'Consulta los horarios';
    }
    if (cambio) {
      cambio.textContent = p.reunion?.aviso ?? '';
      cambio.hidden = !p.reunion?.aviso;
    }
    if (suspendidas) {
      suspendidas.textContent = p.suspendidas
        .map((r) => `Suspendida la del ${DIAS[r.dia]} ${r.hora}${r.aviso ? `: ${r.aviso}` : ''}`)
        .join(' · ');
      suspendidas.hidden = p.suspendidas.length === 0;
    }
  });
</script>
