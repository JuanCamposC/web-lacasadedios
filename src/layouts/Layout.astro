---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { templos, CONTACT } from '../data/templos';

// Fuentes auto-hospedadas (sin depender del CDN de Google Fonts)
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'La Casa de Dios · Iglesia Cristiana',
	description = 'La Casa de Dios es una comunidad de fe cristiana con templos en Santiago, San Miguel, Limache y Coya. Conoce nuestros horarios, ubicaciones y declaración de fe.',
	image,
} = Astro.props;

const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: Astro.url.href;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;

// Datos estructurados de la organización (todas las páginas).
const orgJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Church',
	name: 'La Casa de Dios',
	description,
	url: Astro.site?.toString() ?? canonical,
	email: CONTACT.email,
	telephone: CONTACT.phone,
	sameAs: [
		'https://instagram.com/jovenescasadedios._',
		'https://www.youtube.com/@casadediosconociendolapalabrad',
	],
	location: templos.map((t) => ({
		'@type': 'Place',
		name: t.name,
		address: {
			'@type': 'PostalAddress',
			streetAddress: t.address,
			addressLocality: t.city,
			addressRegion: t.region,
			addressCountry: 'CL',
		},
		geo: { '@type': 'GeoCoordinates', latitude: t.coords.lat, longitude: t.coords.lng },
	})),
};
---

<!doctype html>
<html lang="es" data-theme="church">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Aplica el tema guardado antes de pintar (evita parpadeo).
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t === 'dark') t = 'churchdark';
					if (t !== 'church' && t !== 'churchdark') t = 'church';
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {}
			})();
		</script>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="theme-color" content="#1e3a8a" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="La Casa de Dios" />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<!-- Twitter -->
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />

		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<Navigation />
		<main class="pt-16">
			<slot />
		</main>
		<Footer />

		<a id="live-pill" href="/en-vivo" class="fixed bottom-5 right-5 z-40 hidden items-center gap-2 rounded-full bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-red-600/30 transition hover:bg-red-500">
			<span class="pulse-dot inline-block h-2.5 w-2.5 rounded-full bg-white"></span> En vivo
		</a>
	</body>
</html>

<script>
	import '../scripts/reveal';
	import { createBrowserSupabase } from '../lib/supabase';

	(async () => {
		const pill = document.getElementById('live-pill');
		if (!pill) return;
		try {
			const supabase = createBrowserSupabase();
			const { data } = await supabase.from('settings').select('live_enabled').eq('id', 1).maybeSingle();
			if (data && data.live_enabled) {
				pill.classList.remove('hidden');
				pill.classList.add('inline-flex');
			}
		} catch {}
	})();
</script>

<script is:inline>
	// Smooth scroll para enlaces internos con desfase por el navbar fijo
	document.addEventListener('DOMContentLoaded', function () {
		document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
			anchor.addEventListener('click', function (e) {
				const href = this.getAttribute('href');
				if (href && href !== '#') {
					const target = document.querySelector(href);
					if (target) {
						e.preventDefault();
						const offsetTop = target.getBoundingClientRect().top + window.scrollY - 80;
						window.scrollTo({ top: offsetTop, behavior: 'smooth' });
					}
				}
			});
		});
	});
</script>
