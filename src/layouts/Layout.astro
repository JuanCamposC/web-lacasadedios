---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { templos, CONTACT } from '../data/templos';

// Fuentes auto-hospedadas (sin depender del CDN de Google Fonts)
import '@fontsource-variable/playfair-display';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = 'La Casa de Dios · Iglesia Cristiana',
	description = 'La Casa de Dios es una comunidad de fe cristiana con templos en Santiago, San Miguel, Limache y Coya. Conoce nuestros horarios, ubicaciones y declaración de fe.',
	image,
} = Astro.props;

const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: Astro.url.href;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;

// Datos estructurados de la organización (todas las páginas).
const orgJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Church',
	name: 'La Casa de Dios',
	description,
	url: Astro.site?.toString() ?? canonical,
	email: CONTACT.email,
	telephone: CONTACT.phone,
	sameAs: [
		'https://instagram.com/jovenescasadedios._',
		'https://www.youtube.com/@casadediosconociendolapalabrad',
	],
	location: templos.map((t) => ({
		'@type': 'Place',
		name: t.name,
		address: {
			'@type': 'PostalAddress',
			streetAddress: t.address,
			addressLocality: t.city,
			addressRegion: t.region,
			addressCountry: 'CL',
		},
		geo: { '@type': 'GeoCoordinates', latitude: t.coords.lat, longitude: t.coords.lng },
	})),
};
---

<!doctype html>
<html lang="es" data-theme="church">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// Aplica el tema guardado antes de pintar (evita parpadeo).
			(function () {
				try {
					var t = localStorage.getItem('theme');
					if (t === 'dark') t = 'churchdark';
					if (t !== 'church' && t !== 'churchdark') t = 'church';
					document.documentElement.setAttribute('data-theme', t);
				} catch (e) {}
			})();
		</script>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="theme-color" content="#1e3a8a" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="La Casa de Dios" />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<!-- Twitter -->
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />

		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<Navigation />
		<main class="pt-16">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	html {
		font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		scroll-behavior: smooth;
	}

	/* Sistema tipográfico coherente:
	   · Serif (Playfair Display) para TODOS los títulos → combina con el logo
	   · Poppins (sans) para cuerpo, botones y UI */
	h1, h2, h3, h4,
	.card-title,
	.font-display {
		font-family: 'Playfair Display Variable', 'Georgia', 'Times New Roman', serif;
		letter-spacing: 0.005em;
	}

	/* Logo: negro sobre fondos claros; se invierte a blanco en modo oscuro */
	.site-logo {
		transition: filter 0.3s ease;
	}
	[data-theme='churchdark'] .site-logo {
		filter: invert(1) brightness(1.8);
	}
	/* El footer siempre tiene fondo oscuro → logo siempre en blanco */
	.footer-logo {
		filter: invert(1) brightness(1.8);
	}

	body {
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0px); }
		50% { transform: translateY(-20px); }
	}

	.animate-float {
		animation: float 6s ease-in-out infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.animate-float,
		.animate-fade-in,
		.animate-fade-in-up,
		.animate-slide-in-right { animation: none; }
	}

	/* Breadcrumbs */
	.breadcrumbs > ul > li + li:before {
		content: "";
		margin-left: 0.5rem;
		margin-right: 0.75rem;
		display: block;
		height: 0.375rem;
		width: 0.375rem;
		transform: rotate(45deg);
		opacity: 0.4;
		border-top: 1px solid;
		border-right: 1px solid;
	}
</style>

<script is:inline>
	// Smooth scroll para enlaces internos con desfase por el navbar fijo
	document.addEventListener('DOMContentLoaded', function () {
		document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
			anchor.addEventListener('click', function (e) {
				const href = this.getAttribute('href');
				if (href && href !== '#') {
					const target = document.querySelector(href);
					if (target) {
						e.preventDefault();
						const offsetTop = target.getBoundingClientRect().top + window.scrollY - 80;
						window.scrollTo({ top: offsetTop, behavior: 'smooth' });
					}
				}
			});
		});
	});
</script>
