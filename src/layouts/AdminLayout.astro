---
import { Icon } from 'astro-icon/components';
// El panel usa las mismas familias que el sitio público, menos el display:
// aquí no hay titulares de portada, solo interfaz.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo-narrow/wght.css';
import '../styles/global.css';

interface Props {
  title?: string;
  /** Bajada bajo el título, para orientar sin tener que adivinar. */
  description?: string;
  active?:
    | 'inicio'
    | 'eventos'
    | 'noticias'
    | 'videos'
    | 'estudios'
    | 'instagram'
    | 'jovenes'
    | 'horarios'
    | 'suscriptores'
    | 'en-vivo'
    | 'aviso'
    | 'papelera';
}
const { title = 'Panel', description, active } = Astro.props;
// Quién entró sale del token de Cloudflare Access, verificado en el middleware.
// Es `null` cuando el panel se abrió a propósito o desde localhost, y ahí se
// enseña ese motivo en vez de un correo: trabajar con la puerta abierta tiene
// que verse, no deducirse.
const identidad = Astro.locals.identidad;
const motivo = Astro.locals.motivoAcceso;

interface Seccion {
  href: string;
  label: string;
  key: NonNullable<Props['active']>;
  icon: string;
}

/**
 * Las secciones del panel, por grupos.
 *
 * ── POR QUÉ AGRUPADAS ───────────────────────────────────────────────────────
 * Eran once enlaces en una sola lista, y en el teléfono eso era una barra que
 * se desliza de lado: para llegar a «Correos» había que arrastrar sin saber
 * cuánto quedaba. Once cosas en una lista plana tampoco se recuerdan — hay que
 * leerlas todas cada vez.
 *
 * Los cuatro grupos responden a cuándo se usa cada cosa: el CONTENIDO se carga
 * cuando hay algo que publicar, LA SEMANA se toca cuando cambia un horario, los
 * AVISOS son de un domingo a mediodía, y GENTE se mira de vez en cuando.
 *
 * `Inicio` va fuera de todo grupo, arriba, porque no es una sección sino la
 * vuelta al principio. `Papelera` va abajo con «Ver el sitio» y «Cerrar
 * sesión»: es de las que se buscan cuando ya pasó algo, no de las del día.
 */
const GRUPOS: { titulo: string; items: Seccion[] }[] = [
  {
    titulo: 'Contenido',
    items: [
      { href: '/admin/eventos', label: 'Eventos', key: 'eventos', icon: 'lucide:calendar-days' },
      { href: '/admin/noticias', label: 'Noticias', key: 'noticias', icon: 'lucide:newspaper' },
      { href: '/admin/videos', label: 'Videos', key: 'videos', icon: 'lucide:youtube' },
      // Los audios del Instituto no se editan acá: se publican en RSS.com y esta
      // pantalla solo decide cuáles se enseñan en el sitio.
      { href: '/admin/estudios', label: 'Instituto', key: 'estudios', icon: 'lucide:headphones' },
      { href: '/admin/instagram', label: 'Instagram', key: 'instagram', icon: 'lucide:instagram' },
      { href: '/admin/jovenes', label: 'Jóvenes', key: 'jovenes', icon: 'lucide:music' },
    ],
  },
  {
    titulo: 'La semana',
    items: [{ href: '/admin/horarios', label: 'Horarios', key: 'horarios', icon: 'lucide:clock' }],
  },
  {
    titulo: 'Avisos',
    items: [
      { href: '/admin/en-vivo', label: 'En vivo', key: 'en-vivo', icon: 'lucide:radio' },
      { href: '/admin/aviso', label: 'Aviso', key: 'aviso', icon: 'lucide:megaphone' },
    ],
  },
  {
    titulo: 'Gente',
    items: [
      { href: '/admin/suscriptores', label: 'Correos', key: 'suscriptores', icon: 'lucide:mail' },
    ],
  },
];

const INICIO: Seccion = {
  href: '/admin',
  label: 'Inicio',
  key: 'inicio',
  icon: 'lucide:layout-dashboard',
};
const PAPELERA: Seccion = {
  href: '/admin/papelera',
  label: 'Papelera',
  key: 'papelera',
  icon: 'lucide:trash-2',
};

// «Seguridad» ya no está: era la contraseña y el segundo factor del login
// propio, y de eso se encarga ahora Google a través de Cloudflare Access.
// Dejar la pantalla habría sido ofrecer cambiar una contraseña que ya no
// abre nada.

/**
 * Lo que va en la barra de abajo del teléfono. Cuatro, y «Más».
 *
 * Son las cuatro que se tocan a diario. El resto está a un toque más, dentro de
 * «Más», en vez de a un arrastre de longitud desconocida.
 */
const EN_EL_TELEFONO: Seccion[] = [
  INICIO,
  GRUPOS[1].items[0], // Horarios
  GRUPOS[0].items[0], // Eventos
  GRUPOS[0].items[1], // Noticias
];
const CLAVES_ABAJO = new Set(EN_EL_TELEFONO.map((s) => s.key));

const claseLateral = (activa: boolean) =>
  `relative flex items-center gap-3 rounded px-3 py-2.5 text-sm font-medium transition-colors ${
    activa ? 'bg-white/10 text-white' : 'text-white/60 hover:bg-white/5 hover:text-white'
  }`;
---

<!doctype html>
<html lang="es" data-theme="church">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a1730" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <title>{title} · Panel — La Casa de Dios</title>
  </head>

  <body class="min-h-screen bg-base-200">
    <!-- ══ Barra lateral (escritorio) ═══════════════════════════════════════
         En azul noche, la misma superficie que el cartel del sitio: el panel
         se siente parte de la misma casa, no una herramienta prestada.
      ══════════════════════════════════════════════════════════════════════ -->
    <aside class="on-dark fixed inset-y-0 left-0 z-40 hidden w-64 flex-col bg-[#0a1730] lg:flex">
      <div class="flex items-center gap-2.5 px-6 py-5">
        <img src="/marca/logo-blanco.png" alt="" class="h-6 w-auto" width="1220" height="276" />
        <span
          class="font-data rounded px-1.5 py-0.5 text-[0.65rem] font-bold uppercase tracking-[0.15em] text-accent ring-1 ring-inset ring-accent/40"
        >
          Panel
        </span>
      </div>

      <div class="rule mx-6" aria-hidden="true"></div>

      <nav class="flex-1 overflow-y-auto px-3 py-5" aria-label="Secciones del panel">
        <a href={INICIO.href} aria-current={active === 'inicio' ? 'page' : undefined} class={claseLateral(active === 'inicio')}>
          {
            active === 'inicio' && (
              <span
                class="absolute inset-y-1.5 left-0 w-[3px] rounded-full bg-accent"
                aria-hidden="true"
              />
            )
          }
          <Icon name={INICIO.icon} class="h-[18px] w-[18px] shrink-0" />
          {INICIO.label}
        </a>

        {
          GRUPOS.map((grupo) => (
            <div class="mt-5">
              <p
                class="font-data px-3 pb-1.5 text-[0.65rem] font-bold uppercase tracking-[0.15em] text-white/35"
              >
                {grupo.titulo}
              </p>
              <div class="space-y-1">
                {grupo.items.map((l) => (
                  <a
                    href={l.href}
                    aria-current={active === l.key ? 'page' : undefined}
                    class={claseLateral(active === l.key)}
                  >
                    {active === l.key && (
                      <span
                        class="absolute inset-y-1.5 left-0 w-[3px] rounded-full bg-accent"
                        aria-hidden="true"
                      />
                    )}
                    <Icon name={l.icon} class="h-[18px] w-[18px] shrink-0" />
                    {l.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </nav>

      <div class="rule mx-6" aria-hidden="true"></div>

      <div class="space-y-1 px-3 py-4">
        {
          identidad ? (
            <p class="truncate px-3 pb-2 text-xs text-white/60" title={identidad.correo}>
              {identidad.correo}
            </p>
          ) : (
            <p class="px-3 pb-2 text-xs text-warning">
              {motivo === 'local' ? 'Desarrollo local · sin sesión' : 'Panel abierto sin sesión'}
            </p>
          )
        }
        <a
          href={PAPELERA.href}
          aria-current={active === 'papelera' ? 'page' : undefined}
          class={claseLateral(active === 'papelera')}
        >
          <Icon name={PAPELERA.icon} class="h-[18px] w-[18px] shrink-0" />
          {PAPELERA.label}
        </a>
        <a
          href="/"
          class="flex items-center gap-3 rounded px-3 py-2 text-sm text-white/60 transition-colors hover:bg-white/5 hover:text-white"
        >
          <Icon name="lucide:external-link" class="h-[18px] w-[18px]" /> Ver el sitio
        </a>
        <button
          type="button"
          data-logout
          class="flex w-full items-center gap-3 rounded px-3 py-2 text-sm text-white/60 transition-colors hover:bg-white/5 hover:text-white"
        >
          <Icon name="lucide:log-out" class="h-[18px] w-[18px]" /> Cerrar sesión
        </button>
      </div>
    </aside>

    <!-- ══ Contenido ═══════════════════════════════════════════════════════ -->
    <div class="flex min-h-screen flex-col lg:pl-64">
      <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/92 backdrop-blur">
        <div class="flex items-center gap-3 px-4 py-3.5 md:px-8">
          <img
            src="/marca/logo-azul.png"
            alt="La Casa de Dios"
            class="site-logo h-6 w-auto lg:hidden"
            width="1220"
            height="276"
          />
          <div class="min-w-0 flex-1">
            <h1 class="truncate text-lg font-bold leading-tight md:text-xl">{title}</h1>
            {
              description && (
                <p class="hidden truncate text-sm text-base-content/70 sm:block">{description}</p>
              )
            }
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <slot name="acciones" />
            <button
              type="button"
              data-logout
              class="btn btn-ghost btn-sm btn-square lg:hidden"
              aria-label="Cerrar sesión"
            >
              <Icon name="lucide:log-out" class="h-5 w-5" />
            </button>
          </div>
        </div>
      </header>

      <main class="flex-1 p-4 pb-24 md:p-8 lg:pb-8">
        <slot />
      </main>
    </div>

    <!-- ══ Barra inferior (móvil) ══════════════════════════════════════════
         Cuatro secciones y «Más». Antes eran las once repartidas en el ancho
         del teléfono —a 40 px cada una, con el texto cortado—, y después una
         barra que se deslizaba de lado: para llegar a la última había que
         arrastrar sin saber cuánto quedaba. Las cuatro de diario caben, se
         tocan con el pulgar, y el resto está a un toque.
      ══════════════════════════════════════════════════════════════════════ -->
    <nav
      class="fixed inset-x-0 bottom-0 z-40 border-t border-base-300 bg-base-100/95 backdrop-blur lg:hidden"
      aria-label="Secciones del panel"
    >
      <ul class="flex">
        {
          EN_EL_TELEFONO.map((l) => (
            <li class="flex-1">
              <a
                href={l.href}
                aria-current={active === l.key ? 'page' : undefined}
                class={`flex flex-col items-center gap-0.5 py-2 text-[0.62rem] font-medium transition-colors ${
                  active === l.key ? 'text-primary' : 'text-base-content/70'
                }`}
              >
                <Icon name={l.icon} class="h-5 w-5" />
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="flex-1">
          <button
            type="button"
            id="abrir-mas"
            aria-haspopup="dialog"
            class={`flex w-full flex-col items-center gap-0.5 py-2 text-[0.62rem] font-medium transition-colors ${
              active && !CLAVES_ABAJO.has(active) ? 'text-primary' : 'text-base-content/70'
            }`}
          >
            <Icon name="lucide:more-horizontal" class="h-5 w-5" />
            Más
          </button>
        </li>
      </ul>
    </nav>

    <!-- La hoja de «Más». Un <dialog> y no un menú propio: el navegador le da
         el foco atrapado, el cierre con Escape y el fondo que no se desplaza. -->
    <dialog id="hoja-mas" class="modal modal-bottom lg:hidden">
      <div class="modal-box max-h-[80dvh]">
        <h2 class="text-base font-bold">Todas las secciones</h2>
        {
          GRUPOS.map((grupo) => (
            <div class="mt-4">
              <p class="font-data text-[0.65rem] font-bold uppercase tracking-[0.15em] text-base-content/55">
                {grupo.titulo}
              </p>
              <ul class="mt-1.5 space-y-0.5">
                {grupo.items.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      aria-current={active === l.key ? 'page' : undefined}
                      class={`flex items-center gap-3 rounded px-3 py-2.5 text-sm ${
                        active === l.key
                          ? 'bg-primary/10 font-semibold text-primary'
                          : 'hover:bg-base-200'
                      }`}
                    >
                      <Icon name={l.icon} class="h-[18px] w-[18px] shrink-0 text-accent" />
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="mt-4 border-t border-base-300 pt-3">
          <a
            href={PAPELERA.href}
            class="flex items-center gap-3 rounded px-3 py-2.5 text-sm hover:bg-base-200"
          >
            <Icon name={PAPELERA.icon} class="h-[18px] w-[18px] shrink-0 text-accent" />
            {PAPELERA.label}
          </a>
          <a href="/" class="flex items-center gap-3 rounded px-3 py-2.5 text-sm hover:bg-base-200">
            <Icon name="lucide:external-link" class="h-[18px] w-[18px] shrink-0 text-accent" />
            Ver el sitio
          </a>
        </div>
        <div class="modal-action">
          <form method="dialog" class="w-full">
            <button class="btn w-full">Cerrar</button>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button>cerrar</button></form>
    </dialog>

    {
      /* role="status" + aria-live: por acá pasan «Borrado», «No se pudo
        guardar» y «Avisamos a 40 suscriptores». Sin esto, quien usa lector
        de pantalla no se entera de si el guardado funcionó. */
    }
    <div id="toast" role="status" aria-live="polite" class="toast toast-end z-50 pb-20 lg:pb-4">
    </div>

    <script>
      import '../scripts/reveal';

      /**
       * Cerrar sesión lo hace Cloudflare Access, no el sitio.
       *
       * Ya no hay sesión propia que cerrar: la identidad vive en la cookie que
       * pone Access en el borde, y `/cdn-cgi/access/logout` es lo único que la
       * borra de verdad. Un botón que solo limpiara algo del lado del sitio
       * diría «sesión cerrada» dejando a la persona dentro, que es peor que no
       * tener botón.
       */
      document.querySelectorAll('[data-logout]').forEach((b) =>
        b.addEventListener('click', () => {
          window.location.href = '/cdn-cgi/access/logout';
        }),
      );

      // La hoja de «Más» de la barra del teléfono.
      const hoja = document.getElementById('hoja-mas') as HTMLDialogElement | null;
      document
        .getElementById('abrir-mas')
        ?.addEventListener('click', () => hoja?.showModal());
    </script>
  </body>
</html>
