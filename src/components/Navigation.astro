---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-nosotros', label: 'Nosotros' },
  { href: '/eventos', label: 'Eventos' },
  { href: '/noticias', label: 'Noticias' },
  { href: '/videos', label: 'Videos' },
];

const templos = [
  { href: '/templos/santiago-centro', label: 'Santiago Centro'},
  { href: '/templos/san-miguel', label: 'San Miguel'},
  { href: '/templos/limache', label: 'Limache'},
  { href: '/templos/coya', label: 'Coya'},
];
---

<div class="navbar bg-base-100 shadow-md fixed top-0 z-50 border-b border-base-300">
  <div class="navbar-start">
    <div class="dropdown">
      <div tabindex="0" role="button" class="btn btn-ghost lg:hidden">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
        </svg>
      </div>
      <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow-xl bg-base-100 rounded-box w-52 gap-1 border border-base-300">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class={`transition-all duration-200 ${pathname === link.href ? 'active font-semibold bg-primary text-primary-content' : ''}`}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <details>
            <summary class="transition-all duration-200">Templos</summary>
            <ul class="p-2">
              {templos.map((templo) => (
                <li>
                  <a 
                    href={templo.href}
                    class={`transition-all duration-200 ${pathname === templo.href ? 'active font-semibold bg-primary text-primary-content' : ''}`}
                  >
                    {templo.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </div>
    <a href="/" class="btn btn-ghost hover:bg-transparent px-2" aria-label="La Casa de Dios — Inicio">
      <img src="/logo.png" alt="La Casa de Dios" class="site-logo h-8 md:h-9 w-auto" width="605" height="204" />
    </a>
  </div>
  
  <div class="navbar-center hidden lg:flex">
    <ul class="menu menu-horizontal px-1 gap-2">
      {navLinks.map((link) => (
        <li>
          <a 
            href={link.href}
            class={`transition-all duration-200 font-medium ${pathname === link.href ? 'active bg-primary text-primary-content' : ''}`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <details>
          <summary class="transition-all duration-200 font-medium">Templos</summary>
          <ul class="p-2 bg-base-100 shadow-xl rounded-box w-56 border border-base-300 z-[100]">
            {templos.map((templo) => (
              <li>
                <a 
                  href={templo.href}
                  class={`transition-all duration-200 ${pathname === templo.href ? 'active bg-primary text-primary-content' : ''}`}
                >
                  {templo.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  </div>
  
  <div class="navbar-end gap-2">
    <label class="swap swap-rotate btn btn-ghost btn-circle btn-sm" aria-label="Cambiar tema" title="Cambiar tema">
      <input type="checkbox" id="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" />
      <svg class="swap-off fill-current w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
      </svg>
      <svg class="swap-on fill-current w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/>
      </svg>
    </label>
  </div>
</div>

<script is:inline>
  // Tema toggle - Script inline para que funcione en todas las páginas
  function initTheme() {
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    // Migrar valores antiguos ('dark') al nuevo tema oscuro coherente.
    let savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') savedTheme = 'churchdark';
    if (savedTheme !== 'church' && savedTheme !== 'churchdark') savedTheme = 'church';

    html.setAttribute('data-theme', savedTheme);
    if (savedTheme === 'churchdark' && themeToggle) {
      themeToggle.checked = true;
    }

    if (themeToggle) {
      themeToggle.addEventListener('change', () => {
        const newTheme = themeToggle.checked ? 'churchdark' : 'church';
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });
    }
  }
  
  // Ejecutar al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTheme);
  } else {
    initTheme();
  }
</script>

<style>
  .navbar {
    padding: 0.5rem 1.5rem;
  }
  
  @media (min-width: 1024px) {
    .navbar {
      padding: 0.75rem 3rem;
    }
  }
  
  /* Animación para el logo */
  .navbar-start a svg {
    transition: transform 0.3s ease;
  }
  
  .navbar-start a:hover svg {
    transform: rotate(5deg) scale(1.1);
  }

  /* Estilos para el submenú de templos */
  details summary {
    cursor: pointer;
    user-select: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  /* Ocultar la flecha derecha de DaisyUI */
  details summary::after {
    display: none !important;
  }

  details[open] summary::before {
    transform: rotate(180deg);
  }

  details[open] summary {
    background-color: hsl(var(--p) / 0.1);
  }

  details ul {
    margin-top: 0.5rem;
  }

  details ul li a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  details ul li a span {
    font-size: 1.2rem;
  }
</style>
