---
import { Icon } from 'astro-icon/components';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/sobre-nosotros', label: 'Nosotros' },
  { href: '/eventos', label: 'Eventos' },
  { href: '/noticias', label: 'Noticias' },
  { href: '/videos', label: 'Videos' },
];

const templos = [
  { href: '/templos/santiago-centro', label: 'Santiago Centro' },
  { href: '/templos/san-miguel', label: 'San Miguel' },
  { href: '/templos/limache', label: 'Limache' },
  { href: '/templos/coya', label: 'Coya' },
];

const pill = 'rounded-full px-3.5 py-2 text-sm font-medium transition-colors';
const pillActive = 'bg-primary/10 text-primary';
const pillIdle = 'text-base-content/70 hover:bg-base-200 hover:text-base-content';
const isTemplos = pathname.startsWith('/templos');
---

<nav id="site-nav" class="fixed top-0 z-50 w-full border-b border-base-300/70 bg-base-100/85 backdrop-blur-md transition-shadow duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-2 px-4 sm:px-6">
    <!-- Logo -->
    <a href="/" class="shrink-0" aria-label="La Casa de Dios — Inicio">
      <img src="/logo.png" alt="La Casa de Dios" class="site-logo h-8 w-auto md:h-9" width="605" height="204" />
    </a>

    <!-- Links (desktop) -->
    <ul class="hidden items-center gap-1 lg:flex">
      {navLinks.map((link) => (
        <li><a href={link.href} class={`${pill} ${pathname === link.href ? pillActive : pillIdle}`}>{link.label}</a></li>
      ))}
      <li>
        <details class="dropdown">
          <summary class={`${pill} ${isTemplos ? pillActive : pillIdle} flex cursor-pointer list-none items-center gap-1`}>
            Templos
            <Icon name="lucide:chevron-down" class="h-4 w-4 transition-transform" />
          </summary>
          <ul class="menu dropdown-content z-[100] mt-3 w-56 rounded-2xl border border-base-300 bg-base-100 p-2 shadow-xl">
            {templos.map((t) => (
              <li><a href={t.href} class={pathname === t.href ? 'font-semibold text-primary' : ''}>{t.label}</a></li>
            ))}
          </ul>
        </details>
      </li>
    </ul>

    <!-- Acciones (derecha) -->
    <div class="flex items-center gap-1">
      <label class="swap swap-rotate btn btn-ghost btn-circle btn-sm" aria-label="Cambiar tema" title="Cambiar tema">
        <input type="checkbox" id="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" />
        <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" />
        </svg>
        <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" />
        </svg>
      </label>

      <a href="/#templos" class="btn btn-primary btn-sm hidden gap-1.5 lg:inline-flex">
        <Icon name="lucide:hand-heart" class="h-4 w-4" /> Visítanos
      </a>

      <button id="nav-toggle" type="button" class="btn btn-ghost btn-sm btn-square lg:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="lucide:menu" class="nav-open h-6 w-6" />
        <Icon name="lucide:x" class="nav-close hidden h-6 w-6" />
      </button>
    </div>
  </div>

  <!-- Panel móvil -->
  <div id="mobile-menu" class="hidden border-t border-base-300 bg-base-100 lg:hidden">
    <ul class="flex flex-col gap-0.5 px-4 py-3">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class={`block rounded-xl px-4 py-3 text-base font-medium ${pathname === link.href ? 'bg-primary/10 text-primary' : 'hover:bg-base-200'}`}>{link.label}</a>
        </li>
      ))}
      <li class="mt-2 px-4 pb-1 pt-2 text-xs font-semibold uppercase tracking-wider text-base-content/50">Templos</li>
      {templos.map((t) => (
        <li>
          <a href={t.href} class={`block rounded-xl px-4 py-2.5 text-sm ${pathname === t.href ? 'bg-primary/10 text-primary' : 'text-base-content/80 hover:bg-base-200'}`}>{t.label}</a>
        </li>
      ))}
      <li class="mt-3">
        <a href="/#templos" class="btn btn-primary w-full gap-2"><Icon name="lucide:hand-heart" class="h-5 w-5" /> Visítanos</a>
      </li>
    </ul>
  </div>
</nav>

<script is:inline>
  function initNav() {
    const html = document.documentElement;
    const themeToggle = document.getElementById('theme-toggle');

    let savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') savedTheme = 'churchdark';
    if (savedTheme !== 'church' && savedTheme !== 'churchdark') savedTheme = 'church';
    html.setAttribute('data-theme', savedTheme);
    if (savedTheme === 'churchdark' && themeToggle) themeToggle.checked = true;

    if (themeToggle && !themeToggle.dataset.bound) {
      themeToggle.dataset.bound = '1';
      themeToggle.addEventListener('change', () => {
        const newTheme = themeToggle.checked ? 'churchdark' : 'church';
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
      });
    }

    const nav = document.getElementById('site-nav');
    if (nav && !nav.dataset.scrollBound) {
      nav.dataset.scrollBound = '1';
      const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 16);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (toggle && menu && !toggle.dataset.bound) {
      toggle.dataset.bound = '1';
      const openI = toggle.querySelector('.nav-open');
      const closeI = toggle.querySelector('.nav-close');
      const setOpen = (open) => {
        menu.classList.toggle('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        if (openI) openI.classList.toggle('hidden', open);
        if (closeI) closeI.classList.toggle('hidden', !open);
      };
      toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      window.addEventListener('resize', () => { if (window.innerWidth >= 1024) setOpen(false); });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNav);
  } else {
    initNav();
  }
</script>

<style>
  #site-nav.is-scrolled {
    box-shadow: 0 6px 24px -12px rgba(0, 0, 0, 0.25);
    background-color: color-mix(in oklab, var(--color-base-100) 95%, transparent);
  }
  details.dropdown > summary::-webkit-details-marker {
    display: none;
  }
  details.dropdown[open] > summary :global(svg:last-child) {
    transform: rotate(180deg);
  }
</style>
