---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  height?: string;
}
const {
  image,
  alt = '',
  eyebrow,
  title,
  subtitle,
  height = 'min-h-[58vh]',
} = Astro.props;
---

<section class={`relative -mt-16 flex ${height} items-center overflow-hidden`}>
  <div class="absolute inset-0">
    <Image
      src={image}
      alt={alt}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      class="h-full w-full object-cover animate-kenburns"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/55 to-black/85"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-base-100 via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-4xl px-4 pt-16 text-center">
    {eyebrow && (
      <span data-reveal class="mb-3 inline-block text-xs font-semibold uppercase tracking-[0.3em] text-accent">
        {eyebrow}
      </span>
    )}
    <h1 data-reveal data-reveal-delay="60" class="font-display font-bold leading-[1.05] text-[clamp(2.4rem,6vw,4rem)] text-white">
      {title}
    </h1>
    {subtitle && (
      <p data-reveal data-reveal-delay="120" class="mx-auto mt-5 max-w-2xl text-lg text-white/80">
        {subtitle}
      </p>
    )}
    <slot />
  </div>
</section>
