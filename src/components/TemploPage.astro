---
import Layout from '../layouts/Layout.astro';
import { getTemplo, getSiblings, CONTACT } from '../data/templos';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const templo = getTemplo(slug);
if (!templo) {
  throw new Error(`Templo no encontrado: ${slug}`);
}
const { prev, next } = getSiblings(templo.slug);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: `La Casa de Dios · ${templo.name}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: templo.address,
    addressLocality: templo.city,
    addressRegion: templo.region,
    addressCountry: 'CL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: templo.coords.lat,
    longitude: templo.coords.lng,
  },
  hasMap: templo.mapLink,
};
---

<Layout
  title={`${templo.name} · La Casa de Dios`}
  description={`${templo.name} — ${templo.address}. Horarios de cultos y reuniones de La Casa de Dios en ${templo.city}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <!-- Breadcrumbs -->
  <div class="bg-base-200 py-3 px-4">
    <div class="container mx-auto max-w-7xl">
      <div class="text-sm breadcrumbs">
        <ul>
          <li><a href="/" class="link link-hover">Inicio</a></li>
          <li><a href="/#templos" class="link link-hover">Templos</a></li>
          <li>{templo.short}</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section class={`hero min-h-[52vh] bg-gradient-to-br ${templo.heroGradient}`}>
    <div class="hero-content text-center">
      <div class="max-w-4xl animate-fade-in-up">
        <h1 class="font-display text-5xl md:text-7xl font-bold mb-6 text-primary">
          {templo.name}
        </h1>
        <p class="text-xl md:text-2xl opacity-80">{templo.address}</p>
        <div class="mt-4 flex flex-wrap gap-2 justify-center">
          {templo.matriz && <div class="badge badge-accent badge-lg gap-1">✦ Iglesia Matriz</div>}
          <div class={`badge badge-${templo.regionTone} badge-lg`}>{templo.region}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Información -->
  <section class="py-20 px-4 bg-base-100">
    <div class="container mx-auto max-w-7xl">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Ubicación -->
        <div class="card bg-gradient-to-br from-primary/5 to-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all md:col-span-2">
          <div class="card-body">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-primary text-primary-content p-4 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </div>
              <h2 class="card-title text-2xl">Ubicación</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-6 items-center">
              <div class="space-y-3 text-base-content/80">
                <p>📍 {templo.address}</p>
                <p>🏙️ {templo.city}</p>
                <p>🗺️ {templo.region}</p>
                <a href={templo.mapLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm gap-2 mt-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
                  Cómo llegar
                </a>
              </div>
              <iframe
                src={templo.mapEmbed}
                title={`Mapa de ${templo.name}`}
                class="w-full h-64 rounded-lg"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>

        <!-- Horarios -->
        <div class="card bg-gradient-to-br from-secondary/5 to-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all">
          <div class="card-body">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-secondary text-secondary-content p-4 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <h2 class="card-title text-2xl">Horarios</h2>
            </div>
            <div class="space-y-3">
              {templo.schedule.map((s) => (
                <div class="bg-base-200 p-3 rounded-lg">
                  <div class={`badge badge-${s.tone} mb-1`}>{s.day}</div>
                  {s.services.map((svc) => <p class="text-sm text-base-content/80">{svc}</p>)}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Líder a cargo -->
        <div class="card bg-gradient-to-br from-accent/5 to-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all">
          <div class="card-body">
            <div class="flex items-center gap-3 mb-4">
              <div class="bg-accent text-accent-content p-4 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              </div>
              <h2 class="card-title text-2xl">{templo.leader.role === 'Obrero a cargo' ? 'Hermano a cargo' : 'Pastor a cargo'}</h2>
            </div>
            <div class="text-center mb-3">
              <div class="avatar placeholder mb-2">
                <div class="bg-neutral text-neutral-content rounded-full w-16"><span class="text-2xl">👤</span></div>
              </div>
              <h3 class="text-lg font-bold">{templo.leader.name}</h3>
              <p class="text-xs opacity-70">{templo.leader.role}</p>
            </div>
            <div class="space-y-1 text-sm text-center">
              <p>📞 <a href={`tel:${CONTACT.phoneHref}`} class="link">{CONTACT.phone}</a></p>
              <p>✉️ <a href={`mailto:${CONTACT.email}`} class="link break-all">{CONTACT.email}</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navegación entre templos -->
  <section class="py-12 px-4 bg-base-100 border-t border-base-300">
    <div class="container mx-auto max-w-7xl">
      <div class="flex justify-between items-center flex-wrap gap-4">
        <a href={`/templos/${prev.slug}`} class="btn btn-outline gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
          {prev.short}
        </a>
        <a href="/#templos" class="btn btn-ghost">Ver todos los templos</a>
        <a href={`/templos/${next.slug}`} class="btn btn-outline gap-2">
          {next.short}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-4 bg-base-200">
    <div class="container mx-auto max-w-4xl text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-8">¡Te esperamos!</h2>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href={templo.mapLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
          Cómo llegar
        </a>
        <a href="/" class="btn btn-outline gap-2">Volver al inicio</a>
      </div>
    </div>
  </section>
</Layout>
