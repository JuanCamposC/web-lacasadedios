---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Reveal from './Reveal.astro';
import Foto from './Foto.astro';
import Distintivo from './Distintivo.astro';
import TemploCard from './TemploCard.astro';
import { Icon } from 'astro-icon/components';
import { templos, correoDe, cargoDe, type Templo } from '../data/templos';
import { CONTACT, hasPhone } from '../data/site';
import { IMG } from '../assets/images';
import { DIAS, porDia, enPie, type Reunion } from '../lib/reuniones';

/**
 * La ficha de un templo.
 *
 * ── POR QUÉ SE REHIZO ───────────────────────────────────────────────────────
 * La anterior era una portada centrada igual a la de cualquier otra página, y
 * debajo cuatro tarjetas del mismo peso: ubicación, horarios, pastor y un
 * selector de templos. Nada decía qué mirar primero, y «Cómo llegar» aparecía
 * tres veces.
 *
 * Ahora la página responde en orden a las tres preguntas de quien la abre:
 *
 *   1. ¿Dónde queda y a quién le escribo?  → la portada y la ficha lateral.
 *   2. ¿Cuándo se reúnen?                  → el tablero de la semana, el mismo
 *                                            de /horarios, que es la firma del
 *                                            sitio.
 *   3. ¿Cómo llego?                        → el mapa, a lo ancho.
 *
 * Y cierra con los otros tres templos con su foto, que es lo que de verdad
 * invita a mirarlos, en vez de una fila de botones con nombres.
 */
interface Props {
  templo: Templo;
  reuniones: Reunion[];
}

const { templo, reuniones } = Astro.props;

const semana = porDia(reuniones);
const correo = correoDe(templo.leader);
const otros = templos.filter((t) => t.slug !== templo.slug);
const contactoTemplo = `/contacto?templo=${encodeURIComponent(templo.short)}`;

// Si alguna reunión está suspendida o cambió, se avisa arriba para que no haga falta
// recorrer el tablero para enterarse.
const conAviso = reuniones.filter((r) => r.estado !== 'normal');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: `La Casa de Dios · ${templo.name}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: templo.address,
    addressLocality: templo.city,
    addressRegion: templo.region,
    addressCountry: 'CL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: templo.coords.lat, longitude: templo.coords.lng },
  hasMap: templo.mapLink,
  ...(correo ? { email: correo } : {}),
};
import { jsonLd as comoJsonLd } from '../lib/jsonld';
---

<Layout
  title={`${templo.name} · La Casa de Dios`}
  description={`${templo.name} — ${templo.address}. Horarios de cultos y reuniones de La Casa de Dios en ${templo.city}.`}
>
  <script type="application/ld+json" set:html={comoJsonLd(jsonLd)} is:inline />

  <!-- ══ Portada ═════════════════════════════════════════════════════════
       Alineada a la izquierda y no centrada como las demás portadas: acá lo
       que se lee es una dirección y dos acciones, y eso se escanea mejor como
       una ficha que como un titular. La foto queda a la derecha, donde el velo
       se abre.
  ══════════════════════════════════════════════════════════════════════ -->
  <section class="on-dark relative -mt-16 overflow-hidden">
    <Foto
      src={IMG[templo.image]}
      alt=""
      aria-hidden="true"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0a1730] via-[#0a1730]/88 to-[#0a1730]/35">
    </div>
    <div class="rule absolute inset-x-0 bottom-0" aria-hidden="true"></div>

    <div class="wrap relative z-10 px-4 pb-16 pt-32 text-white lg:pb-20 lg:pt-40">
      <div class="max-w-2xl">
        <div data-reveal class="flex flex-wrap items-center gap-2">
          <Distintivo templo={templo} />
          {
            templo.matriz && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-white/25 px-2.5 py-0.5 text-xs font-semibold text-white/85">
                <Icon name="lucide:star" class="h-3.5 w-3.5 text-accent" /> Iglesia Matriz
              </span>
            )
          }
        </div>

        <p data-reveal data-reveal-delay="40" class="eyebrow mt-6 text-accent">Templo</p>
        <h1
          data-reveal
          data-reveal-delay="60"
          class="mt-1 text-[clamp(2.6rem,7vw,4.5rem)] leading-none"
        >
          {templo.short}
        </h1>
        <p data-reveal data-reveal-delay="100" class="mt-4 text-lg text-white/75">
          {templo.tagline}
        </p>

        <p data-reveal data-reveal-delay="140" class="mt-6 flex items-start gap-2 text-white/90">
          <Icon name="lucide:map-pin" class="mt-1 h-5 w-5 shrink-0 text-accent" />
          <span>
            {templo.address}
            <span class="block text-sm text-white/60">{templo.city} · {templo.region}</span>
          </span>
        </p>

        <div data-reveal data-reveal-delay="180" class="mt-8 flex flex-wrap gap-3">
          <a
            href={templo.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary gap-2"
          >
            <Icon name="lucide:navigation" class="h-5 w-5" /> Cómo llegar
          </a>
          <a href="#semana" class="btn gap-2 btn-invert">
            <Icon name="lucide:calendar-days" class="h-5 w-5" /> Horarios
          </a>
        </div>
      </div>
    </div>
  </section>

  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Templos', href: '/templos' },
      { label: templo.short },
    ]}
  />

  <!-- ══ La semana y la ficha ══════════════════════════════════════════════ -->
  <section id="semana" class="section scroll-mt-20 bg-base-100">
    <div class="wrap grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-start">
      <div>
        <Reveal>
          <span class="eyebrow text-primary">Cuándo nos reunimos</span>
          <h2 class="mt-2 font-display text-3xl md:text-4xl">La semana en {templo.short}</h2>
          <p class="mt-2 text-base-content/70">
            {`${enPie(reuniones)} ${enPie(reuniones) === 1 ? 'reunión' : 'reuniones'} por semana.`} No
            hace falta avisar: llega unos minutos antes.
          </p>
        </Reveal>

        {
          conAviso.length > 0 && (
            <Reveal class="mt-6">
              <div role="status" class="alert alert-warning items-start text-sm">
                <Icon name="lucide:megaphone" class="h-5 w-5 shrink-0" />
                <div>
                  <p class="font-bold">Avisos de horario</p>
                  <ul class="mt-1 space-y-0.5">
                    {conAviso.map((r) => (
                      <li>
                        {r.nombre} del {DIAS[r.dia].toLowerCase()} ({r.hora}):{' '}
                        {r.aviso ??
                          (r.estado === 'suspendida' ? 'suspendida' : 'cambio de horario')}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </Reveal>
          )
        }

        <Reveal class="mt-6">
          {
            semana.length === 0 ? (
              <div class="rounded-lg border border-dashed border-base-300 px-6 py-10 text-center text-base-content/60">
                Todavía no hay reuniones cargadas para este templo.{' '}
                <a href={contactoTemplo} class="link link-primary">
                  Escríbenos
                </a>{' '}
                y te contamos.
              </div>
            ) : (
              <div class="cartel">
                <header class="cartel-cab">
                  <span class="cartel-titulo">{templo.short}</span>
                  <a href={`/horarios?templo=${templo.slug}`} class="cartel-hoy hover:text-white">
                    Ver en el horario general →
                  </a>
                </header>
                {semana.map((dia) => (
                  <div>
                    <div class="cartel-seccion">
                      <h3>{dia.nombre}</h3>
                      <span class="cartel-conteo">
                        {dia.reuniones.length}{' '}
                        {dia.reuniones.length === 1 ? 'reunión' : 'reuniones'}
                      </span>
                    </div>
                    <ul class="cartel-lista">
                      {dia.reuniones.map((r) => (
                        <li class="cartel-linea" data-estado={r.estado}>
                          <span class="cartel-hora">{r.hora}</span>
                          <span class="cartel-nombre">
                            {r.nombre}
                            {r.estado === 'suspendida' && (
                              <span class="sr-only"> (suspendida)</span>
                            )}
                          </span>
                          {r.estado !== 'normal' && (
                            <span class="cartel-aviso">
                              <Icon
                                name={
                                  r.estado === 'suspendida' ? 'lucide:ban' : 'lucide:clock-alert'
                                }
                                class="h-4 w-4 shrink-0"
                              />
                              {r.aviso ??
                                (r.estado === 'suspendida' ? 'Suspendida' : 'Cambio de horario')}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )
          }
        </Reveal>
      </div>

      <!-- Ficha lateral. Fija al bajar en escritorio: mientras se lee la semana,
           a quién escribir sigue a la vista. -->
      <aside class="space-y-5 lg:sticky lg:top-24">
        <Reveal delay={80}>
          <div class="panel p-6">
            <span class="eyebrow text-primary">{cargoDe(templo.leader)}</span>
            <h3 class="mt-2 font-display text-2xl leading-tight">{templo.leader.name}</h3>
            <p class="text-sm text-base-content/60">{templo.leader.role}</p>

            {
              correo && (
                <div class="mt-5 rounded-lg bg-base-200/70 p-4">
                  <a
                    href={`mailto:${correo}`}
                    class="flex items-center gap-2 break-all font-medium text-primary hover:underline"
                  >
                    <Icon name="lucide:mail" class="h-4 w-4 shrink-0" />
                    {correo}
                  </a>
                  {templo.leader.correoNota && (
                    <p class="mt-2 flex items-start gap-1.5 text-xs text-base-content/65">
                      <Icon name="lucide:info" class="mt-0.5 h-3.5 w-3.5 shrink-0" />
                      {templo.leader.correoNota}
                    </p>
                  )}
                </div>
              )
            }

            <div class="mt-5 flex flex-col gap-2">
              <a href={contactoTemplo} class="btn btn-outline btn-sm gap-2">
                <Icon name="lucide:message-square" class="h-4 w-4" /> Escribir por el formulario
              </a>
              {
                hasPhone && (
                  <a href={`tel:${CONTACT.phoneHref}`} class="btn btn-ghost btn-sm gap-2">
                    <Icon name="lucide:phone" class="h-4 w-4" /> {CONTACT.phone}
                  </a>
                )
              }
            </div>
          </div>
        </Reveal>

        <Reveal delay={140}>
          <a
            href="/estudio-biblico"
            class="panel panel-lift flex items-center gap-4 p-5 transition-colors"
          >
            <span class="tile tile-accent shrink-0">
              <Icon name="lucide:book-open" class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-bold">Estudio bíblico</span>
              <span class="block text-sm text-base-content/65">
                {templo.estudio === 'presencial' ? 'Presencial, los lunes' : 'Por Zoom, los lunes'}
              </span>
            </span>
            <Icon name="lucide:arrow-right" class="h-4 w-4 shrink-0 text-primary" />
          </a>
        </Reveal>
      </aside>
    </div>
  </section>

  <!-- ══ Mapa ════════════════════════════════════════════════════════════
       A lo ancho y con la dirección encima: un mapa metido en media tarjeta
       obligaba a hacer zoom con dos dedos para ver las calles de alrededor.
  ══════════════════════════════════════════════════════════════════════ -->
  <section class="relative bg-base-200">
    <iframe
      src={templo.mapEmbed}
      title={`Mapa de ${templo.name}`}
      class="block h-[26rem] w-full md:h-[32rem]"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>

    <div class="wrap pointer-events-none relative md:absolute md:inset-x-0 md:bottom-8">
      <div class="panel pointer-events-auto -mt-10 max-w-sm p-5 shadow-xl md:mt-0">
        <p class="flex items-start gap-2 font-medium">
          <Icon name="lucide:map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-accent" />
          <span>
            {templo.address}
            <span class="block text-sm font-normal text-base-content/60">{templo.region}</span>
          </span>
        </p>
        <a
          href={templo.mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm mt-4 gap-2"
        >
          <Icon name="lucide:navigation" class="h-4 w-4" /> Abrir en Google Maps
        </a>
      </div>
    </div>
  </section>

  <!-- ══ Los otros templos ═════════════════════════════════════════════════ -->
  <section class="section bg-base-100">
    <div class="wrap">
      <Reveal>
        <span class="eyebrow text-primary">Una misma familia</span>
        <h2 class="mt-2 font-display text-3xl">Nuestros otros templos</h2>
      </Reveal>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          otros.map((t, i) => (
            <Reveal delay={i * 80} class="h-full">
              <TemploCard templo={t} />
            </Reveal>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
