---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import Reveal from './Reveal.astro';
import { Icon } from 'astro-icon/components';
import { getTemplo, templos, CONTACT } from '../data/templos';
import { IMG } from '../assets/images';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const templo = getTemplo(slug);
if (!templo) {
  throw new Error(`Templo no encontrado: ${slug}`);
}

// Iniciales del líder (sin el título Pastor/Hermano)
const initials = templo.leader.name
  .replace(/^(Pastor|Pastora|Hermano|Hermana|Rev\.?)\s+/i, '')
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: `La Casa de Dios · ${templo.name}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: templo.address,
    addressLocality: templo.city,
    addressRegion: templo.region,
    addressCountry: 'CL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: templo.coords.lat, longitude: templo.coords.lng },
  hasMap: templo.mapLink,
};
---

<Layout
  title={`${templo.name} · La Casa de Dios`}
  description={`${templo.name} — ${templo.address}. Horarios de cultos y reuniones de La Casa de Dios en ${templo.city}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <PageHero image={IMG[templo.image]} alt={templo.name} eyebrow={templo.region} title={templo.name} subtitle={templo.address}>
    {templo.matriz && (
      <div data-reveal data-reveal-delay="160" class="mt-5">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-sm font-semibold text-accent-content">
          <Icon name="lucide:star" class="h-4 w-4" /> Iglesia Matriz
        </span>
      </div>
    )}
  </PageHero>

  <!-- Breadcrumbs -->
  <div class="border-b border-base-300 bg-base-100 px-4 py-3">
    <div class="container mx-auto max-w-6xl text-sm breadcrumbs">
      <ul>
        <li><a href="/" class="link link-hover">Inicio</a></li>
        <li><a href="/#templos" class="link link-hover">Templos</a></li>
        <li>{templo.short}</li>
      </ul>
    </div>
  </div>

  <!-- Info -->
  <section class="bg-base-100 px-4 py-20">
    <div class="container mx-auto max-w-6xl">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Ubicación -->
        <Reveal class="md:col-span-2">
          <div class="overflow-hidden rounded-3xl border border-base-300 bg-base-100 shadow-sm">
            <div class="grid md:grid-cols-2">
              <div class="p-8">
                <div class="mb-4 flex items-center gap-3">
                  <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                    <Icon name="lucide:map-pin" class="h-6 w-6" />
                  </span>
                  <h2 class="card-title text-2xl">Ubicación</h2>
                </div>
                <ul class="space-y-2 text-base-content/80">
                  <li class="flex items-center gap-2"><Icon name="lucide:navigation" class="h-4 w-4 text-accent" /> {templo.address}</li>
                  <li class="flex items-center gap-2"><Icon name="lucide:building-2" class="h-4 w-4 text-accent" /> {templo.city}</li>
                  <li class="flex items-center gap-2"><Icon name="lucide:map" class="h-4 w-4 text-accent" /> {templo.region}</li>
                </ul>
                <a href={templo.mapLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm mt-5 gap-2">
                  <Icon name="lucide:navigation" class="h-4 w-4" /> Cómo llegar
                </a>
              </div>
              <iframe
                src={templo.mapEmbed}
                title={`Mapa de ${templo.name}`}
                class="h-64 w-full md:h-full"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </Reveal>

        <!-- Horarios -->
        <Reveal delay={80}>
          <div class="h-full rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
            <div class="mb-5 flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-secondary/10 text-secondary">
                <Icon name="lucide:clock" class="h-6 w-6" />
              </span>
              <h2 class="card-title text-2xl">Horarios</h2>
            </div>
            <div class="space-y-3">
              {templo.schedule.map((s) => (
                <div class="rounded-xl bg-base-200 p-3">
                  <div class={`badge badge-${s.tone} mb-1`}>{s.day}</div>
                  {s.services.map((svc) => <p class="text-sm text-base-content/80">{svc}</p>)}
                </div>
              ))}
            </div>
          </div>
        </Reveal>

        <!-- Líder -->
        <Reveal delay={160}>
          <div class="flex h-full flex-col rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
            <div class="mb-5 flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-accent/10 text-accent">
                <Icon name="lucide:user" class="h-6 w-6" />
              </span>
              <h2 class="card-title text-2xl">{templo.leader.role.startsWith('Obrero') ? 'Hermano a cargo' : 'Pastor a cargo'}</h2>
            </div>
            <div class="flex items-center gap-4">
              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary to-secondary font-display text-xl font-bold text-primary-content">
                {initials}
              </div>
              <div>
                <h3 class="text-lg font-bold">{templo.leader.name}</h3>
                <p class="text-sm text-base-content/60">{templo.leader.role}</p>
              </div>
            </div>
            <div class="mt-5 space-y-2 text-sm">
              <a href={`tel:${CONTACT.phoneHref}`} class="flex items-center gap-2 text-base-content/80 hover:text-primary">
                <Icon name="lucide:phone" class="h-4 w-4 text-accent" /> {CONTACT.phone}
              </a>
              <a href={`mailto:${CONTACT.email}`} class="flex items-center gap-2 break-all text-base-content/80 hover:text-primary">
                <Icon name="lucide:mail" class="h-4 w-4 text-accent" /> {CONTACT.email}
              </a>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Selector de templos -->
  <section class="border-t border-base-300 bg-base-200/60 px-4 py-12">
    <div class="container mx-auto max-w-6xl">
      <h2 class="mb-6 text-center text-xs font-semibold uppercase tracking-[0.2em] text-base-content/60">Conoce nuestros templos</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {templos.map((t) => (
          <a
            href={`/templos/${t.slug}`}
            aria-current={t.slug === templo.slug ? 'page' : undefined}
            class={`inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition ${t.slug === templo.slug ? 'border-primary bg-primary text-primary-content shadow-sm' : 'border-base-300 bg-base-100 hover:-translate-y-0.5 hover:border-primary hover:text-primary'}`}
          >
            <Icon name="lucide:map-pin" class="h-4 w-4" /> {t.short}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-dark px-4 py-20 text-center">
    <Reveal>
      <h2 class="font-display text-3xl font-bold text-white md:text-4xl">¡Te esperamos!</h2>
      <p class="mx-auto mt-3 max-w-lg text-white/70">Ven y sé parte de nuestra familia de fe en {templo.short}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={templo.mapLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary gap-2">
          <Icon name="lucide:navigation" class="h-5 w-5" /> Cómo llegar
        </a>
        <a href="/" class="btn gap-2 border-white/60 bg-transparent text-white hover:bg-white hover:text-neutral">Volver al inicio</a>
      </div>
    </Reveal>
  </section>
</Layout>
