---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Reveal from './Reveal.astro';
import ScheduleList from './ScheduleList.astro';
import CtaBand from './CtaBand.astro';
import { Icon } from 'astro-icon/components';
import { getTemplo, getSiblings, templos } from '../data/templos';
import { CONTACT, hasPhone } from '../data/site';
import { IMG } from '../assets/images';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const templo = getTemplo(slug);
if (!templo) {
  throw new Error(`Templo no encontrado: ${slug}`);
}

const { prev, next } = getSiblings(slug);

// Iniciales del líder (sin el título Pastor/Hermano)
const initials = templo.leader.name
  .replace(/^(Pastor|Pastora|Hermano|Hermana|Rev\.?)\s+/i, '')
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

const reuniones = templo.schedule.reduce((n, s) => n + s.services.length, 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: `La Casa de Dios · ${templo.name}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: templo.address,
    addressLocality: templo.city,
    addressRegion: templo.region,
    addressCountry: 'CL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: templo.coords.lat, longitude: templo.coords.lng },
  hasMap: templo.mapLink,
};
---

<Layout
  title={`${templo.name} · La Casa de Dios`}
  description={`${templo.name} — ${templo.address}. Horarios de cultos y reuniones de La Casa de Dios en ${templo.city}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <PageHero
    image={IMG[templo.image]}
    alt={templo.name}
    eyebrow={templo.region}
    title={templo.name}
    subtitle={templo.address}
  >
    {
      templo.matriz && (
        <div data-reveal data-reveal-delay="160" class="mt-5">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-sm font-semibold text-accent-content">
            <Icon name="lucide:star" class="h-4 w-4" /> Iglesia Matriz
          </span>
        </div>
      )
    }
  </PageHero>

  <Breadcrumbs
    items={[
      { label: 'Inicio', href: '/' },
      { label: 'Templos', href: '/templos' },
      { label: templo.short },
    ]}
  />

  <!-- Info -->
  <section class="section bg-base-100">
    <div class="wrap">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Ubicación -->
        <Reveal class="md:col-span-2">
          <div class="panel overflow-hidden">
            <div class="grid md:grid-cols-2">
              <div class="p-8">
                <div class="mb-4 flex items-center gap-3">
                  <span class="tile">
                    <Icon name="lucide:map-pin" class="h-6 w-6" />
                  </span>
                  <h2 class="card-title text-2xl">Ubicación</h2>
                </div>
                <ul class="space-y-2 text-base-content/80">
                  <li class="flex items-center gap-2">
                    <Icon name="lucide:navigation" class="h-4 w-4 shrink-0 text-accent" />
                    {templo.address}
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="lucide:building-2" class="h-4 w-4 shrink-0 text-accent" />
                    {templo.city}
                  </li>
                  <li class="flex items-center gap-2">
                    <Icon name="lucide:map" class="h-4 w-4 shrink-0 text-accent" />
                    {templo.region}
                  </li>
                </ul>
                <a
                  href={templo.mapLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary btn-sm mt-5 gap-2"
                >
                  <Icon name="lucide:navigation" class="h-4 w-4" /> Cómo llegar
                </a>
              </div>
              <iframe
                src={templo.mapEmbed}
                title={`Mapa de ${templo.name}`}
                class="h-64 w-full md:h-full md:min-h-[20rem]"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>
        </Reveal>

        <!-- Horarios -->
        <Reveal delay={80}>
          <div class="panel h-full p-8">
            <div class="mb-5 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="tile tile-secondary">
                  <Icon name="lucide:clock" class="h-6 w-6" />
                </span>
                <h2 class="card-title text-2xl">Horarios</h2>
              </div>
              <span class="text-xs text-base-content/55">{reuniones} por semana</span>
            </div>

            <ScheduleList schedule={templo.schedule} />

            <a
              href={`/horarios?templo=${templo.slug}`}
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent"
            >
              Ver esta sede en el calendario semanal <Icon
                name="lucide:arrow-right"
                class="h-4 w-4"
              />
            </a>
          </div>
        </Reveal>

        <!-- Líder -->
        <Reveal delay={160}>
          <div class="panel flex h-full flex-col p-8">
            <div class="mb-5 flex items-center gap-3">
              <span class="tile tile-accent">
                <Icon name="lucide:user" class="h-6 w-6" />
              </span>
              <h2 class="card-title text-2xl">
                {templo.leader.role.startsWith('Obrero') ? 'Hermano a cargo' : 'Pastor a cargo'}
              </h2>
            </div>
            <div class="flex items-center gap-4">
              <div
                class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-primary to-secondary font-data text-xl font-bold text-primary-content"
              >
                {initials}
              </div>
              <div class="min-w-0">
                <h3 class="text-lg font-bold">{templo.leader.name}</h3>
                <p class="text-sm text-base-content/60">{templo.leader.role}</p>
              </div>
            </div>

            <div class="mt-6 space-y-2 text-sm">
              <a
                href={`mailto:${CONTACT.email}`}
                class="flex items-center gap-2 break-all text-base-content/80 hover:text-primary"
              >
                <Icon name="lucide:mail" class="h-4 w-4 shrink-0 text-accent" />
                {CONTACT.email}
              </a>
              {
                hasPhone && (
                  <a
                    href={`tel:${CONTACT.phoneHref}`}
                    class="flex items-center gap-2 text-base-content/80 hover:text-primary"
                  >
                    <Icon name="lucide:phone" class="h-4 w-4 shrink-0 text-accent" />{' '}
                    {CONTACT.phone}
                  </a>
                )
              }
            </div>

            <a href="/contacto" class="btn btn-outline btn-sm mt-6 w-fit gap-2 md:mt-auto">
              <Icon name="lucide:message-square" class="h-4 w-4" /> Escribir a la iglesia
            </a>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Selector de templos -->
  <section class="border-t border-base-300 bg-base-200/60 px-4 py-12">
    <div class="wrap">
      <h2
        class="mb-6 text-center text-xs font-semibold uppercase tracking-[0.2em] text-base-content/60"
      >
        Conoce nuestros templos
      </h2>
      <div class="flex flex-wrap justify-center gap-3">
        {
          templos.map((t) => (
            <a
              href={`/templos/${t.slug}`}
              aria-current={t.slug === templo.slug ? 'page' : undefined}
              class={`inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-medium transition ${t.slug === templo.slug ? 'border-primary bg-primary text-primary-content shadow-sm' : 'border-base-300 bg-base-100 hover:-translate-y-0.5 hover:border-primary hover:text-primary'}`}
            >
              <Icon name="lucide:map-pin" class="h-4 w-4" /> {t.short}
            </a>
          ))
        }
      </div>

      <!-- Anterior / siguiente -->
      <div
        class="mt-8 flex flex-col gap-3 border-t border-base-300 pt-6 sm:flex-row sm:justify-between"
      >
        <a
          href={`/templos/${prev.slug}`}
          class="group inline-flex items-center gap-2 text-sm text-base-content/70 hover:text-primary"
        >
          <Icon
            name="lucide:arrow-left"
            class="h-4 w-4 transition-transform group-hover:-translate-x-1"
          />
          <span><span class="hidden sm:inline">Anterior: </span>{prev.short}</span>
        </a>
        <a href="/templos" class="text-sm font-medium text-primary hover:text-accent"
          >Ver los cuatro templos</a
        >
        <a
          href={`/templos/${next.slug}`}
          class="group inline-flex items-center gap-2 text-sm text-base-content/70 hover:text-primary"
        >
          <span><span class="hidden sm:inline">Siguiente: </span>{next.short}</span>
          <Icon
            name="lucide:arrow-right"
            class="h-4 w-4 transition-transform group-hover:translate-x-1"
          />
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="¡Te esperamos!"
    text={`Ven y sé parte de nuestra familia de fe en ${templo.short}.`}
    compact
  >
    <a
      href={templo.mapLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-primary gap-2"
    >
      <Icon name="lucide:navigation" class="h-5 w-5" /> Cómo llegar
    </a>
    <a href="/contacto" class="btn gap-2 btn-invert">
      <Icon name="lucide:mail" class="h-5 w-5" /> Escríbenos
    </a>
  </CtaBand>
</Layout>
