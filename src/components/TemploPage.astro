</style>

<script>
  import { momentoEnChile, proximaReunion, type Reunion } from '../lib/reuniones';

  /*
   * Lo que se mueve: qué día es hoy, cuál es la próxima reunión y en cuánto
   * empieza. Se calcula acá y no en el servidor porque la página va con caché
   * de CDN: un «hoy» escrito arriba llegaría caducado al segundo visitante.
   */
  function faltan(minutos: number): string {
    if (minutos <= 0) return 'está empezando';
    if (minutos < 60) return `en ${minutos} min`;
    const horas = Math.floor(minutos / 60);
    if (horas < 24) return `en ${horas} h${minutos % 60 ? ` ${minutos % 60} min` : ''}`;
    const dias = Math.round(horas / 24);
    return dias <= 1 ? 'mañana' : `en ${dias} días`;
  }

  function pintarFicha() {
    const ficha = document.querySelector<HTMLElement>('.ficha[data-reuniones]');
    if (!ficha) return;

    let reuniones: Reunion[];
    try {
      reuniones = JSON.parse(ficha.dataset.reuniones ?? '[]');
    } catch {
      return;
    }

    const ahora = momentoEnChile();

    // El día de hoy, marcado en la rejilla.
    ficha.querySelectorAll<HTMLElement>('.dia').forEach((dia) => {
      const esHoy = Number(dia.dataset.dia) === ahora.dia;
      dia.classList.toggle('es-hoy', esHoy);
      const etiqueta = dia.querySelector<HTMLElement>('[data-hoy]');
      if (etiqueta) etiqueta.hidden = !esHoy;
    });

    const p = proximaReunion(reuniones, ahora);
    if (!p.reunion) return;

    // La reunión que viene, marcada donde está.
    const marcada = ficha.querySelector<HTMLElement>(
      `.reunion[data-id="${CSS.escape(p.reunion.id)}"]`,
    );
    marcada?.classList.add('es-proxima');
    const marca = marcada?.querySelector<HTMLElement>('[data-marca]');
    if (marca) marca.hidden = false;

    // Y la línea de la portada, con cuánto falta.
    const texto = ficha.querySelector<HTMLElement>('[data-proxima-texto]');
    if (!texto) return;

    const [h, m] = p.reunion.hora.split(':').map(Number);
    const SEMANA = 7 * 24 * 60;
    const diferencia = (p.reunion.dia - ahora.dia) * 24 * 60 + (h * 60 + m) - ahora.minutos;
    const restan = ((diferencia % SEMANA) + SEMANA) % SEMANA;

    const cuenta = restan < 48 * 60 ? ` · ${faltan(restan)}` : '';
    texto.textContent = `${p.cuando} ${p.reunion.hora} · ${p.reunion.nombre}${cuenta}`;
  }

  document.addEventListener('astro:page-load', pintarFicha);
</script>
