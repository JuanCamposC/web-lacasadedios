---
import { Icon } from 'astro-icon/components';
import { enlaceGoogleCalendar } from '../lib/ics';
import type { Evento } from '../lib/datos';

/**
 * Compartir un evento y agendarlo.
 *
 * SOLO GOOGLE CALENDAR. Antes había también un `.ics` descargable para Apple
 * Calendar y Outlook. Se quitó: mantener un generador de ICS correcto —plegado
 * de líneas a 75 octetos, escapes, saltos CRLF que Outlook comprueba— es mucho
 * trabajo para un formato que, en Android, además baja un archivo que hay que
 * ir a buscar. Google Calendar es un enlace que abre el evento ya rellenado, y
 * es lo que usa la congregación.
 */
interface Props {
  evento: Evento;
  /** Dirección absoluta del sitio, sin barra final. */
  sitio: string;
}
const { evento, sitio } = Astro.props;

const enlace = `${sitio}/eventos#e-${evento.id}`;
const google = enlaceGoogleCalendar({
  id: evento.id,
  titulo: evento.titulo,
  inicio: evento.fecha,
  descripcion: evento.descripcion,
  lugar: evento.lugar,
  url: enlace,
});
---

<div class="mt-auto pt-5">
  <div class="flex flex-wrap items-center gap-1 border-t border-base-300 pt-4">
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-base-content/70 transition hover:bg-base-200 hover:text-base-content"
      data-compartir
      data-url={enlace}
      data-titulo={evento.titulo}
    >
      <Icon name="lucide:share-2" class="h-4 w-4" />
      <span data-rotulo>Compartir</span>
    </button>

    <!-- Con una sola opción ya no hace falta desplegable: era un clic de más
         para llegar a lo único que había dentro. -->
    <a
      href={google}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-base-content/70 transition hover:bg-base-200 hover:text-base-content"
    >
      <Icon name="lucide:calendar-plus" class="h-4 w-4" />
      Agregar a Google Calendar
    </a>
  </div>
</div>

<script>
  /**
   * Compartir.
   *
   * En el teléfono abre la hoja del sistema, con WhatsApp, Instagram y lo que
   * la persona tenga instalado; en el escritorio, donde casi ningún navegador
   * la trae, copia el enlace. Un solo botón en vez de tres iconos de redes:
   * cabe mejor en la ficha y no obliga a adivinar por dónde comparte cada uno.
   *
   * Va por delegación en el documento: hay un botón por evento y no tiene
   * sentido colgar un escuchador de cada uno.
   */
  /*
   * La guardia es una variable del módulo y no una marca en el <body>.
   *
   * Con las transiciones de vista, Astro REEMPLAZA el <body> entero en cada
   * navegación: la marca se iba con el body viejo, la función volvía a colgar
   * su escuchador, y al cabo de tres páginas «Compartir» se ejecutaba tres
   * veces. El módulo, en cambio, se evalúa una sola vez por sesión.
   */
  let listo = false;

  function initCompartirEventos() {
    if (listo) return;
    listo = true;

    document.addEventListener('click', async (ev) => {
      const btn = (ev.target as HTMLElement)?.closest?.('[data-compartir]') as HTMLElement | null;
      if (!btn) return;

      const url = btn.dataset.url ?? location.href;
      const title = btn.dataset.titulo ?? '';
      const rotulo = btn.querySelector('[data-rotulo]');

      const avisar = (texto: string) => {
        if (!rotulo) return;
        const antes = rotulo.textContent;
        rotulo.textContent = texto;
        setTimeout(() => (rotulo.textContent = antes), 1800);
      };

      if (navigator.share) {
        try {
          await navigator.share({ title, text: title, url });
          return;
        } catch {
          // Cancelar la hoja del sistema también llega aquí: no se hace nada
          // más, porque copiar el enlace sin que lo pidan sería una sorpresa.
          return;
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        avisar('¡Copiado!');
      } catch {
        avisar('No se pudo copiar');
      }
    });
  }

  document.addEventListener('astro:page-load', initCompartirEventos);
</script>
