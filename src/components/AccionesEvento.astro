---
import { Icon } from 'astro-icon/components';
import { enlaceGoogleCalendar } from '../lib/ics';
import type { Evento } from '../lib/datos';

/**
 * Compartir un evento y agendarlo.
 *
 * ── UN SOLO BOTÓN, DOS DESTINOS ─────────────────────────────────────────────
 * «Agregar al calendario» lleva a sitios distintos según el aparato:
 *
 *   · iPhone y iPad → el archivo `.ics` (/api/evento/<id>.ics), que iOS abre en
 *     el calendario del propio teléfono sin pedir cuenta de nada.
 *   · Todo lo demás → Google Calendar, que abre el evento ya relleno.
 *
 * El motivo de no ofrecer los dos: en iOS, el enlace de Google lleva a una
 * cuenta que mucha gente no usa y el evento no llega nunca al calendario; y en
 * Android el archivo baja a Descargas y hay que ir a buscarlo. Cada aparato
 * recibe el que de verdad le sirve, y quien mira ve un botón, no una elección.
 *
 * El enlace del `.ics` está SIEMPRE en el `href`: sin JavaScript se agenda
 * igual, y es el camino que nunca depende de una cuenta ajena.
 */
interface Props {
  evento: Evento;
  /** Dirección absoluta del sitio, sin barra final. */
  sitio: string;
}
const { evento, sitio } = Astro.props;

const enlace = `${sitio}/eventos#e-${evento.id}`;
const archivoIcs = `/api/evento/${evento.id}.ics`;
const google = enlaceGoogleCalendar({
  id: evento.id,
  titulo: evento.titulo,
  inicio: evento.fecha,
  descripcion: evento.descripcion,
  lugar: evento.lugar,
  url: enlace,
});
---

<div class="mt-auto pt-5">
  <div class="flex flex-wrap items-center gap-1 border-t border-base-300 pt-4">
    <button
      type="button"
      class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-base-content/70 transition hover:bg-base-200 hover:text-base-content"
      data-compartir
      data-url={enlace}
      data-titulo={evento.titulo}
    >
      <Icon name="lucide:share-2" class="h-4 w-4" />
      <span data-rotulo>Compartir</span>
    </button>

    <a
      href={archivoIcs}
      data-agendar
      data-google={google}
      class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm font-medium text-base-content/70 transition hover:bg-base-200 hover:text-base-content"
    >
      <Icon name="lucide:calendar-plus" class="h-4 w-4" />
      Agregar al calendario
    </a>
  </div>
</div>

<script>
  /**
   * Compartir.
   *
   * En el teléfono abre la hoja del sistema, con WhatsApp, Instagram y lo que
   * la persona tenga instalado; en el escritorio, donde casi ningún navegador
   * la trae, copia el enlace. Un solo botón en vez de tres iconos de redes:
   * cabe mejor en la ficha y no obliga a adivinar por dónde comparte cada uno.
   *
   * Va por delegación en el documento: hay un botón por evento y no tiene
   * sentido colgar un escuchador de cada uno.
   */
  /*
   * La guardia es una variable del módulo y no una marca en el <body>.
   *
   * Con las transiciones de vista, Astro REEMPLAZA el <body> entero en cada
   * navegación: la marca se iba con el body viejo, la función volvía a colgar
   * su escuchador, y al cabo de tres páginas «Compartir» se ejecutaba tres
   * veces. El módulo, en cambio, se evalúa una sola vez por sesión.
   */
  let listo = false;

  /**
   * ¿Es un iPhone o un iPad?
   *
   * Los iPad modernos se anuncian como «Macintosh», así que un iPad con
   * ratón conectado no cae en la primera prueba; la segunda lo caza: un Mac
   * de verdad no tiene pantalla táctil.
   *
   * `MSStream` descarta Internet Explorer móvil, que mentía diciendo ser
   * iPhone. Queda por si alguien abre el sitio desde un teléfono viejo.
   */
  function esApple(): boolean {
    const ua = navigator.userAgent || navigator.vendor || '';
    if (/iPad|iPhone|iPod/.test(ua) && !('MSStream' in window)) return true;
    return /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
  }

  function initCompartirEventos() {
    if (listo) return;
    listo = true;

    // En todo lo que no sea iPhone o iPad, el botón pasa a Google Calendar.
    // El `href` del HTML sigue siendo el archivo .ics, que es lo que se usa
    // sin JavaScript y lo que ve quien copia el enlace.
    document.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement)?.closest?.(
        '[data-agendar]',
      ) as HTMLAnchorElement | null;
      if (!btn || esApple()) return;
      const google = btn.dataset.google;
      if (!google) return;
      ev.preventDefault();
      window.open(google, '_blank', 'noopener');
    });

    document.addEventListener('click', async (ev) => {
      const btn = (ev.target as HTMLElement)?.closest?.('[data-compartir]') as HTMLElement | null;
      if (!btn) return;

      const url = btn.dataset.url ?? location.href;
      const title = btn.dataset.titulo ?? '';
      const rotulo = btn.querySelector('[data-rotulo]');

      const avisar = (texto: string) => {
        if (!rotulo) return;
        const antes = rotulo.textContent;
        rotulo.textContent = texto;
        setTimeout(() => (rotulo.textContent = antes), 1800);
      };

      if (navigator.share) {
        try {
          await navigator.share({ title, text: title, url });
          return;
        } catch {
          // Cancelar la hoja del sistema también llega aquí: no se hace nada
          // más, porque copiar el enlace sin que lo pidan sería una sorpresa.
          return;
        }
      }

      try {
        await navigator.clipboard.writeText(url);
        avisar('¡Copiado!');
      } catch {
        avisar('No se pudo copiar');
      }
    });
  }

  document.addEventListener('astro:page-load', initCompartirEventos);
</script>
