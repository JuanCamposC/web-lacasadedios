---
import { Icon } from 'astro-icon/components';
import { templos, estiloDistintivo, type Templo } from '../data/templos';
import { horaCorta } from '../lib/hora';
import { enlaceGoogleCalendar } from '../lib/ics';
import { urlMedio } from '../lib/medios';
import {
  casillasDe,
  comoParametro,
  DIAS_LUNES,
  MESES,
  enPalabras,
  fechaDeEvento,
  mesAnterior,
  mesSiguiente,
  reunionesEnFecha,
  type Mes,
} from '../lib/calendario';
import { fechaEnPalabras, type Excepcion, type FilaReunion, type Reunion } from '../lib/reuniones';
import type { Evento } from '../lib/datos';

/**
 * El mes, en rejilla. SOLO lo extraprogramático.
 *
 * ── QUÉ ENTRA Y QUÉ NO ──────────────────────────────────────────────────────
 * Entran los eventos y los cambios de un día: la reunión que ese día se
 * suspende, cambia de hora o pasa a ser otra. Las reuniones de cada semana NO:
 * estaban como horas tenues en cada casilla y, en un mes normal, eran cinco
 * líneas por día que tapaban justo lo que se venía a ver. Lo recurrente vive en
 * /horarios, y el pie lo dice. (Decisión de la iglesia, 28-11-2026.)
 *
 * ── GRANDE, Y EL DETALLE EN UN MODAL ────────────────────────────────────────
 * Cada cosa es un bloque de color que se lee de lejos. Al tocarlo se abre un
 * modal con todo: fecha, hora, templo, lugar, afiche, descripción y cómo
 * agendarlo. El detalle ya viene en la página, escondido: abrirlo no pide nada
 * a la red y funciona igual sin conexión una vez cargado.
 *
 * ── EL ESTADO DE CADA REUNIÓN ES EL DE SU DÍA ───────────────────────────────
 * Lo resuelve `reunionesEnFecha`, con los cambios de un día (d1/0016).
 */
interface Props {
  mes: Mes;
  eventos: Evento[];
  reuniones: FilaReunion[];
  /** Los cambios de un día del mes. */
  excepciones: Excepcion[];
  /** Hoy en Chile, «AAAA-MM-DD», para marcar la casilla. */
  hoy: string;
  /** Lo que haya en la dirección, para que el filtro por templo sobreviva. */
  templo?: string | null;
}
const { mes, eventos, reuniones, excepciones, hoy, templo } = Astro.props;

const sitio = Astro.site?.toString().replace(/\/$/, '') ?? '';
const casillas = casillasDe(mes);
const colorDe = (slug: string) => templos.find((t) => t.slug === slug);

/* ── Lo que va en la rejilla ─────────────────────────────────────────────── */

interface ItemEvento {
  tipo: 'evento';
  clave: string;
  orden: string;
  evento: Evento;
  templo: Templo | undefined;
  hora: string;
  termina: string | null;
}

interface ItemCambio {
  tipo: 'cambio';
  clave: string;
  orden: string;
  reunion: Reunion;
  /** Cómo se llama de costumbre, si ese día se llama distinto. */
  nombreHabitual: string | null;
  /** La misma reunión cambiada igual en varios templos va en un solo bloque. */
  templos: Templo[];
}

type Item = ItemEvento | ItemCambio;

const nombreDe = (id: string) => reuniones.find((r) => r.id === id)?.nombre;

/**
 * ¿Se sale de lo normal? Suspendida, a otra hora o con otro nombre. El nombre
 * cuenta: en Limache, el miércoles 23 la de Jóvenes pasa a ser la General.
 */
const esEspecial = (r: Reunion) => {
  const habitual = nombreDe(r.id);
  return r.estado !== 'normal' || (habitual !== undefined && habitual !== r.nombre);
};

const itemsDe = new Map<string, Item[]>();
const todos: Item[] = [];

for (const c of casillas) {
  if (!c.delMes) continue;
  const items: Item[] = [];

  for (const e of eventos) {
    if (fechaDeEvento(e.fecha) !== c.fecha) continue;
    const termina =
      !e.todo_el_dia && e.duracion_min && e.duracion_min > 0
        ? horaCorta(new Date(new Date(e.fecha).getTime() + e.duracion_min * 60_000).toISOString())
        : null;
    items.push({
      tipo: 'evento',
      clave: `e-${e.id}`,
      // «Todo el día» va primero en el día.
      orden: e.todo_el_dia ? '00:00' : horaCorta(e.fecha),
      evento: e,
      templo: colorDe(e.templo),
      hora: e.todo_el_dia ? 'Todo el día' : horaCorta(e.fecha),
      termina,
    });
  }

  // Los cambios iguales en varios templos se juntan: «suspendida por las
  // fiestas» en tres templos es UN bloque con tres distintivos, no tres.
  const grupos = new Map<string, ItemCambio>();
  for (const r of reunionesEnFecha(reuniones, c.fecha, excepciones, hoy).filter(esEspecial)) {
    const habitual = nombreDe(r.id) ?? r.nombre;
    const k = [r.hora, r.horaHabitual ?? '', r.nombre, habitual, r.estado, r.aviso ?? ''].join('|');
    const t = colorDe(r.templo);
    const g = grupos.get(k);
    if (g) {
      if (t) g.templos.push(t);
    } else {
      grupos.set(k, {
        tipo: 'cambio',
        clave: `c-${c.fecha}-${r.id}`,
        orden: r.hora,
        reunion: r,
        nombreHabitual: habitual !== r.nombre ? habitual : null,
        templos: t ? [t] : [],
      });
    }
  }
  items.push(...grupos.values());

  items.sort((a, b) => a.orden.localeCompare(b.orden));
  if (items.length) {
    itemsDe.set(c.fecha, items);
    todos.push(...items);
  }
}

/** La agenda de abajo: los días del mes con algo. */
const agenda = [...itemsDe.entries()].map(([fecha, items]) => ({ fecha, items }));

/** Una frase con lo que cambia, para el bloque y para el modal. */
function queCambia(i: ItemCambio): string {
  const r = i.reunion;
  if (r.estado === 'suspendida') return 'Suspendida';
  const partes: string[] = [];
  if (r.horaHabitual) partes.push(`a las ${r.hora}, no a las ${r.horaHabitual}`);
  if (i.nombreHabitual) partes.push(`en lugar de «${i.nombreHabitual}»`);
  return partes.length ? `Cambia: ${partes.join(', ')}` : 'Cambia';
}

/** Las clases del bloque, según qué es. */
/**
 * Las clases del bloque, según qué es.
 *
 * Los eventos mandan: color lleno del templo, sombra y título grande. Un
 * cambio de reunión es un aviso, no un titular: fondo claro, letra más chica y
 * una franja a la izquierda con el color del templo. Con los dos al mismo peso,
 * el jueves 24 eran tres bloques rojos tapando la Cena de Navidad.
 */
function claseBloque(i: Item): string {
  const base =
    'block w-full cursor-pointer text-left leading-tight transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
  if (i.tipo === 'evento')
    return `${base} rounded-md text-white shadow-sm hover:-translate-y-px hover:shadow-md`;
  return `${base} rounded-r border-l-4 hover:bg-base-300/70 ${
    i.reunion.estado === 'suspendida' ? 'bg-error/5' : 'bg-warning/15'
  }`;
}

/** La franja del cambio: el color del primer templo afectado. */
const franja = (i: ItemCambio) =>
  `border-left-color:${i.templos[0]?.color.fondo ?? 'var(--color-base-300)'}`;

const fondoEvento = (i: ItemEvento) =>
  `background:${i.templo ? i.templo.color.fondo : 'var(--color-primary)'}`;

/** La dirección de otro mes, conservando el filtro. */
function enlaceMes(m: Mes): string {
  const p = new URLSearchParams({ mes: comoParametro(m) });
  if (templo) p.set('templo', templo);
  return `/calendario?${p}`;
}

const anterior = mesAnterior(mes);
const siguiente = mesSiguiente(mes);
---

<div class="panel overflow-hidden">
  <!-- Cabecera: el mes y cómo moverse -->
  <header class="flex items-center justify-between gap-3 border-b border-base-300 bg-base-200/60 px-3 py-3">
    <a
      href={enlaceMes(anterior)}
      rel="prev"
      class="btn btn-ghost btn-sm gap-1.5"
      aria-label={`Ver ${enPalabras(anterior)}`}
    >
      <Icon name="lucide:chevron-left" class="h-5 w-5" />
      <span class="hidden sm:inline">{enPalabras(anterior).split(' de ')[0]}</span>
    </a>

    {/* `first-letter:uppercase` y NO `capitalize`: aquella pone mayúscula en
         CADA palabra y el título salía «Diciembre De 2026». */}
    <h2 class="font-display text-xl first-letter:uppercase md:text-2xl">{enPalabras(mes)}</h2>

    <a
      href={enlaceMes(siguiente)}
      rel="next"
      class="btn btn-ghost btn-sm gap-1.5"
      aria-label={`Ver ${enPalabras(siguiente)}`}
    >
      <span class="hidden sm:inline">{enPalabras(siguiente).split(' de ')[0]}</span>
      <Icon name="lucide:chevron-right" class="h-5 w-5" />
    </a>
  </header>

  <div class="grid grid-cols-7 border-b border-base-300 bg-base-200/30">
    {DIAS_LUNES.map((d) => (
      <div class="font-data px-1 py-2 text-center text-xs font-bold uppercase tracking-wider text-base-content/60">
        <span class="sm:hidden">{d.charAt(0)}</span>
        <span class="hidden sm:inline">{d}</span>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-7">
    {casillas.map((c) => {
      const items = c.delMes ? (itemsDe.get(c.fecha) ?? []) : [];
      const esHoy = c.fecha === hoy;
      return (
        <div
          class={`min-h-[5rem] border-b border-r border-base-300/70 p-1 last:border-r-0 sm:min-h-[8.5rem] sm:p-1.5 ${
            c.delMes ? '' : 'bg-base-200/40'
          } ${esHoy ? 'bg-accent/5 ring-2 ring-inset ring-accent/50' : ''}`}
        >
          <div
            class={`font-data mb-1 text-right text-sm ${
              esHoy
                ? 'font-bold text-accent'
                : c.delMes
                  ? 'text-base-content/70'
                  : 'text-base-content/30'
            }`}
          >
            {c.numero}
          </div>

          {/* En el teléfono una columna mide unos 50 px: el bloque lleva la
              hora en grande y el color; el título está a un toque, en el
              modal. Desde `sm` cabe el título entero. */}
          <div class="space-y-1">
            {items.map((i) =>
              i.tipo === 'evento' ? (
                <button
                  type="button"
                  data-abrir={i.clave}
                  class={`${claseBloque(i)} px-1 py-1.5 sm:px-2 sm:py-1.5`}
                  style={fondoEvento(i)}
                  aria-label={`${i.evento.titulo}, ${i.hora}`}
                >
                  <span class="font-data block text-center text-[0.7rem] font-bold sm:text-left sm:text-xs">
                    <span class="sm:hidden">{i.evento.todo_el_dia ? 'Día' : i.hora}</span>
                    <span class="hidden sm:inline">{i.hora}</span>
                  </span>
                  <span class="hidden text-sm font-semibold sm:line-clamp-3 sm:block">
                    {i.evento.titulo}
                  </span>
                </button>
              ) : (
                <button
                  type="button"
                  data-abrir={i.clave}
                  class={`${claseBloque(i)} px-1 py-1 sm:px-1.5`}
                  style={franja(i)}
                  aria-label={`${i.reunion.nombre}, ${queCambia(i)}`}
                >
                  <span class="flex items-center justify-center gap-1 sm:justify-start">
                    <span
                      class={`font-data text-[0.65rem] font-bold ${
                        i.reunion.estado === 'suspendida'
                          ? 'text-error line-through'
                          : 'text-base-content/80'
                      }`}
                    >
                      {i.reunion.hora}
                    </span>
                    <span
                      class={`hidden text-[0.6rem] font-semibold uppercase tracking-wide sm:inline ${
                        i.reunion.estado === 'suspendida' ? 'text-error' : 'text-base-content/70'
                      }`}
                    >
                      {i.reunion.estado === 'suspendida' ? 'Suspendida' : 'Cambio'}
                    </span>
                  </span>
                  <span class="hidden truncate text-xs text-base-content/75 sm:block">
                    {i.reunion.nombre}
                  </span>
                </button>
              ),
            )}
          </div>
        </div>
      );
    })}
  </div>

  <footer class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-base-300 bg-base-200/40 px-3 py-2.5 text-xs text-base-content/70">
    <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
      {templos.map((t) => (
        <span class="flex items-center gap-1.5">
          <span
            class="inline-block h-3 w-3 rounded-sm"
            style={estiloDistintivo(t) + `;background:${t.color.fondo}`}
            aria-hidden="true"
          />
          {t.short}
        </span>
      ))}
      <span class="flex items-center gap-1.5">
        <span
          class="inline-block h-3 w-3 rounded-r-sm border-l-4 border-base-content/40 bg-error/10"
          aria-hidden="true"
        ></span>
        Reunión suspendida
      </span>
      <span class="flex items-center gap-1.5">
        <span
          class="inline-block h-3 w-3 rounded-r-sm border-l-4 border-base-content/40 bg-warning/25"
          aria-hidden="true"
        ></span>
        Cambio de horario
      </span>
    </span>
    <span>
      Las reuniones de cada semana están en{' '}
      <a href="/horarios" class="link link-primary">
        Horarios
      </a>
    </span>
  </footer>
</div>

{/* ── El mes, en lista ───────────────────────────────────────────────────
     Lo mismo que la rejilla, con todas sus letras. En el teléfono es lo que
     se lee; cada línea abre el mismo modal. */}
<section class="mt-10" aria-labelledby="agenda-mes">
  <h3 id="agenda-mes" class="font-display text-xl md:text-2xl">
    {MESES[mes.mes - 1].charAt(0).toUpperCase() + MESES[mes.mes - 1].slice(1)}, día por día
  </h3>
  {agenda.length === 0 ? (
    <p class="mt-2 text-sm text-base-content/70">
      Este mes no hay actividades especiales: todas las reuniones van como siempre.
    </p>
  ) : (
    <ol class="mt-4 space-y-3">
      {agenda.map((d) => (
        <li class={`panel flex gap-4 p-4 ${d.fecha === hoy ? 'ring-2 ring-accent/50' : ''}`}>
          <div class="font-data w-12 shrink-0 text-center">
            <span class="block text-2xl font-bold leading-none">{Number(d.fecha.slice(8))}</span>
            <span class="mt-1 block text-[0.65rem] uppercase tracking-wider text-base-content/60">
              {fechaEnPalabras(d.fecha).slice(0, 3)}
            </span>
          </div>
          <ul class="min-w-0 flex-1 space-y-2">
            {d.items.map((i) => (
              <li>
                <button
                  type="button"
                  data-abrir={i.clave}
                  class="group flex w-full items-start gap-3 rounded-md p-1 text-left transition hover:bg-base-200"
                >
                  <span
                    class={`mt-1 h-3 w-3 shrink-0 rounded-sm ${
                      i.tipo === 'cambio'
                        ? i.reunion.estado === 'suspendida'
                          ? 'border border-error/50 bg-error/10'
                          : 'border border-warning/60 bg-warning/20'
                        : ''
                    }`}
                    style={i.tipo === 'evento' ? fondoEvento(i) : undefined}
                    aria-hidden="true"
                  />
                  <span class="min-w-0 flex-1">
                    {i.tipo === 'evento' ? (
                      <>
                        <span class="font-data mr-2 text-sm font-bold">{i.hora}</span>
                        <span class="font-semibold group-hover:underline">{i.evento.titulo}</span>
                        <span class="block text-xs text-base-content/70">
                          {i.templo ? i.templo.short : 'Toda la iglesia'}
                          {i.evento.lugar && ` · ${i.evento.lugar}`}
                        </span>
                      </>
                    ) : (
                      <>
                        <span
                          class={`font-data mr-2 text-sm font-bold ${i.reunion.estado === 'suspendida' ? 'text-base-content/50 line-through' : ''}`}
                        >
                          {i.reunion.hora}
                        </span>
                        <span class="font-semibold group-hover:underline">{i.reunion.nombre}</span>
                        <span
                          class={`block text-xs font-medium ${i.reunion.estado === 'suspendida' ? 'text-error' : 'text-warning-content'}`}
                        >
                          {queCambia(i)} · {i.templos.map((t) => t.short).join(', ')}
                        </span>
                      </>
                    )}
                  </span>
                  <Icon
                    name="lucide:chevron-right"
                    class="mt-1 h-4 w-4 shrink-0 text-base-content/40"
                  />
                </button>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  )}
</section>

{/* ── El modal ────────────────────────────────────────────────────────────
     Un solo <dialog> con todos los detalles del mes dentro, escondidos. Al
     tocar un bloque se enseña el suyo. Sin plantillas ni clonado: el afiche
     con `loading="lazy"` dentro de algo escondido no se descarga hasta que
     se abre. */}
<dialog id="cal-detalle" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box max-w-lg p-0">
    <form method="dialog" class="absolute right-2 top-2 z-10">
      <button class="btn btn-circle btn-ghost btn-sm bg-base-100/80" aria-label="Cerrar">
        <Icon name="lucide:x" class="h-5 w-5" />
      </button>
    </form>

    {todos.map((i) =>
      i.tipo === 'evento' ? (
        <article data-detalle={i.clave} hidden>
          {urlMedio(i.evento.imagen_clave) && (
            <div class="relative h-56 overflow-hidden rounded-t-box bg-base-200 sm:h-64">
              <img
                src={urlMedio(i.evento.imagen_clave)!}
                alt=""
                aria-hidden="true"
                loading="lazy"
                class="absolute inset-0 h-full w-full scale-125 object-cover blur-xl"
              />
              <img
                src={urlMedio(i.evento.imagen_clave)!}
                alt={i.evento.imagen_alt ?? i.evento.titulo}
                loading="lazy"
                class="relative h-full w-full object-contain"
              />
            </div>
          )}
          <div class="p-6">
            <p class="text-sm font-medium text-base-content/70 first-letter:uppercase">
              {fechaEnPalabras(fechaDeEvento(i.evento.fecha))}
            </p>
            <h3 class="mt-1 font-display text-2xl leading-tight md:text-3xl">{i.evento.titulo}</h3>

            <div class="mt-4 space-y-2 text-sm">
              <p class="flex items-center gap-2">
                <Icon name="lucide:clock" class="h-4 w-4 shrink-0 text-accent" />
                <span class="font-data font-bold">
                  {i.termina ? `${i.hora} a ${i.termina}` : i.hora}
                </span>
              </p>
              {i.evento.lugar && (
                <p class="flex items-center gap-2">
                  <Icon name="lucide:map-pin" class="h-4 w-4 shrink-0 text-accent" />
                  {i.evento.lugar}
                </p>
              )}
              <p class="flex items-center gap-2">
                <Icon name="lucide:church" class="h-4 w-4 shrink-0 text-accent" />
                {i.templo ? (
                  <span class="distintivo" style={estiloDistintivo(i.templo)}>
                    {i.templo.short}
                  </span>
                ) : (
                  'Toda la iglesia'
                )}
              </p>
            </div>

            {i.evento.descripcion && (
              <p class="mt-4 whitespace-pre-line text-base-content/80">{i.evento.descripcion}</p>
            )}

            <div class="mt-6 flex flex-wrap gap-2">
              <a
                href={`/api/evento/${i.evento.id}.ics`}
                class="btn btn-primary btn-sm gap-1.5"
                download
              >
                <Icon name="lucide:calendar-plus" class="h-4 w-4" /> Agendar
              </a>
              <a
                href={enlaceGoogleCalendar({
                  id: i.evento.id,
                  titulo: i.evento.titulo,
                  inicio: i.evento.fecha,
                  duracion: i.evento.duracion_min,
                  descripcion: i.evento.descripcion,
                  lugar: i.evento.lugar,
                  url: `${sitio}/eventos?e=${encodeURIComponent(i.evento.slug ?? i.evento.id)}`,
                  todoElDia: i.evento.todo_el_dia === 1,
                })}
                target="_blank"
                rel="noopener"
                class="btn btn-outline btn-sm gap-1.5"
              >
                Google Calendar
              </a>
              <a
                href={`/eventos?e=${encodeURIComponent(i.evento.slug ?? i.evento.id)}`}
                class="btn btn-ghost btn-sm gap-1.5"
              >
                <Icon name="lucide:share-2" class="h-4 w-4" /> Ver y compartir
              </a>
            </div>
          </div>
        </article>
      ) : (
        <article data-detalle={i.clave} hidden class="p-6">
          <p class="text-sm font-medium text-base-content/70 first-letter:uppercase">
            {fechaEnPalabras(i.clave.slice(2, 12))}
          </p>
          <h3 class="mt-1 font-display text-2xl leading-tight md:text-3xl">{i.reunion.nombre}</h3>

          <p
            class={`mt-3 inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm font-semibold ${
              i.reunion.estado === 'suspendida' ? 'bg-error/10 text-error' : 'bg-warning/20'
            }`}
          >
            <Icon
              name={
                i.reunion.estado === 'suspendida' ? 'lucide:calendar-x' : 'lucide:calendar-clock'
              }
              class="h-4 w-4"
            />
            {queCambia(i)}
          </p>

          <div class="mt-4 space-y-2 text-sm">
            <p class="flex items-center gap-2">
              <Icon name="lucide:clock" class="h-4 w-4 shrink-0 text-accent" />
              <span class="font-data font-bold">
                {i.reunion.estado === 'suspendida' ? (
                  <span class="text-base-content/50 line-through">{i.reunion.hora}</span>
                ) : (
                  i.reunion.hora
                )}
              </span>
            </p>
            <p class="flex flex-wrap items-center gap-2">
              <Icon name="lucide:church" class="h-4 w-4 shrink-0 text-accent" />
              {i.templos.map((t) => (
                <span class="distintivo" style={estiloDistintivo(t)}>
                  {t.short}
                </span>
              ))}
            </p>
          </div>

          {i.reunion.aviso && <p class="mt-4 text-base-content/80">{i.reunion.aviso}</p>}

          <div class="mt-6">
            <a href="/horarios" class="btn btn-ghost btn-sm gap-1.5">
              <Icon name="lucide:clock" class="h-4 w-4" /> Horarios de cada semana
            </a>
          </div>
        </article>
      ),
    )}
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>cerrar</button>
  </form>
</dialog>

<script>
  /*
   * Abre el modal con el detalle del bloque tocado. Un solo escuchador en el
   * documento: los bloques de la rejilla y las líneas de la lista comparten el
   * mismo `data-abrir`.
   *
   * Con el ClientRouter la página no se recarga al cambiar de mes, así que el
   * escuchador se engancha una vez y busca el diálogo en cada clic, que es el
   * de la página que esté puesta.
   */
  document.addEventListener('click', (ev) => {
    const boton = (ev.target as HTMLElement | null)?.closest<HTMLElement>('[data-abrir]');
    if (!boton) return;
    const dlg = document.getElementById('cal-detalle') as HTMLDialogElement | null;
    if (!dlg) return;
    dlg.querySelectorAll<HTMLElement>('[data-detalle]').forEach((a) => {
      a.hidden = a.dataset.detalle !== boton.dataset.abrir;
    });
    dlg.querySelector('.modal-box')?.scrollTo(0, 0);
    dlg.showModal();
  });
</script>
