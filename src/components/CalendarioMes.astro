---
import { Icon } from 'astro-icon/components';
import { templos, estiloDistintivo } from '../data/templos';
import { horaCorta } from '../lib/hora';
import {
  casillasDe,
  comoParametro,
  DIAS_LUNES,
  MESES,
  enPalabras,
  fechaDeEvento,
  mesAnterior,
  mesSiguiente,
  reunionesEnFecha,
  type Mes,
} from '../lib/calendario';
import { fechaEnPalabras, type Excepcion, type FilaReunion, type Reunion } from '../lib/reuniones';
import type { Evento } from '../lib/datos';

/**
 * El mes, en rejilla.
 *
 * ── QUÉ PESA Y QUÉ ACOMPAÑA ─────────────────────────────────────────────────
 * Los eventos son lo que se viene a ver: van en bloque, con el color de su
 * templo y su título legible. Las reuniones de cada semana van debajo, tenues
 * y solo con la hora: están para que un día con reunión no parezca vacío, no
 * para leerse una por una. Si las dos cosas pesaran igual, en un mes normal
 * cada casilla llevaría cinco reuniones y el congreso se perdería entre ellas
 * — que es exactamente lo que un calendario tiene que evitar.
 *
 * Para el detalle de las reuniones está /horarios, y el pie lo dice.
 *
 * ── EL ESTADO DE CADA REUNIÓN ES EL DE SU DÍA ───────────────────────────────
 * No el de hoy. Una suspendida hasta el día 8 sale tachada el 4 y normal el
 * 11, y un cambio de un día (d1/0016) solo se ve en su fecha. Lo resuelve
 * `reunionesEnFecha`; el porqué está ahí.
 *
 * ── LA AGENDA DE ABAJO ──────────────────────────────────────────────────────
 * En el teléfono la rejilla solo alcanza para decir QUÉ DÍAS hay algo. Lo que
 * se sale de lo normal —los eventos y las reuniones que ese día se suspenden o
 * cambian— se repite debajo, día por día y con todas sus letras. En diciembre
 * eso es casi todo lo que la gente necesita saber del mes.
 */
interface Props {
  mes: Mes;
  eventos: Evento[];
  reuniones: FilaReunion[];
  /** Los cambios de un día del mes. */
  excepciones: Excepcion[];
  /** Hoy en Chile, «AAAA-MM-DD», para marcar la casilla. */
  hoy: string;
  /** Lo que haya en la dirección, para que el filtro por templo sobreviva. */
  templo?: string | null;
}
const { mes, eventos, reuniones, excepciones, hoy, templo } = Astro.props;

const casillas = casillasDe(mes);

/** Los eventos de cada día, ya agrupados: la rejilla no busca dentro del bucle. */
const porDia = new Map<string, Evento[]>();
for (const e of eventos) {
  const f = fechaDeEvento(e.fecha);
  const lista = porDia.get(f);
  if (lista) lista.push(e);
  else porDia.set(f, [e]);
}

const colorDe = (slug: string) => templos.find((t) => t.slug === slug);

/** Las reuniones de cada día del mes, resueltas UNA vez para rejilla y agenda. */
const reunionesDe = new Map<string, Reunion[]>();
for (const c of casillas) {
  if (c.delMes) reunionesDe.set(c.fecha, reunionesEnFecha(reuniones, c.fecha, excepciones, hoy));
}

/**
 * ¿Se sale de lo normal? Suspendida, a otra hora o con otro nombre.
 *
 * El nombre cuenta: en Limache, el miércoles 23 la reunión de Jóvenes pasa a
 * ser la Reunión General. A la misma hora, pero no es la reunión de siempre.
 */
const nombreHabitual = (id: string) => reuniones.find((r) => r.id === id)?.nombre;
const otroNombre = (r: Reunion) => {
  const habitual = nombreHabitual(r.id);
  return habitual !== undefined && habitual !== r.nombre;
};
const esEspecial = (r: Reunion) => r.estado !== 'normal' || otroNombre(r);

/** La agenda de abajo: solo los días del mes con algo fuera de lo normal. */
const agenda = casillas
  .filter((c) => c.delMes)
  .map((c) => ({
    fecha: c.fecha,
    eventos: porDia.get(c.fecha) ?? [],
    cambios: (reunionesDe.get(c.fecha) ?? []).filter(esEspecial),
  }))
  .filter((d) => d.eventos.length > 0 || d.cambios.length > 0);

/** La dirección de otro mes, conservando el filtro. */
function enlaceMes(m: Mes): string {
  const p = new URLSearchParams({ mes: comoParametro(m) });
  if (templo) p.set('templo', templo);
  return `/calendario?${p}`;
}

const anterior = mesAnterior(mes);
const siguiente = mesSiguiente(mes);
---

<div class="panel overflow-hidden">
  <!-- Cabecera: el mes y cómo moverse -->
  <header class="flex items-center justify-between gap-3 border-b border-base-300 bg-base-200/60 px-3 py-2.5">
    <a
      href={enlaceMes(anterior)}
      rel="prev"
      class="btn btn-ghost btn-sm gap-1.5"
      aria-label={`Ver ${enPalabras(anterior)}`}
    >
      <Icon name="lucide:chevron-left" class="h-4 w-4" />
      <span class="hidden sm:inline">{enPalabras(anterior).split(' de ')[0]}</span>
    </a>

    {/* `first-letter:uppercase` y NO `capitalize`: aquella pone mayúscula en
         CADA palabra y el título salía «Diciembre De 2026». En castellano el
         mes va en minúscula y solo se levanta la primera letra por ir al
         principio de una frase. */}
    <h3 class="font-display text-lg first-letter:uppercase md:text-xl">{enPalabras(mes)}</h3>

    <a
      href={enlaceMes(siguiente)}
      rel="next"
      class="btn btn-ghost btn-sm gap-1.5"
      aria-label={`Ver ${enPalabras(siguiente)}`}
    >
      <span class="hidden sm:inline">{enPalabras(siguiente).split(' de ')[0]}</span>
      <Icon name="lucide:chevron-right" class="h-4 w-4" />
    </a>
  </header>

  <!-- Los nombres de los días. En el teléfono solo la inicial: «Mié» en una
       columna de 45 px se corta, y una letra se entiende igual. -->
  <div class="grid grid-cols-7 border-b border-base-300 bg-base-200/30">
    {DIAS_LUNES.map((d) => (
      <div class="font-data px-1 py-1.5 text-center text-[0.65rem] font-bold uppercase tracking-wider text-base-content/60">
        <span class="sm:hidden">{d.charAt(0)}</span>
        <span class="hidden sm:inline">{d}</span>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-7">
    {casillas.map((c) => {
      const delDia = c.delMes ? (porDia.get(c.fecha) ?? []) : [];
      // Las que se salen de lo normal, primero: si hay que cortar en tres, que
      // no se corte justo la suspendida.
      const semanales = (reunionesDe.get(c.fecha) ?? [])
        .slice()
        .sort(
          (a, b) => Number(esEspecial(b)) - Number(esEspecial(a)) || a.hora.localeCompare(b.hora),
        );
      const esHoy = c.fecha === hoy;

      return (
        <div
          class={`min-h-[5.5rem] border-b border-r border-base-300/70 p-1 last:border-r-0 sm:min-h-[7rem] sm:p-1.5 ${
            c.delMes ? '' : 'bg-base-200/40'
          } ${esHoy ? 'bg-accent/5 ring-1 ring-inset ring-accent/40' : ''}`}
        >
          <div
            class={`font-data mb-1 text-right text-xs ${
              esHoy
                ? 'font-bold text-accent'
                : c.delMes
                  ? 'text-base-content/60'
                  : 'text-base-content/30'
            }`}
          >
            {c.numero}
          </div>

          {/* ── Los eventos: lo que se viene a ver ──────────────────────
                Siete columnas en un teléfono son unos 50 px cada una, y ahí un
                título se corta en «Bautis». Así que a ese ancho la casilla
                responde a «¿qué días hay algo?» —la hora, en el color de su
                templo— y el «¿qué es?» lo responde la vista de lista, que está
                a un toque. Desde `sm` cabe el título y se pone entero. */}
          {delDia.map((e) => {
            const t = colorDe(e.templo);
            return (
              <a
                href={`/eventos?e=${encodeURIComponent(e.slug ?? e.id)}`}
                data-etiqueta={e.templo}
                class="mb-1 block rounded px-1 py-0.5 text-center text-[0.6rem] leading-tight text-white transition hover:brightness-110 sm:px-1.5 sm:py-1 sm:text-left sm:text-xs"
                style={t ? `background:${t.color.fondo}` : 'background:var(--color-primary)'}
                title={`${e.titulo}${e.lugar ? ' · ' + e.lugar : ''}`}
              >
                <span class="font-data block font-bold">
                  {e.todo_el_dia ? 'Día' : horaCorta(e.fecha)}
                </span>
                <span class="hidden font-medium sm:line-clamp-2 sm:block">{e.titulo}</span>
              </a>
            );
          })}

          {/* Las de cada semana: contexto, no titular. Como mucho tres, y el
                resto contado — una casilla con los cuatro templos llevaría
                cinco líneas y taparía el evento de ese día.

                Ocultas en el teléfono: a 50 px de ancho dejan de ser un fondo
                discreto y se convierten en lo único que se ve. */}
          {semanales.slice(0, 3).map((r) => (
            <div
              class={`font-data hidden items-center gap-1 text-[0.62rem] leading-snug sm:flex ${
                r.estado === 'suspendida'
                  ? 'text-error/80 line-through'
                  : esEspecial(r)
                    ? 'font-semibold text-warning'
                    : 'text-base-content/45'
              }`}
              title={`${r.hora} · ${r.nombre}${r.aviso ? ' — ' + r.aviso : ''}`}
            >
              <span
                class="inline-block h-1 w-1 shrink-0 rounded-full"
                style={colorDe(r.templo) ? `background:${colorDe(r.templo)!.color.fondo}` : ''}
                aria-hidden="true"
              />
              {r.hora}
              {r.estado !== 'suspendida' && otroNombre(r) && (
                <span class="truncate">· {r.nombre}</span>
              )}
              {r.marca && <span class="truncate text-accent">· {r.marca}</span>}
            </div>
          ))}
          {/* En el teléfono las reuniones no se ven: un punto avisa de que
                ese día alguna cambia, y la agenda de abajo dice cuál. */}
          {semanales.some(esEspecial) && (
            <div
              class="mx-auto mt-0.5 h-1.5 w-1.5 rounded-full bg-warning sm:hidden"
              title="Ese día cambia alguna reunión"
            />
          )}
          {semanales.length > 3 && (
            <div class="font-data hidden text-[0.62rem] text-base-content/40 sm:block">
              +{semanales.length - 3} más
            </div>
          )}
        </div>
      );
    })}
  </div>

  <footer class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-base-300 bg-base-200/40 px-3 py-2 text-xs text-base-content/70">
    <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
      {templos.map((t) => (
        <span class="flex items-center gap-1.5">
          <span
            class="inline-block h-2.5 w-2.5 rounded-sm"
            style={estiloDistintivo(t) + `;background:${t.color.fondo}`}
            aria-hidden="true"
          />
          {t.short}
        </span>
      ))}
    </span>
    <span>
      <span class="hidden sm:inline">
        Las horas tenues son las reuniones de cada semana; en color, las que ese día cambian ·
      </span>
      <a href="/horarios" class="link link-primary">
        ver los horarios
      </a>
    </span>
  </footer>
</div>

{/* ── El mes, día por día ─────────────────────────────────────────────────
     Lo de la rejilla que se sale de lo normal, con todas sus letras. */}
<section class="mt-10" aria-labelledby="agenda-mes">
  <h3 id="agenda-mes" class="font-display text-xl md:text-2xl">
    Lo especial de {MESES[mes.mes - 1]}
  </h3>
  {agenda.length === 0 ? (
    <p class="mt-2 text-sm text-base-content/70">
      Este mes no hay eventos ni cambios: todas las reuniones van como siempre.
    </p>
  ) : (
    <ol class="mt-4 space-y-3">
      {agenda.map((d) => (
        <li class={`panel flex gap-4 p-4 ${d.fecha === hoy ? 'ring-1 ring-accent/50' : ''}`}>
          <div class="font-data w-12 shrink-0 text-center">
            <span class="block text-2xl font-bold leading-none">{Number(d.fecha.slice(8))}</span>
            <span class="mt-1 block text-[0.65rem] uppercase tracking-wider text-base-content/60">
              {fechaEnPalabras(d.fecha).slice(0, 3)}
            </span>
          </div>
          <ul class="min-w-0 flex-1 space-y-3">
            {d.eventos.map((e) => {
              const t = colorDe(e.templo);
              return (
                <li>
                  <a href={`/eventos?e=${encodeURIComponent(e.slug ?? e.id)}`} class="group block">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class="font-data text-sm font-bold">
                        {e.todo_el_dia ? 'Todo el día' : horaCorta(e.fecha)}
                      </span>
                      <span class="font-semibold group-hover:underline">{e.titulo}</span>
                      {t ? (
                        <span class="distintivo" style={estiloDistintivo(t)}>
                          {t.short}
                        </span>
                      ) : (
                        <span class="badge badge-ghost badge-sm">Toda la iglesia</span>
                      )}
                    </span>
                    {e.lugar && (
                      <span class="mt-0.5 block text-xs text-base-content/70">{e.lugar}</span>
                    )}
                  </a>
                </li>
              );
            })}
            {d.cambios.map((r) => {
              const t = colorDe(r.templo);
              const suspendida = r.estado === 'suspendida';
              return (
                <li class="text-sm">
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span
                      class={`font-data font-bold ${suspendida ? 'text-base-content/50 line-through' : ''}`}
                    >
                      {r.horaHabitual && (
                        <span class="mr-1 font-normal text-base-content/50 line-through">
                          {r.horaHabitual}
                        </span>
                      )}
                      {r.hora}
                    </span>
                    <span class={suspendida ? 'text-base-content/60' : 'font-medium'}>
                      {r.nombre}
                    </span>
                    {t && (
                      <span class="distintivo" style={estiloDistintivo(t)}>
                        {t.short}
                      </span>
                    )}
                    <span
                      class={`badge badge-sm ${suspendida ? 'badge-error badge-outline' : 'badge-warning'}`}
                    >
                      {suspendida ? 'Suspendida' : 'Cambia'}
                    </span>
                  </span>
                  {(r.aviso || otroNombre(r)) && (
                    <span class="mt-0.5 block text-xs text-base-content/70">
                      {r.aviso ?? `Ese día, en lugar de «${nombreHabitual(r.id)}».`}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ol>
  )}
</section>
