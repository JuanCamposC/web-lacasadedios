---
import { Icon } from 'astro-icon/components';
import { templos } from '../data/templos';
import { CONTACT } from '../data/site';

/**
 * Formulario de contacto con mejora progresiva:
 *  · sin JavaScript envía por POST a /contacto, que vuelve a dibujar la página
 *    con lo escrito y el resultado
 *  · con JavaScript envía por fetch y muestra el resultado sin recargar
 *
 * `valores` son los campos que vuelven tras un envío fallido. Antes el envío
 * sin JavaScript iba al endpoint y redirigía: el formulario volvía EN BLANCO y
 * el mensaje entero se perdía.
 */
interface Props {
  valores?: Record<string, string>;
  resultado?: 'ok' | 'error' | null;
  motivo?: string | null;
}
const { valores = {}, resultado = null, motivo = null } = Astro.props;
/*
 * Los motivos que ofrece el desplegable.
 *
 * «Petición de oración» estaba y salió a propósito: una petición de oración es
 * algo personal y delicado, y este formulario la convertía en un correo a la
 * dirección general de la iglesia. Quien quiera pedir oración tiene los correos
 * de cada pastor en esta misma página, y siempre le queda «Otro».
 *
 * Si algún día se ofrece otra vez, que sea con un destinatario propio y no con
 * el buzón que lee cualquiera del equipo.
 */
const asuntos = [
  'Quiero visitar la iglesia',
  'Consulta sobre horarios',
  'Enlace del estudio bíblico por Zoom',
  'Otro',
];

// `?enviado=` se conserva para los enlaces antiguos.
const porUrl = Astro.url.searchParams.get('enviado');
const enviado = resultado === 'ok' ? '1' : resultado === 'error' ? '0' : porUrl;

/**
 * El formulario llega preparado cuando se entra desde otra página.
 *
 * `/contacto?asunto=Enlace del estudio bíblico por Zoom&templo=Limache` deja
 * las dos casillas puestas. Lo usa el botón «Pedir el enlace» de
 * /estudio-biblico: quien entra desde ahí ya dijo lo que quiere, y volvérselo
 * a preguntar en dos desplegables es la clase de fricción que hace que la gente
 * cierre la pestaña.
 *
 * Se COMPARA contra las listas en vez de usar el valor de la dirección tal cual.
 * Es la diferencia entre preseleccionar una opción que existe y dejar que
 * cualquiera decida, desde un enlace, qué texto viaja en el asunto del correo
 * que le llega a la iglesia.
 */
const pedido = {
  asunto: Astro.url.searchParams.get('asunto'),
  templo: Astro.url.searchParams.get('templo'),
};
const asuntoElegido = valores.asunto || (asuntos.find((a) => a === pedido.asunto) ?? '');
const temploElegido = templos.find(
  (t) => t.short === (valores.templo || pedido.templo) || t.slug === pedido.templo,
);

/** Cada motivo de fallo con su salida, en vez de una sola frase para todo. */
const ERRORES: Record<string, string> = {
  demasiados_intentos:
    'Se han enviado varios mensajes seguidos desde tu conexión. Espera un rato o escríbenos a ' +
    CONTACT.email +
    '.',
  no_email_provider:
    'El envío por el sitio todavía no está habilitado. Escríbenos a ' +
    CONTACT.email +
    ' y te respondemos igual.',
  invalid: 'Revisa los campos obligatorios e inténtalo de nuevo.',
};
const textoError =
  (motivo && ERRORES[motivo]) ||
  'No pudimos enviar el mensaje. Escríbenos directamente a ' + CONTACT.email + '.';
---

{
  /* Sin `novalidate`: esa marca apagaba la validación del navegador, y quien no
    tiene JavaScript se quedaba sin ninguna. Con JavaScript la apaga el script,
    que valida y avisa por su cuenta. El destino es la propia página, que
    conserva lo escrito si el envío falla. */
}
<form id="contact-form" method="post" action="/contacto#contacto" class="panel p-6 sm:p-8">
  <h2 class="font-display text-2xl">Escríbenos</h2>
  <p class="mt-1 text-sm text-base-content/70">
    Cuéntanos en qué podemos ayudarte. Respondemos al correo que nos dejes.
  </p>

  <!-- Trampa para bots: invisible para las personas -->
  <div class="hidden" aria-hidden="true">
    <label>
      No completes este campo
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>
  <input type="hidden" name="_t" id="contact-ts" value="" />

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div class="form-control">
      <label class="label pb-1" for="cf-nombre">
        <span class="label-text font-medium">Nombre <span class="text-error">*</span></span>
      </label>
      <input
        id="cf-nombre"
        name="nombre"
        type="text"
        value={valores.nombre ?? ''}
        maxlength="100"
        required
        autocomplete="name"
        placeholder="Tu nombre"
        class="input input-bordered w-full"
      />
    </div>

    <div class="form-control">
      <label class="label pb-1" for="cf-email">
        <span class="label-text font-medium">Correo <span class="text-error">*</span></span>
      </label>
      <input
        id="cf-email"
        name="email"
        type="email"
        value={valores.email ?? ''}
        maxlength="254"
        required
        autocomplete="email"
        placeholder="tucorreo@ejemplo.cl"
        class="input input-bordered w-full"
      />
    </div>

    <div class="form-control">
      <label class="label pb-1" for="cf-telefono">
        <span class="label-text font-medium"
          >Teléfono <span class="text-base-content/50">(opcional)</span></span
        >
      </label>
      <input
        id="cf-telefono"
        name="telefono"
        type="tel"
        value={valores.telefono ?? ''}
        maxlength="40"
        autocomplete="tel"
        placeholder="+56 9 ..."
        class="input input-bordered w-full"
      />
    </div>

    <div class="form-control">
      <label class="label pb-1" for="cf-templo">
        <span class="label-text font-medium">Templo</span>
      </label>
      <select id="cf-templo" name="templo" class="select select-bordered w-full">
        <option value="" selected={!temploElegido}>Consulta general</option>
        {
          templos.map((t) => (
            <option value={t.short} selected={temploElegido?.slug === t.slug}>
              {t.short}
            </option>
          ))
        }
      </select>
    </div>

    <div class="form-control sm:col-span-2">
      <label class="label pb-1" for="cf-asunto">
        <span class="label-text font-medium">Asunto <span class="text-error">*</span></span>
      </label>
      <select id="cf-asunto" name="asunto" required class="select select-bordered w-full">
        <option value="" selected={!asuntoElegido}>Elige un motivo…</option>
        {
          asuntos.map((a) => (
            <option value={a} selected={a === asuntoElegido}>
              {a}
            </option>
          ))
        }
      </select>
    </div>

    <div class="form-control sm:col-span-2">
      <label class="label pb-1" for="cf-mensaje">
        <span class="label-text font-medium">Mensaje <span class="text-error">*</span></span>
      </label>
      <textarea
        id="cf-mensaje"
        name="mensaje"
        required
        rows="5"
        minlength="10"
        maxlength="4000"
        placeholder="Escribe tu mensaje…"
        class="textarea textarea-bordered w-full">{valores.mensaje ?? ''}</textarea
      >
    </div>
  </div>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <button type="submit" id="contact-submit" class="btn btn-primary gap-2">
      <Icon name="lucide:send" class="h-4 w-4" />
      <span data-label>Enviar mensaje</span>
    </button>
    <p class="text-xs text-base-content/60">
      Usamos tus datos solo para responderte. No los compartimos con nadie.
    </p>
  </div>

  <p
    id="contact-msg"
    role="status"
    aria-live="polite"
    class:list={[
      'mt-4 rounded-xl px-4 py-3 text-sm',
      enviado === '1' && 'bg-success/10 text-success',
      enviado === '0' && 'bg-error/10 text-error',
      !enviado && 'hidden',
    ]}
  >
    {enviado === '1' && '¡Gracias! Recibimos tu mensaje y te responderemos pronto.'}
    {enviado === '0' && textoError}
  </p>
</form>

<script>
  function initContacto() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const msg = document.getElementById('contact-msg');
    const btn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const ts = document.getElementById('contact-ts') as HTMLInputElement | null;

    if (ts) ts.value = String(Date.now());
    if (!form || !msg || !btn || form.dataset.listo) return;
    form.dataset.listo = '1';

    const label = btn.querySelector('[data-label]')!;
    const original = label.textContent ?? 'Enviar mensaje';

    const show = (text: string, kind: 'ok' | 'error' | 'warn') => {
      msg.textContent = text;
      msg.className =
        'mt-4 rounded-xl px-4 py-3 text-sm ' +
        (kind === 'ok'
          ? 'bg-success/10 text-success'
          : kind === 'warn'
            ? 'bg-warning/10 text-warning'
            : 'bg-error/10 text-error');
    };

    // La validación del navegador se apaga ACÁ y no en el HTML: así quien no
    // tiene JavaScript conserva la del navegador, que es la única que le queda.
    form.noValidate = true;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      btn.disabled = true;
      label.textContent = 'Enviando…';
      msg.className = 'mt-4 hidden';

      try {
        // La dirección va ESCRITA y no se toma de `form.action`.
        //
        // `action` apunta a /contacto, y tiene que seguir apuntando ahí: es la
        // página que atiende el envío de quien no tiene JavaScript y la única
        // que puede volver a dibujar el formulario con lo que la persona
        // escribió. Pero esa página devuelve HTML.
        //
        // Cuando este fetch usaba `form.action`, el envío funcionaba —el correo
        // salía— y la respuesta era una página entera. `res.json()` reventaba,
        // el catch dejaba un objeto vacío, y sin `ok` ni `reason` el mensaje
        // caía en el «No pudimos enviar el mensaje» de más abajo. O sea: se
        // enviaba y se decía que no. Quien lo intentara de nuevo mandaba otra
        // copia, y a la quinta el freno por IP lo dejaba fuera de verdad.
        //
        // /api/contacto hace exactamente lo mismo y responde JSON, que es lo
        // que este código sabe leer.
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));

        if (data.ok) {
          form.reset();
          if (ts) ts.value = String(Date.now());
          show('¡Gracias! Recibimos tu mensaje y te responderemos pronto.', 'ok');
        } else if (data.reason === 'no_email_provider') {
          show(
            'El envío por el sitio todavía no está habilitado. Escríbenos a ' +
              (data.email ?? 'contacto@lacasadedios.cl') +
              ' y te respondemos igual.',
            'warn',
          );
        } else if (data.reason === 'demasiados_intentos') {
          show(
            'Se han enviado varios mensajes seguidos desde tu conexión. Espera un rato o escríbenos a ' +
              (data.email ?? 'contacto@lacasadedios.cl') +
              '.',
            'warn',
          );
        } else if (data.reason === 'invalid') {
          show('Revisa los campos obligatorios e inténtalo de nuevo.', 'error');
        } else if (data.reason === 'from_invalido') {
          // Error de configuración, no del visitante: se le da una salida.
          show(
            'El envío está mal configurado. Escríbenos a ' +
              (data.email ?? 'contacto@lacasadedios.cl') +
              ' mientras lo arreglamos.',
            'warn',
          );
        } else {
          show('No pudimos enviar el mensaje. Inténtalo más tarde.', 'error');
        }
      } catch {
        show('No pudimos enviar el mensaje. Revisa tu conexión e inténtalo de nuevo.', 'error');
      } finally {
        btn.disabled = false;
        label.textContent = original;
      }
    });
  }

  document.addEventListener('astro:page-load', initContacto);
</script>
