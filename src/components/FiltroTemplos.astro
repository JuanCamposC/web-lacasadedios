---
import { templos } from '../data/templos';

/**
 * Barra de filtro por templo, compartida por noticias, eventos y videos.
 *
 * Los chips son los templos, sin «General»: al elegir una sede lo general
 * aparece igual (ver `coincide` en src/data/etiquetas.ts), así que un chip
 * propio para ello solo confundiría.
 *
 * Solo pinta la barra. El comportamiento vive en src/scripts/filtroTemplos.ts,
 * que cada página importa, para que este archivo siga siendo marca sin estado.
 */
interface Props {
  /** Qué se está filtrando, para el texto vacío: «noticias», «eventos»… */
  plural: string;
}
const { plural } = Astro.props;
---

<section class="sticky top-16 z-30 border-b border-base-300 bg-base-100/92 backdrop-blur-md">
  <div class="indice wrap overflow-x-auto px-4 py-3">
    <div
      class="flex w-max items-center gap-2 pe-8 md:w-full md:flex-wrap md:pe-0"
      role="group"
      aria-label="Filtrar por templo"
      data-filtro-templos
      data-plural={plural}
    >
      <span
        class="font-data hidden shrink-0 pr-1 text-xs uppercase tracking-[0.18em] text-base-content/45 sm:inline"
      >
        Filtrar
      </span>
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        class="filtro-chip shrink-0 rounded-full border border-primary bg-primary px-4 py-1.5 text-sm font-medium text-primary-content transition"
      >
        Todos
      </button>
      {
        templos.map((t) => (
          <button
            type="button"
            data-filter={t.slug}
            aria-pressed="false"
            class="filtro-chip shrink-0 rounded-full border border-base-300 bg-base-100 px-4 py-1.5 text-sm font-medium transition hover:border-primary hover:text-primary"
          >
            {t.short}
          </button>
        ))
      }
    </div>
  </div>
</section>

<p
  data-filtro-vacio
  class="wrap mt-8 hidden rounded-lg border border-dashed border-base-300 px-6 py-10 text-center text-base-content/60"
>
  No hay {plural} de ese templo por ahora.
</p>

<script>
  // El componente trae su propio comportamiento: Astro lo empaqueta una sola
  // vez y solo en las páginas que lo usan.
  import '../scripts/filtroTemplos';
</script>
