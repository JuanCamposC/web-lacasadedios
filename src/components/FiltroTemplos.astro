---
import BarraFiltro from './BarraFiltro.astro';

/**
 * Filtro por templo de noticias, eventos y videos: la barra y su comportamiento.
 *
 * La barra en sí vive en `BarraFiltro.astro`, que comparte con /horarios; acá
 * se le añade lo que solo necesita este caso: el aviso de «no hay nada de ese
 * templo» y el script que esconde las tarjetas.
 *
 * Los chips son los templos, sin «General»: al elegir una sede lo general
 * aparece igual (ver `coincide` en src/data/etiquetas.ts), así que un chip
 * propio para ello solo confundiría.
 */
interface Props {
  /** Qué se está filtrando, para el texto vacío: «noticias», «eventos»… */
  plural: string;
}
const { plural } = Astro.props;
---

<BarraFiltro plural={plural} />

<p
  data-filtro-vacio
  class="wrap mt-8 hidden rounded-lg border border-dashed border-base-300 px-6 py-10 text-center text-base-content/70"
>
  No hay {plural} de ese templo por ahora.
</p>

<script>
  // El componente trae su propio comportamiento: Astro lo empaqueta una sola
  // vez y solo en las páginas que lo usan.
  import '../scripts/filtroTemplos';
</script>
