---
import { Icon } from 'astro-icon/components';
import { CONTACT } from '../data/templos';
---
<footer class="bg-neutral text-neutral-content">
  <!-- Newsletter -->
  <div class="border-b border-white/10">
    <div class="container mx-auto max-w-3xl px-4 py-14 text-center">
      <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/20 text-accent">
        <Icon name="lucide:mail-plus" class="h-6 w-6" />
      </div>
      <h2 class="font-display text-2xl font-bold md:text-3xl">Recibe nuestras novedades</h2>
      <p class="mx-auto mt-2 max-w-lg opacity-70">Suscríbete y entérate de eventos, prédicas y noticias de La Casa de Dios.</p>
      <form id="newsletter-form" class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row">
        <input type="email" name="email" required placeholder="tucorreo@ejemplo.cl"
          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-2.5 text-white placeholder-white/40 outline-none focus:border-white/50" />
        <button type="submit" id="newsletter-btn" class="btn btn-primary gap-2">
          <Icon name="lucide:send" class="h-4 w-4" /> Suscribirme
        </button>
      </form>
      <p id="newsletter-msg" class="mt-3 hidden text-sm"></p>
    </div>
  </div>

  <div class="container mx-auto px-4 py-12">
    <!-- Grid principal responsivo -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      
      <!-- Logo y descripción -->
      <div class="flex flex-col items-center md:items-start">
        <img src="/logo.png" alt="La Casa de Dios" class="footer-logo h-10 w-auto mb-4" width="605" height="204" />
        <p class="text-sm opacity-70 text-center md:text-left max-w-xs mb-4">
          Comunidad de fe cristiana con templos en Santiago, San Miguel, Limache y Coya.
        </p>
        <div class="flex flex-col gap-1.5 text-sm opacity-80 items-center md:items-start">
          <a href={`mailto:${CONTACT.email}`} class="inline-flex items-center gap-2 link link-hover hover:opacity-100 transition-opacity">
            <Icon name="lucide:mail" class="h-4 w-4 text-accent" /> {CONTACT.email}
          </a>
          <a href={`tel:${CONTACT.phoneHref}`} class="inline-flex items-center gap-2 link link-hover hover:opacity-100 transition-opacity">
            <Icon name="lucide:phone" class="h-4 w-4 text-accent" /> {CONTACT.phone}
          </a>
        </div>
      </div>

      <!-- Enlaces de navegación -->
      <div class="text-center md:text-left">
        <h3 class="font-bold text-lg mb-4">Navegación</h3>
        <nav class="flex flex-col gap-2">
          <a href="/" class="link link-hover opacity-80 hover:opacity-100 transition-opacity">Inicio</a>
          <a href="/sobre-nosotros" class="link link-hover opacity-80 hover:opacity-100 transition-opacity">Nosotros</a>
          <a href="/#templos" class="link link-hover opacity-80 hover:opacity-100 transition-opacity">Templos</a>
          <a href="/eventos" class="link link-hover opacity-80 hover:opacity-100 transition-opacity">Eventos</a>
          <a href="/noticias" class="link link-hover opacity-80 hover:opacity-100 transition-opacity">Noticias</a>
          <a href="/videos" class="link link-hover opacity-80 hover:opacity-100 transition-opacity">Videos</a>
        </nav>
      </div>

      <!-- Templos -->
      <div class="text-center md:text-left">
        <h3 class="font-bold text-lg mb-4">Templos</h3>
        <nav class="flex flex-col gap-2 text-sm opacity-80">
          <a href="/templos/santiago-centro" class="link link-hover hover:opacity-100 transition-opacity">Santiago Centro</a>
          <a href="/templos/san-miguel" class="link link-hover hover:opacity-100 transition-opacity">San Miguel</a>
          <a href="/templos/limache" class="link link-hover hover:opacity-100 transition-opacity">Limache</a>
          <a href="/templos/coya" class="link link-hover hover:opacity-100 transition-opacity">Coya</a>
        </nav>
      </div>

      <!-- Redes sociales -->
      <div class="text-center md:text-left">
        <h3 class="font-bold text-lg mb-4">Síguenos</h3>
        <div class="flex gap-4 justify-center md:justify-start">
          <a href="https://instagram.com/jovenescasadedios._" target="_blank" rel="noopener noreferrer" 
             class="transition-all duration-300 hover:scale-110 hover:text-pink-400" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@casadediosconociendolapalabrad" target="_blank" rel="noopener noreferrer" 
             class="transition-all duration-300 hover:scale-110 hover:text-red-500" aria-label="YouTube">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="divider my-4"></div>

    <!-- Copyright y versículo -->
    <div class="text-center space-y-2">
      <p class="text-xs opacity-50 max-w-2xl mx-auto italic">
        "Porque donde están dos o tres congregados en mi nombre, allí estoy yo en medio de ellos." — Mateo 18:20
      </p>
      <p class="text-sm opacity-70 flex items-center justify-center gap-3 flex-wrap">
        <span>© {new Date().getFullYear()} La Casa de Dios.</span>
        <a href="/admin" class="inline-flex items-center gap-1 opacity-60 hover:opacity-100 hover:text-accent transition">
          <Icon name="lucide:lock" class="h-3.5 w-3.5" /> Ingresar
        </a>
      </p>
    </div>
  </div>
</footer>

<script>
  import { createBrowserSupabase } from '../lib/supabase';
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const msg = document.getElementById('newsletter-msg');
  const btn = document.getElementById('newsletter-btn') as HTMLButtonElement | null;
  if (form && msg && btn) {
    const supabase = createBrowserSupabase();
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'mt-3 hidden text-sm';
      btn.disabled = true;
      const email = String(new FormData(form).get('email') || '').trim();
      const { error } = await supabase.from('subscribers').insert({ email });
      btn.disabled = false;
      if (error) {
        const dup = (error as any).code === '23505' || /duplicate|unique/i.test(error.message);
        msg.textContent = dup ? 'Ya estás suscrito. ¡Gracias!' : 'No se pudo suscribir. Intenta más tarde.';
        msg.className = `mt-3 text-sm ${dup ? 'text-white/80' : 'text-red-300'}`;
        return;
      }
      form.reset();
      msg.textContent = '¡Listo! Te has suscrito correctamente.';
      msg.className = 'mt-3 text-sm text-green-300';
    });
  }
</script>
