---
import { Icon } from 'astro-icon/components';
import { FOOTER_NAV } from '../data/nav';
import { SITE, CONTACT, SOCIAL } from '../data/site';

const year = new Date().getFullYear();

/**
 * Pie de página, según el diseño de Figma (archivo «Header», nodos 23:50 web y
 * 44:56 móvil). Los dos marcos traen los mismos siete elementos en el mismo
 * orden —logotipo, bajada, filete, cinco enlaces, tres círculos, versículo y
 * copyright—, así que aquí hay una sola maqueta centrada que se estrecha, no
 * dos.
 *
 * CUATRO ADAPTACIONES, todas conversadas:
 *
 * · Color. El diseño pinta el pie de #2F4156; aquí es `bg-neutral` (#0A1730),
 *   el azul noche de la paleta, el mismo que ahora lleva el velo de la
 *   portada. El diseño quiere que cabecera y pie sean el mismo azul, y lo
 *   siguen siendo.
 *
 * · Filete. En el diseño es una línea blanca de 2 px al 81 % del lienzo. Aquí
 *   es `.rule`, el filete de bronce que ya usa el resto del sitio, al ancho de
 *   `.wrap`: mismo papel, lengua del sitio.
 *
 * · Círculos. En el diseño son más oscuros que el fondo (#233040 al 90 % sobre
 *   #2F4156). Sobre el azul noche eso quedaría casi negro, así que se invierte
 *   la relación con `bg-white/10`, que es lo que el sitio ya usaba. Miden 44 px
 *   como mínimo porque por debajo de eso dejan de ser tocables con el pulgar.
 *
 * · «COMUNIDAD» del diseño no existe como página; queda «Horarios», que es lo
 *   que más se busca. El mapa completo de tres columnas desaparece: la barra de
 *   arriba ya lleva a todo.
 *
 * El boletín se fue a `Boletin.astro`, la banda de encima.
 */

/** Los tres círculos del diseño: las dos redes y el correo. */
const CIRCULOS = [
  ...SOCIAL.map((s) => ({ href: s.href, label: s.label, icon: s.icon, externo: true })),
  {
    href: `mailto:${CONTACT.email}`,
    label: `Escríbenos a ${CONTACT.email}`,
    icon: 'lucide:mail',
    externo: false,
  },
];
---

<footer class="on-dark bg-neutral text-neutral-content">
  <div class="wrap px-4 py-12 text-center sm:py-16">
    <a href="/" class="inline-block" aria-label={`${SITE.name} — inicio`}>
      <img
        src="/marca/logo-blanco.svg"
        alt={SITE.name}
        width="819"
        height="185"
        loading="lazy"
        class="h-8 w-auto sm:h-11 lg:h-14"
      />
    </a>

    <p class="mx-auto mt-6 max-w-2xl text-sm opacity-80 sm:text-base">{SITE.intro}</p>

    <div class="rule mt-8 sm:mt-10" aria-hidden="true"></div>

    <nav class="mt-8 sm:mt-10" aria-label="Enlaces del sitio">
      <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 sm:gap-x-14">
        {
          FOOTER_NAV.map((l) => (
            <li>
              <a
                href={l.href}
                class="font-data text-sm font-bold uppercase tracking-[0.14em] transition hover:text-accent sm:text-base"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="mt-8 flex items-center justify-center gap-6 sm:mt-10 sm:gap-8">
      {
        CIRCULOS.map((c) => (
          <li>
            <a
              href={c.href}
              aria-label={c.label}
              target={c.externo ? '_blank' : undefined}
              rel={c.externo ? 'noopener noreferrer' : undefined}
              class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20 hover:text-accent sm:h-12 sm:w-12"
            >
              <Icon name={c.icon} class="h-5 w-5 sm:h-6 sm:w-6" />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mx-auto mt-8 max-w-3xl text-xs italic opacity-60 sm:mt-10 sm:text-sm">
      «{SITE.verse.text}» — {SITE.verse.ref}
    </p>

    <p class="mt-6 text-sm opacity-70 sm:mt-8">© {year} {SITE.name}</p>
  </div>
</footer>
