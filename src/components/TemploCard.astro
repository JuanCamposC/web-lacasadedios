---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { parseService, type Templo } from '../data/templos';
import { IMG } from '../assets/images';

interface Props {
  templo: Templo;
  /** `compact` para la portada, `detailed` para el listado de templos. */
  variant?: 'compact' | 'detailed';
}
const { templo: t, variant = 'compact' } = Astro.props;

// En la variante detallada se muestra el próximo tipo de reunión de cada día.
const dias = t.schedule.map((s) => ({
  day: s.day,
  first: parseService(s.services[0]).time,
  count: s.services.length,
}));
const reuniones = t.schedule.reduce((n, s) => n + s.services.length, 0);
---

{variant === 'compact' ? (
  <a
    href={`/templos/${t.slug}`}
    class="panel panel-sm panel-lift group block h-full overflow-hidden"
  >
    <div class="relative h-44 overflow-hidden">
      <Image
        src={IMG[t.image]}
        alt={t.name}
        widths={[400, 700]}
        sizes="(max-width:640px) 100vw, 25vw"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
      {t.matriz && (
        <span class="absolute left-3 top-3 rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-accent-content">
          Iglesia Matriz
        </span>
      )}
      <h3 class="absolute bottom-3 left-4 right-4 font-display text-2xl text-white">{t.short}</h3>
    </div>
    <div class="flex items-center justify-between p-5">
      <span class="flex items-center gap-1.5 text-sm text-base-content/70">
        <Icon name="lucide:map-pin" class="h-4 w-4 shrink-0 text-accent" />
        {t.region}
      </span>
      <Icon name="lucide:arrow-right" class="h-5 w-5 shrink-0 text-primary transition-transform group-hover:translate-x-1" />
    </div>
  </a>
) : (
  <article class="panel panel-lift group flex h-full flex-col overflow-hidden">
    <a href={`/templos/${t.slug}`} class="relative block h-52 overflow-hidden">
      <Image
        src={IMG[t.image]}
        alt={t.name}
        widths={[500, 900]}
        sizes="(max-width:768px) 100vw, 50vw"
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
      {t.matriz && (
        <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-accent-content">
          <Icon name="lucide:star" class="h-3.5 w-3.5" /> Iglesia Matriz
        </span>
      )}
      <div class="absolute inset-x-4 bottom-4">
        <h3 class="font-display text-2xl text-white">{t.short}</h3>
        <p class="mt-0.5 text-sm text-white/75">{t.tagline}</p>
      </div>
    </a>

    <div class="flex flex-1 flex-col gap-4 p-6">
      <ul class="space-y-1.5 text-sm text-base-content/75">
        <li class="flex items-start gap-2">
          <Icon name="lucide:navigation" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
          <span>{t.address}</span>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="lucide:map" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
          <span>{t.region}</span>
        </li>
        <li class="flex items-start gap-2">
          <Icon name="lucide:user-round" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />
          <span>{t.leader.name}</span>
        </li>
      </ul>

      <div class="rounded-xl bg-base-200/60 p-4">
        <div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-base-content/60">
          <Icon name="lucide:clock" class="h-3.5 w-3.5" />
          {reuniones} {reuniones === 1 ? 'reunión' : 'reuniones'} por semana
        </div>
        <div class="flex flex-wrap gap-1.5">
          {dias.map((d) => (
            <span class="inline-flex items-center gap-1 rounded-lg border border-base-300 bg-base-100 px-2 py-1 text-xs">
              <span class="font-semibold">{d.day.slice(0, 3)}</span>
              <span class="tabular-nums text-base-content/60">
                {d.first}{d.count > 1 && ` +${d.count - 1}`}
              </span>
            </span>
          ))}
        </div>
      </div>

      <div class="mt-auto flex flex-wrap gap-2 pt-1">
        <a href={`/templos/${t.slug}`} class="btn btn-primary btn-sm gap-1.5">
          Ver el templo <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
        <a
          href={t.mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-sm gap-1.5"
        >
          <Icon name="lucide:navigation" class="h-4 w-4" /> Cómo llegar
        </a>
      </div>
    </div>
  </article>
)}
