---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  tone?: 'primary' | 'accent' | 'secondary';
  invert?: boolean; // texto claro sobre fondo oscuro
}
const { eyebrow, title, subtitle, align = 'center', tone = 'accent', invert = false } = Astro.props;

// Clases literales: Tailwind rastrea el código fuente, así que `text-${tone}`
// no generaría nada. El mapa mantiene los nombres completos a la vista.
const TONE: Record<string, string> = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  accent: 'text-accent',
};

const alignCls = align === 'center' ? 'text-center mx-auto' : 'text-left';
const toneCls = invert ? 'text-accent' : (TONE[tone] ?? TONE.accent);
---

<div data-reveal class={`max-w-2xl ${alignCls}`}>
  {eyebrow && <span class={`eyebrow mb-3 ${toneCls}`}>{eyebrow}</span>}
  <h2
    class={`font-display leading-[1.05] text-[clamp(1.85rem,5vw,3.25rem)] ${invert ? 'text-white' : 'text-base-content'}`}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class={`mt-4 text-lg ${invert ? 'text-white/70' : 'text-base-content/70'}`}>{subtitle}</p>
    )
  }
  <slot />
</div>
