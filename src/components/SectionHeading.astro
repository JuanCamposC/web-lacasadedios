---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  tone?: 'primary' | 'accent' | 'secondary';
  invert?: boolean; // texto claro sobre fondo oscuro
}
const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  tone = 'accent',
  invert = false,
} = Astro.props;
const alignCls = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div data-reveal class={`max-w-2xl ${alignCls}`}>
  {eyebrow && (
    <span class={`inline-block text-xs font-semibold uppercase tracking-[0.25em] mb-3 text-${tone}`}>
      {eyebrow}
    </span>
  )}
  <h2 class={`font-display font-bold leading-[1.05] text-[clamp(2rem,5vw,3.25rem)] ${invert ? 'text-white' : 'text-base-content'}`}>
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-4 text-lg ${invert ? 'text-white/70' : 'text-base-content/70'}`}>
      {subtitle}
    </p>
  )}
</div>
