// El Worker que manda los alias al dominio de verdad. Todo el porqué está en
// worker.js; acá solo la configuración.
//
// Se sigue llamando `lacasadedios-www` porque nació para `www` y renombrarlo
// obligaría a borrarlo y recrearlo, con los dominios cambiando de dueño otra
// vez. El nombre es historia, no descripción: atiende todos los alias.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lacasadedios-www",
  "main": "worker.js",
  "compatibility_date": "2026-09-25",

  // Sin dirección *.workers.dev: no hay nada que mirar en este Worker que no
  // sea su cabecera `Location`, y para eso está `wrangler dev`.
  "workers_dev": false,

  // `custom_domain` hace que Cloudflare cree y mantenga el registro DNS de
  // `www`. Este hostname LO TENÍA el Worker del sitio; se le quitó de sus
  // `routes` el 25 de septiembre de 2026 para dárselo a este.
  //
  // El orden importa si alguna vez hay que repetirlo: primero se despliega el
  // sitio SIN `www` —eso libera el hostname y borra su registro DNS— y después
  // este. Al revés, Cloudflare rechaza el despliegue porque el dominio ya tiene
  // dueño. Entre los dos pasos, `www` no resuelve; son segundos, y lo único que
  // deja de funcionar es una redirección.
  //
  // `pruebas` se sumó el 26 de septiembre de 2026. Se había dado de baja el día
  // anterior y el nombre quedó sin resolver, pero seguía guardado en marcadores y
  // en el historial de quien administra: al ir al panel, el navegador llevaba a
  // una dirección muerta. Devolverlo como redirección cuesta cero y arregla eso
  // venga de donde venga, hoy y dentro de un año.
  //
  // NO significa que el sitio de pruebas vuelva: acá no hay base, ni bucket, ni
  // páginas. Solo un 301 al sitio de verdad conservando la ruta, así que
  // pruebas.lacasadedios.cl/admin termina en el panel bueno.
  "routes": [
    { "pattern": "www.lacasadedios.cl", "custom_domain": true },
    { "pattern": "pruebas.lacasadedios.cl", "custom_domain": true },
  ],

  "observability": { "enabled": true },
}
